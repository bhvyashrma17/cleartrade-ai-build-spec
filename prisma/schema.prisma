enum UserRole {
  exporter_owner
  exporter_member
  agent
  ops_supervisor
  ops_finance
  admin
}

/// Commercial tier of a tenant. Deliberately NOT a UserRole: role answers "may this kind
/// of user do this?", tier answers "has this tenant paid for it?". Both must pass, and
/// keeping them on separate axes is what lets tenantScope() and the whole role matrix in
/// src/lib/permissions.ts stay unchanged. A guest is a real org with a real User row, so
/// there is no unauthenticated code path anywhere in the product.
enum OrgTier {
  guest
  free
  paid
}

/// Which membership a tenant is on. The plan CODE is the commercial product; `OrgTier`
/// remains the enforcement axis (`CAPABILITY_MIN_TIER` reads tier, never a plan code), so
/// adding a plan never touches a permission check. See `src/lib/billing/plans.ts`.
enum SubscriptionPlanCode {
  premium_monthly
  premium_annual
}

/// Verbatim Razorpay subscription states, plus `none` for a tenant that never started one.
///
/// Taken from the provider rather than invented so a webhook payload can be mapped without
/// a lossy translation table — a status we cannot represent is a status we would silently
/// drop, and dropping `halted` is how a tenant keeps paid access after their card fails.
enum SubscriptionStatus {
  none
  created
  authenticated
  active
  pending
  /// Billing suspended by the merchant or the customer. Distinct from `halted`, which is
  /// a payment FAILURE — conflating the two would tell a member their card was declined
  /// when in fact someone deliberately paused their plan.
  paused
  halted
  cancelled
  completed
  expired
}

enum SubscriptionProvider {
  razorpay
  /// Ops-granted membership with no gateway behind it (pilot accounts, comped partners).
  manual
}

