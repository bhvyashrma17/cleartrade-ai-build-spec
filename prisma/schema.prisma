// ClearTrade AI — canonical domain model.
//
// Field names and enum values are taken verbatim from docs/02-domain-model.md and
// docs/07-workflow-state-machines.md. They are deliberately snake_case so the database
// column, the Prisma client field and the JSON API payload all read identically —
// there is no silent renaming layer between the spec and the wire.
//
// Rules encoded here (see AGENTS.md):
//   - Document keeps FOUR independent status dimensions. Never collapse them.
//   - Money is always amount + currency. There are no bare numeric money columns.
//   - Historical records are snapshots (DealSnapshot, FeePolicy version, quoted terms).
//   - AuditEvent is append-only; the application layer exposes no update path.
//   - Internal notes are a separate table from exporter-visible messages, not a flag.

generator client {
  provider      = "prisma-client-js"
  /// `native` keeps local development working on any developer machine.
  ///
  /// `debian-openssl-3.0.x` is pinned for the container base image (node:22-bookworm-slim,
  /// Debian 12 / OpenSSL 3.x). Without it the engine is chosen by runtime detection, which is
  /// exactly what emits the "failed to detect the libssl/openssl version" warning — and a
  /// wrong guess surfaces as a query-engine load failure at boot rather than at build time.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  /// Pooled connection for the application (Neon PgBouncer endpoint, `-pooler` host).
  url       = env("DATABASE_URL")
  /// Direct, unpooled connection used by Migrate and introspection.
  ///
  /// Neon's pooled endpoint runs PgBouncer in transaction mode, which cannot execute the
  /// session-level statements (advisory locks, some DDL) that `prisma migrate deploy` relies
  /// on. Without this split, migrations against Neon either hang on the migration advisory
  /// lock or fail outright — so the migrator MUST get the direct host.
  ///
  /// Locally the two point at the same server; `.env.example` sets both.
  directUrl = env("DIRECT_DATABASE_URL")
}

