// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model ExporterOrg {
  id                       String          @id @default(cuid())
  legal_name               String?
  display_name             String
  gstin                    String?
  /// Status-aware field, not a bare string (docs/02 + glossary).
  iec                      IecStatus       @default(unknown)
  iec_number               String?
  country                  String          @default("IN")
  state                    String?
  city                     String?
  pickup_location_code     String?
  preferred_origin_gateway String?
  assigned_agent_id        String?
  readiness_status         ReadinessStatus @default(not_started)
  journey_stage            JourneyStage    @default(onboarding)

  /// Defaults to `guest` because the overwhelmingly common new row is a guest minted on
  /// first search. Pre-existing rows are backfilled to `paid` by the migration — they
  /// were created under the old all-access assumption.
  tier             OrgTier   @default(guest)
  /// Set when guest -> free (registration). Funnel analysis; null while still a guest.
  upgraded_at      DateTime?
  /// Only ever set while tier = guest. Drives the purge job for abandoned guest orgs;
  /// without it this table grows monotonically with anonymous traffic.
  guest_expires_at DateTime?

  /// The commitment fee (docs/01 §2) is what a free-tier org must pay to unlock `paid`
  /// tier — full Demand Discovery, buyer contacts' agent workflow, and everything else
  /// gated at `paid` in CAPABILITY_MIN_TIER. This is not a new membership concept: it is
  /// the SAME commitment fee docs/01 always specified, now doing double duty as the
  /// tier-3 gate rather than sitting unused. `not_due` while tier=guest; set to `due` the
  /// moment registration completes (tier flips to `free`) — never left implicit, since
  /// `due` vs `not_due` is what the billing CTA renders on.
  commitment_fee_status         CommitmentFeeStatus @default(not_due)
  /// Snapshot of the active FeePolicy's commitment fee amount/currency/version AT THE
  /// MOMENT it became due — never re-read live. Same "rule of record" docs/01 applies to
  /// deal-quoted terms: a later FeePolicy version must never retroactively change what an
  /// org already owes or already paid.
  commitment_fee_amount         Decimal?            @db.Decimal(18, 4)
  commitment_fee_currency       String?             @db.VarChar(3)
  commitment_fee_policy_version Int?
  /// Provenance of the "paid" transition — same PaymentSource vocabulary as Payment.source,
  /// since this is the identical kind of fact (self-reported vs bank-confirmed) applied to
  /// a different money event. Reusing the enum means one place ever defines what "source"
  /// can mean, rather than two enums drifting apart.
  commitment_fee_source         PaymentSource?
  commitment_fee_due_at         DateTime?
  commitment_fee_paid_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assigned_agent        User?                 @relation("OrgAssignedAgent", fields: [assigned_agent_id], references: [id])
  users                 User[]                @relation("OrgMembers")
  products              Product[]
  readiness_assessments ReadinessAssessment[]
  discovery_runs        DiscoveryRun[]
  buyer_leads           BuyerLead[]
  buyer_fit_assessments BuyerFitAssessment[]
  buyer_outcomes        BuyerOutcome[]
  buyer_shortlists      BuyerShortlist[]
  deals                 Deal[]
  tasks                 Task[]
  assignments           AgentAssignment[]
  invitations           Invitation[]
  agent_decisions       AgentDecision[]

  @@index([assigned_agent_id])
  @@index([readiness_status])
  @@index([tier])
  @@index([tier, guest_expires_at])
}

model User {
  id              String   @id @default(cuid())
  /// Guests get a synthetic address on the RFC 2606 reserved `.invalid` TLD, which can
  /// never resolve or collide with a real one. Keeps this column non-null and UNIQUE so
  /// nothing downstream has to handle a null identity.
  email           String   @unique
  phone           String?
  name            String
  /// Null means "this account cannot log in" — the state a guest is in until it upgrades.
  /// authorize() MUST reject a null hash before reaching bcrypt.compare, which throws on
  /// null rather than returning false.
  password_hash   String?
  role            UserRole
  /// Null for agent / ops / admin principals. Non-null pins an exporter to one tenant.
  exporter_org_id String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  exporter_org                ExporterOrg?              @relation("OrgMembers", fields: [exporter_org_id], references: [id])
  agent_for_orgs              ExporterOrg[]             @relation("OrgAssignedAgent")
  agent_assignments           AgentAssignment[]         @relation("AssignmentAgent")
  assignments_made            AgentAssignment[]         @relation("AssignmentActor")
  owned_leads                 BuyerLead[]               @relation("LeadAgent")
  created_leads               BuyerLead[]               @relation("LeadCreatedBy")
  owned_deals                 Deal[]                    @relation("DealOwnerAgent")
  owned_tasks                 Task[]                    @relation("TaskOwner")
  proposals_made              DealProposal[]            @relation("ProposalProposedBy")
  proposals_approved          DealProposal[]            @relation("ProposalApprovedBy")
  proposals_changes_requested DealProposal[]            @relation("ProposalChangesRequestedBy")
  outreach_activities         OutreachActivity[]
  outreach_attempts           OutreachAttempt[]
  buyer_lead_transitions      BuyerLeadTransition[]
  raw_data_access_events      RawDataAccessEvent[]
  data_deletion_reviews       DataDeletionRequest[]
  audit_events                AuditEvent[]
  notifications               Notification[]
  notification_preferences    NotificationPreference[]
  messages_sent               Message[]
  internal_notes              InternalNote[]
  documents_approved          Document[]                @relation("DocumentApprover")
  documents_reviewed          Document[]                @relation("DocumentReviewer")
  documents_filed             Document[]                @relation("DocumentFiler")
  partner_handoffs            PartnerHandoff[]          @relation("PartnerHandoffOwner")
  disputes_owned              Dispute[]
  jobs_requested              Job[]
  invitations_sent            Invitation[]              @relation("InvitationInviter")
  task_evidence_uploaded      TaskEvidence[]            @relation("TaskEvidenceUploader")
  task_evidence_reviewed      TaskEvidence[]            @relation("TaskEvidenceReviewer")
  payouts                     Payout[]                  @relation("PayoutAgent")
  payouts_approved            Payout[]                  @relation("PayoutApprovedBy")
  payout_adjustments_made     PayoutAdjustment[]        @relation("PayoutAdjustmentAuthor")
  sanctions_review_decisions  SanctionsReviewDecision[]
  classifications_proposed    ProductClassification[]   @relation("ClassificationProposer")
  classifications_confirmed   ProductClassification[]   @relation("ClassificationConfirmer")
  products_hs_confirmed       Product[]
  auth_provider_accounts      AuthProviderAccount[]
  agent_decisions             AgentDecision[]           @relation("AgentDecisionActor")

  @@index([exporter_org_id])
  @@index([role])
}

/// External identity linkage for social authentication.
///
/// ClearTrade never links by email alone. A social sign-in only maps to a local user through
/// this durable provider-account binding (`provider` + `provider_account_id`).
model AuthProviderAccount {
  id                  String   @id @default(cuid())
  user_id             String
  provider            String   @db.VarChar(40)
  provider_account_id String   @db.VarChar(191)
  provider_email      String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@index([user_id])
}

/// Assignment history is retained — reassignment ends the current row, never edits it.
model AgentAssignment {
  id              String           @id @default(cuid())
  exporter_org_id String
  agent_user_id   String
  assigned_by_id  String?
  status          AssignmentStatus @default(active)
  started_at      DateTime         @default(now())
  ended_at        DateTime?
  reason          String?

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  agent        User        @relation("AssignmentAgent", fields: [agent_user_id], references: [id])
  assigned_by  User?       @relation("AssignmentActor", fields: [assigned_by_id], references: [id])

  @@index([exporter_org_id, status])
  @@index([agent_user_id, status])
}

// ---------------------------------------------------------------------------
// Exporter master data
// ---------------------------------------------------------------------------

model Product {
  id                           String                       @id @default(cuid())
  exporter_org_id              String
  name                         String
  description                  String?
  hs_code                      String?
  /// Provenance of the HS code: ai_suggested | user_confirmed | unknown.
  hs_code_source               String                       @default("unknown")
  itc_hs_code                  String?
  hs_nomenclature              String?
  hs_nomenclature_version      String?
  hs_classification_method     ProductClassificationMethod?
  hs_classification_status     ProductClassificationStatus?
  hs_classification_confidence Decimal?                     @db.Decimal(5, 4)
  hs_classification_evidence   Json?
  hs_confirmed_by_id           String?
  hs_confirmed_at              DateTime?
  hs_classification_revision   Int                          @default(0)
  evidence_origin              EvidenceOrigin               @default(unknown_legacy)

  // capacity = number + unit; never a bare number
  capacity_value Decimal? @db.Decimal(18, 4)
  capacity_unit  String?

  // moq = number + unit
  moq_value Decimal? @db.Decimal(18, 4)
  moq_unit  String?

  // price_target is a per-quantity price. A currency without its quantity and
  // delivery basis is not comparable to customs unit values, so all four fields
  // are nullable but must be present before Export Economics can use the price.
  price_target_amount        Decimal? @db.Decimal(18, 4)
  price_target_currency      String?  @db.VarChar(3)
  price_target_quantity_unit String?
  price_target_incoterm      String?  @db.VarChar(3)

  /// Exporter-market-fit inputs. All nullable: absence lowers score confidence; it is
  /// never replaced by a guessed/default commercial capability.
  lead_time_days                  Int?
  /// Exporter's end-to-end customer delivery commitment. Kept separate from
  /// production lead_time_days so the scorer can derive a transit allowance.
  delivery_commitment_days        Int?
  logistics_constraint_codes      String[] @default([])
  logistics_constraints_confirmed Boolean  @default(false)
  desired_order_size_amount       Decimal? @db.Decimal(18, 4)
  desired_order_size_currency     String?  @db.VarChar(3)
  customization_capability        String?
  packaging_capability            String?

  packaging  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org           ExporterOrg             @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  certifications         ProductCertification[]
  market_assessments     MarketAssessment[]
  buyer_leads            BuyerLead[]
  buyer_fit_assessments  BuyerFitAssessment[]
  deals                  Deal[]
  classification_history ProductClassification[]
  hs_confirmed_by        User?                   @relation(fields: [hs_confirmed_by_id], references: [id], onDelete: SetNull)

  @@index([exporter_org_id])
  @@index([hs_code])
}

model ProductClassification {
  id                   String                      @id @default(cuid())
  product_id           String
  revision             Int
  itc_hs_code          String?
  hs6_code             String
  nomenclature         String
  nomenclature_version String
  method               ProductClassificationMethod
  evidence             Json
  confidence           Decimal                     @db.Decimal(5, 4)
  status               ProductClassificationStatus
  proposed_by_id       String
  proposed_at          DateTime                    @default(now())
  confirmed_by_id      String?
  confirmed_at         DateTime?
  superseded_at        DateTime?
  product              Product                     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  proposed_by          User                        @relation("ClassificationProposer", fields: [proposed_by_id], references: [id], onDelete: Restrict)
  confirmed_by         User?                       @relation("ClassificationConfirmer", fields: [confirmed_by_id], references: [id], onDelete: SetNull)

  @@unique([product_id, revision])
  @@index([product_id, status])
}

model ProductCertification {
  id           String              @id @default(cuid())
  product_id   String
  code         String
  name         String
  status       CertificationStatus @default(not_started)
  evidence_ref String?
  valid_until  DateTime?
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, code])
}

/// Fields derived from EXP-02/EXP-03 (the PRD gives no field dictionary — see docs/02 note).
model ReadinessAssessment {
  id              String          @id @default(cuid())
  exporter_org_id String
  score           Int?
  status          ReadinessStatus @default(in_progress)
  /// Section-keyed questionnaire answers.
  answers         Json            @default("{}")
  /// [{ code, severity, summary, remediation_task_id }]
  blockers        Json            @default("[]")
  /// [{ code, title, rationale }]
  recommendations Json            @default("[]")
  is_current      Boolean         @default(true)
  submitted_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)

  @@index([exporter_org_id, is_current])
}

// ---------------------------------------------------------------------------
// Demand discovery
// ---------------------------------------------------------------------------

/// The UI contract is a DiscoveryRun resource plus ranked MarketAssessment records —
/// no AI provider or algorithm is bound into the schema (docs/02 implementation note).
model DiscoveryRun {
  id              String    @id @default(cuid())
  exporter_org_id String
  /// Null for a guest run: guests supply product context ad hoc and no Product row is
  /// created for them (that only happens if they choose to save it at registration).
  product_id      String?
  job_id          String?
  requested_by_id String?
  status          JobStatus @default(queued)
  filters         Json      @default("{}")

  /// Immutable snapshot of the inputs this run was executed with (docs/04 EXP-04-AC01).
  /// For a guest this is the whole product context — description + HS code — and is the
  /// only record of what was searched, since there is no Product to point at. It is also
  /// what the registration flow offers to turn into a real Product.
  input_snapshot Json?

  /// Frozen scoring clock and policy. Rows predating this repair remain explicitly
  /// legacy/non-recomputable rather than being assigned today's policy retroactively.
  as_of_date              DateTime?
  scoring_policy_version  Int?
  scoring_policy_hash     String?
  scoring_policy_snapshot Json?
  reproducibility_status  String    @default("legacy_non_recomputable")

  started_at   DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())

  exporter_org       ExporterOrg        @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  market_assessments MarketAssessment[]

  @@index([exporter_org_id, created_at])
}

model MarketAssessment {
  id           String  @id @default(cuid())
  run_id       String
  /// Null when the parent run was ad hoc (guest tier). The product context for those
  /// lives in DiscoveryRun.input_snapshot instead of in a Product row.
  product_id   String?
  country_code String  @db.VarChar(2)

  overall_score                      Int?
  demand_score                       Int?
  growth_score                       Int?
  competition_score                  Int?
  market_access_score                Int?
  export_economics_score             Int?
  exporter_market_fit_score          Int?
  logistics_feasibility_score        Int?
  risk_resilience_score              Int?
  confidence_score                   Int
  eligibility_status                 MarketEligibilityStatus @default(eligible)
  eligibility_reasons                Json                    @default("[]")
  model_version                      String
  weight_profile_key                 String
  weight_profile_version             Int
  as_of_date                         DateTime?
  scoring_policy_version             Int?
  scoring_policy_hash                String?
  scoring_policy_snapshot            Json?
  reproducibility_status             String                  @default("legacy_non_recomputable")
  evidence_origins                   EvidenceOrigin[]        @default([unknown_legacy])
  india_share                        Decimal?                @db.Decimal(6, 3)
  classification_id                  String?
  classification_hs6_code            String?
  classification_itc_hs_code         String?
  classification_nomenclature        String?
  classification_version             String?
  classification_current             Boolean                 @default(true)
  classification_invalidated_at      DateTime?
  classification_invalidation_reason String?

  tariff_summary             Json?
  certification_requirements Json  @default("[]")
  logistics_summary          Json?

  // price_band = money range; currency explicit
  price_band_min      Decimal? @db.Decimal(18, 4)
  price_band_max      Decimal? @db.Decimal(18, 4)
  price_band_currency String?  @db.VarChar(3)

  rationale        String?
  /// docs/13 B2: exporter-visible agent annotation on AI output.
  agent_note       String?
  /// Per-field source and retrieval date, keyed by field name (docs/04 EXP-04-AC03:
  /// "Scores include clear labels and freshness/source metadata where available").
  ///
  /// Two shapes per entry: `{source, retrieved_at, basis, row_count}` for a field computed
  /// from warehouse rows, or `{status: 'unavailable', reason}` for one we hold no data for.
  /// The second shape is the load-bearing one — EXP-04-AC02 forbids fabricating a missing
  /// value, so a gap has to be representable as a gap rather than collapsing to null and
  /// being indistinguishable from a genuine zero.
  ///
  /// Nullable because assessments written by the placeholder engine predate it; a null here
  /// means "this row carries no provenance", not "this row has no sources".
  field_provenance Json?
  generated_at     DateTime @default(now())

  /// "Selected as active target" (docs/04 EXP-04) — the ORG's current focus market.
  /// Exclusive across the whole org, not just this run: selecting a new one clears any
  /// previously selected assessment, even from a different run. Enforced in the select
  /// route's transaction, not by a DB constraint, because "at most one selected per org"
  /// spans rows this table alone can't express a uniqueness constraint over.
  is_selected Boolean   @default(false)
  /// "Saved for later" (docs/04 EXP-04) — a lightweight bookmark, independent of
  /// selection. Non-exclusive: any number of assessments may be saved at once.
  saved_at    DateTime?

  run             DiscoveryRun    @relation(fields: [run_id], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  agent_decisions AgentDecision[]

  @@index([run_id, overall_score])
  @@index([product_id, country_code])
}

