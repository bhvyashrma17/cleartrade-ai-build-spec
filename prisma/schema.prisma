model BuyerFeatureSnapshot {
  id                        String    @id @default(cuid())
  buyer_id                  String    @unique
  import_frequency_per_year Decimal?  @db.Decimal(12, 4)
  last_shipment_date        DateTime?
  shipment_count_12m        Int
  typical_shipment_size     Decimal?  @db.Decimal(20, 3)
  quantity_unit             String?
  origin_mix                Json
  india_sourcing_history    Boolean?
  supplier_concentration    Decimal?  @db.Decimal(8, 6)
  purchasing_trend          Decimal?  @db.Decimal(12, 6)
  provenance                Json
  computed_at               DateTime  @default(now())
  buyer                     Buyer     @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
}

/// Search-result materialization. Fit deliberately does not live on Buyer.
model BuyerFitAssessment {
  id               String           @id @default(cuid())
  buyer_id         String
  product_id       String
  exporter_org_id  String
  score            Int?
  confidence_score Int
  components       Json
  input_snapshot   Json
  model_version    String
  evidence_origins EvidenceOrigin[] @default([unknown_legacy])
  computed_at      DateTime         @default(now())

  /// Immutable scoring-policy provenance, analogous in intent to MarketAssessment's.
  ///
  /// Null on rows written before this existed: those assessments cannot be attributed to a
  /// policy after the fact, and guessing would be worse than admitting the gap — hence the
  /// `legacy_non_recomputable` default rather than a back-fill.
  ///
  /// Deliberately NOT sourced from the `buyers.fit_score_weights` config key: that key
  /// describes a different, unused model (country/category/verification/recency) while this
  /// scorer combines volume/price/certification/outcome. The persisted policy is the one the
  /// code actually applies — see BUYER_FIT_POLICY in src/lib/buyer-intelligence.ts.
  scoring_policy_version  Int?
  scoring_policy_hash     String?
  scoring_policy_snapshot Json?
  reproducibility_status  String          @default("legacy_non_recomputable")
  buyer                   Buyer           @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  product                 Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  exporter_org            ExporterOrg     @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  agent_decisions         AgentDecision[]

  @@unique([buyer_id, product_id, exporter_org_id])
  @@index([exporter_org_id, product_id, score])
}

model BuyerOutcome {
  id               String         @id @default(cuid())
  buyer_id         String
  exporter_org_id  String
  buyer_lead_id    String         @unique
  contacted_at     DateTime?
  replied_at       DateTime?
  converted        Boolean?
  rejection_reason String?
  payment_behavior String?
  deal_id          String?
  payment_evidence Json?
  evidence_origin  EvidenceOrigin @default(unknown_legacy)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  buyer            Buyer          @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  exporter_org     ExporterOrg    @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer_lead       BuyerLead      @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)

  @@index([buyer_id, exporter_org_id])
}

model SanctionsEntity {
  id                  String                   @id @default(cuid())
  source              String
  source_record_id    String
  name                String
  normalized_name     String
  entity_type         String?
  aliases             Json                     @default("[]")
  countries           Json                     @default("[]")
  addresses           Json                     @default("[]")
  dates               Json                     @default("[]")
  identifiers         Json                     @default("[]")
  programs            Json                     @default("[]")
  remarks             String?
  source_published_at DateTime?
  source_version      String?
  observed_at         DateTime
  is_active           Boolean                  @default(true)
  raw_snapshot        Json?
  evidence_origin     EvidenceOrigin           @default(unknown_legacy)
  screening_cases     SanctionsScreeningCase[]

  /// Entities belong to the snapshot that produced them (Phase 7). Screening joins through
  /// `snapshot.state = active`, which is what makes activation atomic: rows for a candidate
  /// snapshot can be written incrementally without ever being visible to screening, and a
  /// failed refresh leaves the previous snapshot's rows serving untouched.
  ///
  /// Nullable because legacy rows predate snapshot binding. A null snapshot is NOT served
  /// in a real workflow environment — see `activeSanctionsEntityWhere()`. Legacy rows stay
  /// exactly as they are (Phase 17: historical data is not retroactively relabelled).
  snapshot_id String?
  snapshot    SanctionsSourceSnapshot? @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)

  /// Normalized aliases, precomputed so alias matching does not renormalize on every
  /// screening call. Source truth stays in `aliases` (Phase 5).
  normalized_aliases Json @default("[]")

  @@unique([snapshot_id, source, source_record_id])
  @@index([normalized_name, is_active])
  @@index([snapshot_id])
}

model SanctionsScreeningCase {
  id                   String                        @id @default(cuid())
  buyer_id             String?
  searched_name        String
  normalized_name      String
  searched_country     String?
  searched_address     String?
  searched_entity_type String?
  searched_identifiers Json                          @default("[]")
  result_state         SanctionsScreeningResultState
  source_entity_id     String?
  evidence             Json
  algorithm_version    String
  created_at           DateTime                      @default(now())
  resolved_at          DateTime?
  buyer                Buyer?                        @relation(fields: [buyer_id], references: [id], onDelete: SetNull)
  source_entity        SanctionsEntity?              @relation(fields: [source_entity_id], references: [id], onDelete: SetNull)
  decisions            SanctionsReviewDecision[]

  @@index([result_state, created_at])
  @@index([buyer_id, created_at])
}

model SanctionsReviewDecision {
  id                String                       @id @default(cuid())
  screening_case_id String
  reviewer_user_id  String
  decision          SanctionsReviewDecisionValue
  reason            String
  evidence          Json?
  created_at        DateTime                     @default(now())
  screening_case    SanctionsScreeningCase       @relation(fields: [screening_case_id], references: [id], onDelete: Cascade)
  reviewer          User                         @relation(fields: [reviewer_user_id], references: [id], onDelete: Restrict)

  @@index([screening_case_id, created_at])
  @@index([reviewer_user_id, created_at])
}

// ---------------------------------------------------------------------------
// Deal
// ---------------------------------------------------------------------------

model Deal {
  id              String  @id @default(cuid())
  exporter_org_id String
  buyer_id        String
  buyer_lead_id   String?
  product_id      String?

  stage DealStage @default(qualifying)

  // value = money
  value_amount   Decimal? @db.Decimal(18, 4)
  value_currency String?  @db.VarChar(3)

  incoterm       String?
  incoterm_place String?

  // quantity = number + unit
  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  // unit_price / total = money, stored not inferred by the UI
  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  payment_terms  Json?
  delivery_terms Json?

  risk_state     RiskState @default(normal)
  risk_reason    String?
  owner_agent_id String?

  /// Snapshot of the fee policy in force at lock time — later config changes never
  /// rewrite it (docs/01 rule of record).
  quoted_fee_policy Json?
  locked_at         DateTime?

  closed_reason String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  /// Optimistic concurrency — a stale write returns 409 VERSION_CONFLICT.
  version       Int      @default(1)

  exporter_org     ExporterOrg      @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer            Buyer            @relation(fields: [buyer_id], references: [id])
  product          Product?         @relation(fields: [product_id], references: [id])
  buyer_lead       BuyerLead?       @relation("LeadDeal")
  owner_agent      User?            @relation("DealOwnerAgent", fields: [owner_agent_id], references: [id])
  proposals        DealProposal[]
  snapshots        DealSnapshot[]
  documents        Document[]
  shipments        Shipment[]
  payments         Payment[]
  tasks            Task[]
  messages         Message[]
  internal_notes   InternalNote[]
  disputes         Dispute[]
  partner_handoffs PartnerHandoff[]
  insurance_cases  InsuranceCase[]
  payouts          Payout[]

  @@index([exporter_org_id, stage])
  @@index([owner_agent_id, stage])
  @@index([risk_state])
}

/// Status of one commercial proposal version (AGT-05 "Required UI states").
enum ProposalStatus {
  draft
  awaiting_exporter
  approved
  changes_requested
  superseded
  withdrawn
}

/// One version of the commercial terms under negotiation (AGT-05-AC01: "Commercial
/// proposals are versioned"; EXP-10-AC01: "Approval references an immutable proposal
/// version ID").
///
/// A `draft` is the only mutable state. Once it leaves draft the row is frozen and a
/// revision writes a NEW version instead of editing this one — that is what makes
/// AGT-05-AC04 ("every revision preserves previous acceptance/change history") and
/// EXP-10-AC01 structurally true rather than a convention the route has to remember.
///
/// `approved_by_id` is deliberately separate from `proposed_by_id`: AGT-05-AC02 requires
/// the exporter to approve their own terms, and an agent must never be able to record an
/// approval on their behalf. The route re-checks `canApproveCommercialTerms()` on the
/// approving principal; this column is the persisted evidence of who actually did it.
model DealProposal {
  id      String @id @default(cuid())
  deal_id String
  version Int

  status ProposalStatus @default(draft)

  // The terms this version proposes — the same set DealSnapshot freezes at lock, so a
  // lock can be built from an approved proposal without re-deriving anything.
  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  incoterm       String?
  incoterm_place String?

  payment_terms Json?

  ship_window_start DateTime?
  ship_window_end   DateTime?

  special_conditions String?
  /// Exporter-visible rationale from the agent. Internal reasoning lives in InternalNote.
  agent_note         String?

  /// Structured buyer-side state the agent records (AGT-05 "Buyer status"). Never
  /// presented as legal acceptance — see the screen copy.
  buyer_status      String?
  buyer_status_note String?

  proposed_by_id String?
  proposed_at    DateTime?

  approved_by_id String?
  approved_at    DateTime?

  /// Structured change request from the exporter (EXP-10 "Request changes").
  changes_requested_by_id String?
  changes_requested_at    DateTime?
  changes_requested_note  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal                 Deal  @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  proposed_by          User? @relation("ProposalProposedBy", fields: [proposed_by_id], references: [id])
  approved_by          User? @relation("ProposalApprovedBy", fields: [approved_by_id], references: [id])
  changes_requested_by User? @relation("ProposalChangesRequestedBy", fields: [changes_requested_by_id], references: [id])

  @@unique([deal_id, version])
  @@index([deal_id, status])
}

/// Frozen at deal_locked. All documents generate from this, never from live deal fields
/// (docs/13 E1). Immutable once written — amendments create a new version.
model DealSnapshot {
  id      String @id @default(cuid())
  deal_id String
  version Int    @default(1)

  buyer_id         String
  buyer_legal_name String
  product_id       String?
  product_name     String?
  sku              String?

  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  incoterm           String?
  incoterm_place     String?
  payment_terms      Json?
  ship_window_start  DateTime?
  ship_window_end    DateTime?
  special_conditions String?

  /// Fee policy in force at the moment of lock.
  fee_policy Json

  created_by_id String?
  created_at    DateTime @default(now())

  deal      Deal       @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([deal_id, version])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  scope_type ScopeType
  scope_id   String

  /// Denormalized tenant key so cross-deal task indexes stay one org-scoped query
  /// rather than a fan-out over N deals (docs/13 A1 backend impact).
  exporter_org_id String?
  deal_id         String?

  title         String
  description   String?
  owner_user_id String?
  owner_role    UserRole

  state    TaskState    @default(not_started)
  priority TaskPriority @default(normal)

  due_at       DateTime?
  warning_at   DateTime?
  /// Derived from due_at/warning_at + SLA config. Never user-editable (AGT-07-AC03).
  sla_state    SlaState  @default(on_time)
  escalated_at DateTime?

  blocked_reason String?
  waiting_on     String?
  cancel_reason  String?
  completed_at   DateTime?

  visibility Visibility @default(exporter_visible)
  task_type  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org ExporterOrg?   @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  deal         Deal?          @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  owner        User?          @relation("TaskOwner", fields: [owner_user_id], references: [id])
  evidence     TaskEvidence[]

  @@index([exporter_org_id, state, due_at])
  @@index([owner_user_id, state, due_at])
  @@index([deal_id, state])
  @@index([sla_state])
}

/// EXP-03-AC03: evidence upload with an auditable review outcome, linked to the task it
/// was uploaded for. A separate table rather than fields on Task — a task can accumulate
/// several upload attempts (reject, re-upload), and each one's own reviewer/outcome/note
/// must stay attributable, not overwritten by the next attempt.
model TaskEvidence {
  id        String @id @default(cuid())
  task_id   String
  file_ref  String
  file_name String

  uploaded_by_id String
  uploaded_at    DateTime @default(now())

  review_status  EvidenceReviewStatus @default(pending)
  review_note    String?
  reviewed_by_id String?
  reviewed_at    DateTime?

  created_at DateTime @default(now())

  task        Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploaded_by User  @relation("TaskEvidenceUploader", fields: [uploaded_by_id], references: [id])
  reviewed_by User? @relation("TaskEvidenceReviewer", fields: [reviewed_by_id], references: [id])

  @@index([task_id, created_at])
  @@index([review_status])
}

enum EvidenceReviewStatus {
  pending
  approved
  rejected
}

enum FileScanStatus {
  pending
  clean
  infected
  failed
  unknown_legacy
}

// ---------------------------------------------------------------------------
// Documents — four independent status dimensions
// ---------------------------------------------------------------------------

model Document {
  id          String  @id @default(cuid())
  deal_id     String?
  shipment_id String?

  doc_type           DocType
  version            Int            @default(1)
  is_current_version Boolean        @default(true)
  source             DocumentSource

  /// Four independent dimensions. Collapsing any two of these is a spec violation
  /// (docs/07 §7.3, docs/13 A5).
  generation_status GenerationStatus @default(queued)
  review_status     ReviewStatus     @default(not_reviewed)
  approval_status   ApprovalStatus   @default(not_required)
  filing_status     FilingStatus     @default(not_applicable)

  generation_error         String?
  changes_requested_reason String?
  rejection_reason         String?
  filing_reference         String?
  filed_at                 DateTime?
  /// AGT-06-AC02: a filing is an external handoff, so it records WHO filed it alongside
  /// the status, timestamp and reference. Without this the audit trail can say a document
  /// was filed but not by whom, which is exactly the gap AC02 closes.
  filed_by_id              String?

  /// Secure object ref — resolved to a short-lived signed URL, never a public bucket URL.
  file_ref           String?
  file_name          String?
  file_size_bytes    Int?
  mime_type          String?
  checksum           String?
  storage_provider   String?
  storage_version_id String?
  scan_status        FileScanStatus @default(unknown_legacy)
  scan_engine        String?
  scanned_at         DateTime?
  uploaded_by_id     String?

  /// The DealSnapshot the document generated from — enables reproducible regeneration.
  generated_from_snapshot_id String?
  generation_inputs          Json?

  reviewed_by_id    String?
  reviewed_at       DateTime?
  approved_by_id    String?
  /// Approval is bound to this version + checksum, not to the document identity.
  approved_version  Int?
  approved_checksum String?
  approved_at       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal     Deal?         @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment Shipment?     @relation(fields: [shipment_id], references: [id])
  snapshot DealSnapshot? @relation(fields: [generated_from_snapshot_id], references: [id])
  reviewer User?         @relation("DocumentReviewer", fields: [reviewed_by_id], references: [id])
  approver User?         @relation("DocumentApprover", fields: [approved_by_id], references: [id])
  filed_by User?         @relation("DocumentFiler", fields: [filed_by_id], references: [id])
  disputes Dispute[]

  // A deal must never have two rows claiming the same (doc_type, version) — the
  // generate/upload routes rely on this to be the single source of truth for "which row
  // is THE v2 of the CI", not just a convention they happen to follow.
  @@unique([deal_id, doc_type, version])
  @@index([approval_status])
  @@index([filing_status])
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------

model Shipment {
  id      String @id @default(cuid())
  deal_id String

  status ShipmentStatus @default(planning)
  mode   ShipmentMode?

  origin      Json?
  destination Json?

  /// Snapshot from the deal at creation, not a live read.
  incoterm String?

  cha_partner_id     String?
  freight_partner_id String?
  booking_ref        String?
  customs_ref        String?
  shipping_bill_no   String?

  exception_state    ExceptionState @default(none)
  exception_reason   String?
  exception_owner_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal             Deal                @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  cha_partner      Partner?            @relation("ChaPartner", fields: [cha_partner_id], references: [id])
  freight_partner  Partner?            @relation("FreightPartner", fields: [freight_partner_id], references: [id])
  milestones       ShipmentMilestone[]
  documents        Document[]
  disputes         Dispute[]
  partner_handoffs PartnerHandoff[]

  @@index([deal_id])
  @@index([status])
  @@index([exception_state])
}

/// ETA and actual are distinct columns — EXP-14-AC02 requires both to be visible.
model ShipmentMilestone {
  id           String         @id @default(cuid())
  shipment_id  String
  code         String
  label        String
  state        MilestoneState @default(pending)
  eta_at       DateTime?
  actual_at    DateTime?
  evidence_ref String?
  sequence     Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  shipment Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([shipment_id, code])
  @@index([shipment_id, sequence])
}

model Partner {
  id             String        @id @default(cuid())
  type           PartnerType
  legal_name     String
  display_name   String
  country_code   String        @db.VarChar(2)
  contact_email  String?
  contact_phone  String?
  partner_status PartnerStatus @default(active)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  cha_shipments     Shipment[]       @relation("ChaPartner")
  freight_shipments Shipment[]       @relation("FreightPartner")
  handoffs          PartnerHandoff[]

  @@index([type, partner_status])
}

/// AGT-06-AC02: "every external filing/partner handoff has owner, status, timestamp and
/// reference/evidence where available."
///
/// `Shipment.cha_partner_id` records WHICH partner is assigned; it cannot record that the
/// packet was sent on a date by a named agent under a reference the partner quoted back.
/// This is that record — one row per handoff event, never overwritten, so a re-assignment
/// leaves the original handoff visible rather than silently replacing it.
///
/// The partner is a foreign key into the approved directory, not a string. AGT-06 says
/// "no free-text phantom partner in structured assignment" — that is enforced here by the
/// column type, so it cannot be violated by a route that forgets to validate.
model PartnerHandoff {
  id          String  @id @default(cuid())
  deal_id     String
  shipment_id String?
  partner_id  String

  /// Which lane this handoff belongs to (docs/05 AGT-06 execution lanes).
  lane   PartnerType
  status HandoffStatus @default(pending)

  /// The accountable ClearTrade-side owner. Not nullable in practice — a handoff nobody
  /// owns is the failure mode AC02 exists to prevent.
  owner_user_id String

  /// Reference the partner issued back (job number, filing ref, booking ref). Null until
  /// they respond — "where available" in AC02.
  reference String?
  notes     String?

  sent_at         DateTime  @default(now())
  acknowledged_at DateTime?
  completed_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal     Deal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [partner_id], references: [id])
  owner    User      @relation("PartnerHandoffOwner", fields: [owner_user_id], references: [id])

  @@index([deal_id, lane])
  @@index([partner_id, status])
}

enum HandoffStatus {
  pending
  sent
  acknowledged
  completed
  rejected
}

// ---------------------------------------------------------------------------
// Money in / risk
// ---------------------------------------------------------------------------

model Payment {
  id      String @id @default(cuid())
  deal_id String

  // money
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  amount_received Decimal? @db.Decimal(18, 4)

  payment_method String?
  status         PaymentStatus @default(not_due)

  due_at      DateTime?
  received_at DateTime?
  realized_at DateTime?

  evidence_refs Json @default("[]")

  /// Independent of status — never inferred from received/realized.
  brc_status BrcStatus @default(not_applicable)

  /// Provenance is mandatory and rendered on every milestone (docs/13 E3).
  source PaymentSource @default(exporter_update)

  label      String?
  sequence   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal     Deal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  disputes Dispute[]

  @@index([deal_id, sequence])
  @@index([status, due_at])
}

model InsuranceCase {
  id          String  @id @default(cuid())
  deal_id     String
  shipment_id String?

  status InsuranceCaseStatus @default(not_started)

  provider_name String?
  policy_ref    String?

  // money
  premium_amount   Decimal? @db.Decimal(18, 4)
  premium_currency String?  @db.VarChar(3)
  covered_amount   Decimal? @db.Decimal(18, 4)
  covered_currency String?  @db.VarChar(3)

  quote_requested_at DateTime?
  bound_at           DateTime?
  claim_opened_at    DateTime?
  claim_settled_at   DateTime?
  notes              String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([deal_id])
}

model Dispute {
  id         String    @id @default(cuid())
  scope_type ScopeType
  scope_id   String

  deal_id     String?
  shipment_id String?
  payment_id  String?
  document_id String?

  type     DisputeType
  severity DisputeSeverity @default(medium)
  status   DisputeStatus   @default(open)

  owner_user_id String?
  /// User-safe summary. Internal notes live in InternalNote, never here.
  summary       String
  resolution    String?
  accepted_at   DateTime?
  /// docs/07 §7.7 `investigating -> waiting_external` requires "waiting party + follow-up
  /// date". `waiting_on` is the party/reason (mirrors Task.waiting_on); `sla_due_at`
  /// doubles as the follow-up date while waiting_external.
  waiting_on    String?
  sla_due_at    DateTime?
  closed_at     DateTime?
  /// AC03 (OPS-06): closure records its outcome basis distinctly from the resolution
  /// text itself — "accepted by the exporter" vs "closed on another authorized basis"
  /// are different facts, and collapsing them into `resolution` would lose which one
  /// actually happened.
  closure_basis String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner          User?          @relation(fields: [owner_user_id], references: [id])
  deal           Deal?          @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment       Shipment?      @relation(fields: [shipment_id], references: [id])
  payment        Payment?       @relation(fields: [payment_id], references: [id])
  document       Document?      @relation(fields: [document_id], references: [id])
  internal_notes InternalNote[]
  payouts        Payout[]

  @@index([status, severity])
  @@index([deal_id])
  @@index([owner_user_id, status])
}

// ---------------------------------------------------------------------------
// Agent payout — AGT-08 / OPS-05
// ---------------------------------------------------------------------------

/// docs/06 OPS-05: "Not eligible | Explain dependency". `not_eligible` is a real
/// persisted state, not the absence of a row: a deal that has an agent and a locked
/// snapshot but whose payment has not realized needs somewhere to record WHY it is not
/// yet payable, which "no row at all" cannot express.
enum PayoutState {
  not_eligible
  eligible
  approved
  paid
  disputed
}

/// Agent commission record — AGT-08-AC02 / OPS-05-AC02.
///
/// Same immutability discipline as DealSnapshot: the money columns below are a SNAPSHOT
/// taken at the moment the payout became eligible, never a live join back to FeePolicy.
/// A later fee-policy version (OPS-07 can create one at any time) must never silently
/// restate what an agent was already told they had earned — which is exactly what a
/// recalculate-on-read design would do.
///
/// Note the deliberate redundancy with `Deal.quoted_fee_policy`: that snapshot is frozen
/// at deal LOCK, this one at payout ELIGIBILITY, and the two are different moments. The
/// agent share rate is copied here rather than read through the deal because an agent
/// can be reassigned between those moments, and the payout must record the rate that
/// applied to the agent who actually earned it.
///
/// Immutable in practice, not just by convention: no route exposes a PATCH of the
/// snapshot columns, and corrections are additive `PayoutAdjustment` rows (OPS-05-AC03).
model Payout {
  id            String @id @default(cuid())
  deal_id       String
  agent_user_id String

  state PayoutState @default(not_eligible)

  // --- Immutable snapshot, written once at eligibility ---------------------
  /// The realized shipment/deal value the fee was computed from.
  basis_amount         Decimal @db.Decimal(18, 4)
  basis_currency       String  @db.VarChar(3)
  /// ClearTrade's own success fee on that basis — the pool the agent share comes out of.
  fee_amount           Decimal @db.Decimal(18, 4)
  fee_currency         String  @db.VarChar(3)
  /// Which fee rule produced `fee_amount` (success_fee | small_shipment_rate | small_shipment_flat).
  fee_rule             String?
  /// Stored as a string, not a float: this is a rate of record, and re-parsing a
  /// serialized float is how a 0.4 becomes a 0.39999999999999997 in a payout dispute.
  agent_share_rate     String
  /// agent_share_rate x fee_amount, computed once and stored — never re-derived on read.
  amount               Decimal @db.Decimal(18, 4)
  currency             String  @db.VarChar(3)
  /// FeePolicy.version the snapshot came from — the audit trail back to the source rates.
  fee_policy_version   Int
  /// Full calculation breakdown, so the math is auditable without re-running it
  /// ("make the math auditable so compensation disputes don't become an ops burden").
  calculation_snapshot Json

  // --- Lifecycle -----------------------------------------------------------
  /// Why this payout is not yet eligible, in plain language (OPS-05 "explain dependency").
  ineligible_reason String?
  /// Which configured eligibility rule was satisfied, recorded at the moment it was.
  eligibility_rule  String?
  eligible_at       DateTime?
  approved_at       DateTime?
  approved_by_id    String?
  paid_at           DateTime?
  /// Bank/transfer reference recorded when finance marks it paid.
  payment_reference String?
  /// Set when the agent (or finance) raises a payout query — links to the Dispute case.
  dispute_id        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal        Deal               @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  agent       User               @relation("PayoutAgent", fields: [agent_user_id], references: [id])
  approved_by User?              @relation("PayoutApprovedBy", fields: [approved_by_id], references: [id])
  dispute     Dispute?           @relation(fields: [dispute_id], references: [id])
  adjustments PayoutAdjustment[]

  /// One payout per (deal, agent). A deal reassigned to a second agent gets a second
  /// row rather than overwriting the first — the original agent's record survives.
  @@unique([deal_id, agent_user_id])
  @@index([agent_user_id, state])
  @@index([state])
}

/// OPS-05-AC03: "Adjustments are additive/audited, not destructive rewrites."
///
/// A correction NEVER updates `Payout.amount`. It appends a signed delta here, and the
/// net payable is `Payout.amount + sum(adjustments.amount)` — computed at render time
/// from rows that each carry their own reason and author. That makes the original quote
/// permanently readable next to what changed it, which is the whole point of the rule.
model PayoutAdjustment {
  id        String @id @default(cuid())
  payout_id String

  /// Signed: negative for a clawback/waiver, positive for a bonus/correction.
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  reason        String
  created_by_id String
  created_at    DateTime @default(now())

  payout     Payout @relation(fields: [payout_id], references: [id], onDelete: Cascade)
  created_by User   @relation("PayoutAdjustmentAuthor", fields: [created_by_id], references: [id])

  @@index([payout_id])
}

// ---------------------------------------------------------------------------
// Communication — exporter-visible vs internal are separate tables, not a flag
// ---------------------------------------------------------------------------

model Message {
  id              String  @id @default(cuid())
  thread_key      String
  deal_id         String?
  buyer_lead_id   String?
  exporter_org_id String

  author_user_id String
  body           String
  /// Structurally exporter-visible. Internal content cannot be stored here.
  created_at     DateTime  @default(now())
  read_at        DateTime?

  author     User       @relation(fields: [author_user_id], references: [id])
  deal       Deal?      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  buyer_lead BuyerLead? @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)

  @@index([thread_key, created_at])
  @@index([exporter_org_id])
}

/// Never exporter-visible. A separate table so there is no toggle that can default open
/// (AGENTS.md: leakage of internal negotiation notes is a top trust risk).
model InternalNote {
  id            String    @id @default(cuid())
  scope_type    ScopeType
  scope_id      String
  deal_id       String?
  buyer_lead_id String?
  dispute_id    String?

  author_user_id String
  body           String
  created_at     DateTime @default(now())

  author     User       @relation(fields: [author_user_id], references: [id])
  deal       Deal?      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  buyer_lead BuyerLead? @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
  dispute    Dispute?   @relation(fields: [dispute_id], references: [id], onDelete: Cascade)

  @@index([scope_type, scope_id])
}

// ---------------------------------------------------------------------------
// Governance & platform
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(cuid())
  user_id     String
  type        String
  title       String
  body        String
  severity    NotificationSeverity @default(info)
  object_type String?
  object_id   String?
  /// A deep link is a convenience, not an authorization grant — the target still authorizes.
  deep_link   String?
  read_at     DateTime?
  dedupe_key  String?
  created_at  DateTime             @default(now())

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([user_id, dedupe_key])
  @@index([user_id, read_at, created_at])
}

model NotificationDelivery {
  id                    String                     @id @default(cuid())
  notification_id       String
  channel               NotificationChannel
  destination_reference String
  template_key          String
  template_version      String
  status                NotificationDeliveryStatus @default(queued)
  attempt_count         Int                        @default(0)
  provider              String?
  provider_message_id   String?
  queued_at             DateTime                   @default(now())
  sent_at               DateTime?
  delivered_at          DateTime?
  failed_at             DateTime?
  next_retry_at         DateTime?
  last_error_code       String?
  last_error_message    String?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  notification Notification                  @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  attempts     NotificationDeliveryAttempt[]

  @@unique([notification_id, channel])
  @@index([status, next_retry_at])
}

model NotificationDeliveryAttempt {
  id                  String                     @id @default(cuid())
  delivery_id         String
  attempt_no          Int
  provider            String
  status              NotificationDeliveryStatus
  provider_message_id String?
  error_code          String?
  error_message       String?
  started_at          DateTime                   @default(now())
  finished_at         DateTime?

  delivery NotificationDelivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)

  @@unique([delivery_id, attempt_no])
}

/// EXP-17: per-user, per-category channel toggle. Only categories that
/// `NOTIFICATION_CATEGORIES[key].disableable` allows get a row here — the "critical
/// legal/security notifications may be non-disableable" rule (docs/04) is enforced by
/// `src/lib/notifications.ts` refusing to write a preference row for a non-disableable
/// category at all, rather than writing one and hoping every read site remembers to
/// ignore it.
model NotificationPreference {
  id             String   @id @default(cuid())
  user_id        String
  category       String
  email_enabled  Boolean  @default(true)
  in_app_enabled Boolean  @default(true)
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category])
}

/// EXP-17 Team: an invitation is a distinct object from a User row on purpose — "Invite
/// pending" is a required UI state (docs/04) with its own visible status and
/// resend/revoke actions, which a directly-created inactive User could not represent
/// cleanly (a User has no "pending" concept, and password_hash-null already means
/// something else — a guest).
model Invitation {
  id              String           @id @default(cuid())
  exporter_org_id String
  email           String
  role            UserRole
  status          InvitationStatus @default(pending)
  token           String           @unique

  invited_by_id String
  expires_at    DateTime
  accepted_at   DateTime?
  revoked_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  invited_by   User        @relation("InvitationInviter", fields: [invited_by_id], references: [id])

  @@index([exporter_org_id, status])
  @@index([email, status])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// Append-only. The application layer exposes no update or delete path; corrections
/// are new events (docs/08 §2).
model AuditEvent {
  id              String      @id @default(cuid())
  actor_user_id   String?
  role            UserRole?
  action          String
  object_type     String
  object_id       String
  /// Denormalized for tenant-scoped audit reads without joining through the object graph.
  exporter_org_id String?
  timestamp       DateTime    @default(now())
  before_summary  Json?
  after_summary   Json?
  correlation_id  String
  source          AuditSource @default(web)

  actor User? @relation(fields: [actor_user_id], references: [id])

  @@index([object_type, object_id, timestamp])
  @@index([actor_user_id, timestamp])
  @@index([exporter_org_id, timestamp])
  @@index([correlation_id])
}

/// DB-backed job queue — no external broker. State survives refresh and device change
/// because it lives here, not in browser memory (docs/09 §3).
model Job {
  id              String    @id @default(cuid())
  type            JobType
  status          JobStatus @default(queued)
  exporter_org_id String?
  requested_by_id String?
  /// Dedupe key for "an equivalent job is already running" (JOB_ALREADY_RUNNING).
  dedupe_key      String?
  idempotency_key String?
  payload         Json      @default("{}")
  result          Json?
  error_code      String?
  error_message   String?
  progress        Int       @default(0)
  target_type     String?
  target_id       String?
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  run_after       DateTime  @default(now())
  started_at      DateTime?
  completed_at    DateTime?
  correlation_id  String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  requested_by User?        @relation(fields: [requested_by_id], references: [id])
  job_attempts JobAttempt[]

  @@unique([dedupe_key])
  @@unique([idempotency_key])
  @@index([status, run_after])
  @@index([exporter_org_id, type, status])
}

/// Retry creates a new attempt row; a historical successful result is never overwritten.
model JobAttempt {
  id            String    @id @default(cuid())
  job_id        String
  attempt_no    Int
  status        JobStatus @default(processing)
  started_at    DateTime  @default(now())
  finished_at   DateTime?
  error_code    String?
  error_message String?
  result        Json?

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, attempt_no])
}

model WorkerHeartbeat {
  id                   String    @id
  instance_id          String
  status               String
  active_job_id        String?
  last_seen_at         DateTime
  last_error_at        DateTime?
  last_error           String?
  consecutive_failures Int       @default(0)
  started_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([last_seen_at])
}

/// Per-IP quota for guest-tier AI runs. Guests can spend real money on AI jobs before
/// they have any account, so the counter is keyed on the caller's network identity, not
/// on the guest row — a cleared cookie mints a new org, but the IP is unchanged.
///
/// `ip_hash` is HMAC-SHA256(ip, GUEST_IP_HASH_SECRET), never the raw address: an IP is
/// personal data, and an unkeyed hash of a 32-bit space is trivially reversible.
///
/// The window is rolling-daily rather than lifetime on purpose. Indian mobile carriers
/// use CGNAT, so one address fronts very large numbers of real users — a lifetime cap
/// would permanently lock out legitimate prospects in the primary market.
model GuestRunQuota {
  id           String   @id @default(cuid())
  ip_hash      String
  window_start DateTime
  runs_used    Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([ip_hash, window_start])
  @@index([window_start])
}

/// Business constants live here, versioned — never hardcoded in application code
/// (docs/01 §2). Reads go through src/lib/config.ts.
model ConfigSetting {
  id             String   @id @default(cuid())
  key            String
  version        Int      @default(1)
  value          Json
  description    String?
  is_active      Boolean  @default(true)
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([key, version])
  @@index([key, is_active])
}

/// Versioned fee policy. A deal snapshots the version in force at lock time; later
/// versions never rewrite historical deals.
model FeePolicy {
  id      String @id @default(cuid())
  version Int    @unique

  commitment_fee_amount   Decimal             @db.Decimal(18, 4)
  commitment_fee_currency String              @db.VarChar(3)
  commitment_fee_status   CommitmentFeeStatus @default(not_due)

  success_fee_rate Decimal @db.Decimal(6, 4)

  small_shipment_threshold_amount   Decimal @db.Decimal(18, 4)
  small_shipment_threshold_currency String  @db.VarChar(3)
  small_shipment_rate               Decimal @db.Decimal(6, 4)
  small_shipment_flat_amount        Decimal @db.Decimal(18, 4)

  agent_share_rate Decimal @db.Decimal(6, 4)

  minimum_shipment_amount   Decimal @db.Decimal(18, 4)
  minimum_shipment_currency String  @db.VarChar(3)

  is_active      Boolean  @default(true)
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trade data warehouse — deliberately separate from the canonical domain above.
//
// Precedent: GuestRunQuota / ConfigSetting / FeePolicy already live in their own section
// at the end of this file rather than beside Deal/Task/Document — infrastructural and
// bulk-external data does not belong in the same section as the objects a user's request
// directly reads and writes. TradeFlow follows that precedent: it is warehouse input for
// future scoring, not a domain object anyone transacts against.
// ---------------------------------------------------------------------------

enum TradeFlowDirection {
  import
  export
}

enum TradeDataSource {
  comtrade
  cbp_vessel_manifest
}

/// How a warehouse row was obtained. `legacy_unknown` is intentionally distinct from every
/// usable client mode: pre-provenance development rows cannot be promoted to authenticated data.
enum TradeSourceMode {
  legacy_unknown
  fixture
  mock
  preview
  authenticated
  public_real
  imported_real
  manually_entered_real
}

/// Cross-domain evidence origin. Provider-specific transport details remain on the
/// source record; this enum answers the enforcement question: may this evidence enter a
/// real customer workflow in the current deployment environment?
enum EvidenceOrigin {
  unknown_legacy
  fixture
  mock
  preview
  authenticated_real
  public_real
  imported_real
  manually_entered_real
}

enum IngestStatus {
  running
  throttled
  completed
  failed
  partial
}

/// Raw UN Comtrade trade flow rows — the warehouse layer, not the product domain.
///
/// SERVER-SIDE ONLY, NON-NEGOTIABLE: no API route may ever return rows of this model to a
/// client, in whole or in projection. Comtrade's subscription terms license this data for
/// Internal Use only — it may not be redistributed or re-served. Only computed scores and
/// derived aggregates built ON TOP of this table (e.g. a future market-scoring job's
/// output) are allowed to cross the API boundary. Enforced by omission: there is no
/// `/api/v1/trade-flows` route, and there must never be one. `scripts/verify-comtrade-
/// ingest.ts` greps the route tree for references to this model to keep that true.
///
/// `reporter`/`partner` are stored as Comtrade's own numeric reporter/partner codes
/// (e.g. "699" for India, "0" for World), not ISO country codes — Comtrade's API takes
/// and returns these codes directly, and re-mapping them to ISO here would be an
/// unverified translation this warehouse layer has no business doing.
///
/// Idempotency key is `(reporter, partner, hs_code, year, source)` per spec — it does not
/// include `period` (sub-year periods are a later concern; the free tier ingested here is
/// annual) or `flow_direction` (a single ingest run is scoped to one flow direction; an
/// import and an export series for the same reporter/partner/code/year are two different
/// questions, but only one may be stored per key today — extend the key before ever
/// ingesting both directions for the same series).
model TradeFlow {
  id                     String             @id @default(cuid())
  reporter               String
  partner                String
  hs_code                String
  year                   Int
  period                 String
  value                  Decimal            @db.Decimal(20, 3)
  quantity               Decimal?           @db.Decimal(18, 3)
  unit                   String?
  /// value / quantity, computed once at ingest time. Null when quantity is null or zero.
  unit_value             Decimal?           @db.Decimal(18, 6)
  flow_direction         TradeFlowDirection
  source                 TradeDataSource
  /// Queryable, immutable acquisition provenance. Legacy rows are deliberately unknown.
  provider               String             @default("unverified_legacy")
  source_mode            TradeSourceMode    @default(legacy_unknown)
  ingest_run_id          String?
  retrieved_at           DateTime
  request_batch_id       String?
  source_dataset         String?
  source_dataset_version String?
  ingested_at            DateTime           @default(now())

  ingest_run   IngestRun?             @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  acquisitions TradeFlowAcquisition[]

  @@unique([reporter, partner, hs_code, year, flow_direction, source])
  @@index([hs_code, year])
  @@index([ingest_run_id])
  @@index([provider, source_mode, retrieved_at])
}

/// Immutable observation ledger. TradeFlow is the current warehouse projection; this record
/// preserves every exact run/batch/value observation when the projection is refreshed.
model TradeFlowAcquisition {
  id                     String             @id @default(cuid())
  trade_flow_id          String
  ingest_run_id          String
  reporter               String
  partner                String
  hs_code                String
  year                   Int
  period                 String
  flow_direction         TradeFlowDirection
  source                 TradeDataSource
  value                  Decimal            @db.Decimal(20, 3)
  quantity               Decimal?           @db.Decimal(18, 3)
  unit                   String?
  unit_value             Decimal?           @db.Decimal(18, 6)
  provider               String
  source_mode            TradeSourceMode
  retrieved_at           DateTime
  request_batch_id       String
  source_dataset         String?
  source_dataset_version String?
  created_at             DateTime           @default(now())

  trade_flow TradeFlow @relation(fields: [trade_flow_id], references: [id], onDelete: Restrict)
  ingest_run IngestRun @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)

  @@unique([ingest_run_id, reporter, partner, hs_code, year, flow_direction, source])
  @@index([trade_flow_id, retrieved_at])
  @@index([provider, source_mode, retrieved_at])
}

/// One execution of a warehouse ingest job. Deliberately a separate status axis from
/// `Job.status`: a caught, recorded ingest failure (rate limit exhausted, malformed
/// response) still lets the JOB report `completed` — the job system did its job by
/// running the handler to completion — while THIS row is the true record of whether the
/// domain-level ingest actually produced data. Never collapse the two, same reasoning as
/// Job state vs. Task/SLA state elsewhere in this schema.
model IngestRun {
  id                         String          @id @default(cuid())
  source                     TradeDataSource
  provider                   String          @default("unverified_legacy")
  client_mode                TradeSourceMode @default(legacy_unknown)
  authenticated              Boolean         @default(false)
  /// SHA-256 identity for a high-entropy provider credential; never the credential itself.
  credential_fingerprint     String?
  source_dataset             String?
  source_dataset_version     String?
  code_range                 String?
  batch_size                 Int?
  status                     IngestStatus    @default(running)
  /// What was actually requested (hs_chapter, reporter, partner(s), year, flow_direction)
  /// — kept so a failed or partial run is legible without cross-referencing the Job row.
  params                     Json?
  records_written            Int             @default(0)
  records_total              Int?
  records_processed          Int             @default(0)
  total_codes                Int             @default(0)
  completed_codes            Int             @default(0)
  request_count              Int             @default(0)
  throttle_count             Int             @default(0)
  provider_throttle_count    Int             @default(0)
  local_quota_throttle_count Int             @default(0)
  /// Durable ordered HS6 list and next offset. A retry resumes this run in place.
  progress                   Json?
  last_throttled_at          DateTime?
  retry_after                DateTime?
  started_at                 DateTime        @default(now())
  completed_at               DateTime?
  error                      String?

  trade_flows             TradeFlow[]
  trade_flow_acquisitions TradeFlowAcquisition[]
  import_records          ImportRecord[]

  @@index([source, started_at])
  @@index([provider, client_mode, started_at])
}

/// Shared provider quota ledger. A conditional database update reserves each request, so the
/// limit remains coherent across jobs, workers, and process restarts.
model ProviderQuotaWindow {
  id                          String    @id @default(cuid())
  provider                    String
  credential_fingerprint      String
  window_start                DateTime
  window_end                  DateTime
  configured_limit            Int
  requests_reserved           Int       @default(0)
  provider_reported_limit     Int?
  provider_reported_remaining Int?
  provider_reported_reset_at  DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  @@unique([provider, credential_fingerprint, window_start])
  @@index([window_end])
}

/// Server-side-only US inward vessel manifest row. This is a partial observation of ocean
/// cargo, not a complete buyer directory; confidential parties are absent at source.
model ImportRecord {
  id                    String          @id @default(cuid())
  buyer_ref             String?
  buyer_ref_key_version String?
  /// Legacy-only compatibility column. New ingest writes restricted identity to
  /// RawImportIdentity and leaves this null.
  raw_consignee_string  String?
  hs_code               String?
  country               String          @db.VarChar(2)
  shipment_date         DateTime
  value                 Decimal?        @db.Decimal(20, 3)
  value_currency        String?         @db.VarChar(3)
  quantity              Decimal?        @db.Decimal(20, 3)
  /// Manifest package count is meaningful only with CBP's accompanying unit code.
  quantity_unit         String?
  origin_country        String?         @db.VarChar(2)
  port                  String?
  shipper_name          String?
  source                TradeDataSource
  source_record_id      String          @unique
  retrieved_at          DateTime
  evidence_origin       EvidenceOrigin  @default(unknown_legacy)
  ingest_run_id         String?

  source_provider    String
  license_type       String
  allowed_to_display Boolean
  allowed_to_export  Boolean
  allowed_to_cache   Boolean
  retention_limit    DateTime?
  personal_data_flag Boolean
  rights_grant_id    String?

  buyer_id              String?
  resolution_confidence Decimal?  @db.Decimal(6, 5)
  resolution_method     String?
  resolved_at           DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  buyer        Buyer?             @relation(fields: [buyer_id], references: [id], onDelete: SetNull)
  ingest_run   IngestRun?         @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  rights_grant SourceRightsGrant? @relation(fields: [rights_grant_id], references: [id], onDelete: Restrict)
  raw_identity RawImportIdentity?

  @@index([hs_code, country, shipment_date])
  @@index([buyer_ref, shipment_date])
  @@index([buyer_id, shipment_date])
  @@index([retention_limit])
  @@index([evidence_origin, shipment_date])
  @@index([ingest_run_id])
  @@index([rights_grant_id])
}

/// Normalized evidence for the operator-supplied rights assertion. `verification_method`
/// is honest about whether this is merely asserted or linked to reviewed evidence.
model SourceRightsGrant {
  id                    String             @id @default(cuid())
  provider              String
  delivery_batch_id     String
  license_type          String
  contract_license_ref  String?
  effective_at          DateTime?
  expires_at            DateTime?
  allowed_to_display    Boolean
  allowed_to_export     Boolean
  allowed_to_cache      Boolean
  raw_retention_policy  RawRetentionPolicy
  derived_data_policy   DerivedDataPolicy  @default(unspecified)
  evidence_document_ref String?
  evidence_checksum     String
  verification_method   String             @default("operator_asserted")
  created_at            DateTime           @default(now())
  import_records        ImportRecord[]

  @@unique([provider, delivery_batch_id, evidence_checksum])
  @@index([expires_at])
}

/// AES-GCM encrypted raw source identity. It is never selected by routine buyer queries.
model RawImportIdentity {
  id               String       @id @default(cuid())
  import_record_id String       @unique
  ciphertext       Bytes
  iv               Bytes
  auth_tag         Bytes
  key_version      String
  created_at       DateTime     @default(now())
  import_record    ImportRecord @relation(fields: [import_record_id], references: [id], onDelete: Cascade)
}

model RawDataAccessEvent {
  id               String   @id @default(cuid())
  import_record_id String
  actor_user_id    String?
  action           String
  reason           String
  accessed_at      DateTime @default(now())
  actor            User?    @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([import_record_id, accessed_at])
  @@index([actor_user_id, accessed_at])
}

model ImportRetentionEvent {
  id                   String   @id @default(cuid())
  import_record_id     String
  action               String
  dry_run              Boolean
  raw_identity_deleted Boolean  @default(false)
  record_deleted       Boolean  @default(false)
  derived_preserved    Boolean
  policy_snapshot      Json
  occurred_at          DateTime @default(now())
  source_record_id     String

  @@index([occurred_at])
}

model DataDeletionRequest {
  id                String                    @id @default(cuid())
  subject_reference String
  request_scope     Json
  status            DataDeletionRequestStatus @default(requested)
  requested_at      DateTime                  @default(now())
  reviewed_by_id    String?
  decision_reason   String?
  completed_at      DateTime?
  review_events     Json                      @default("[]")
  reviewer          User?                     @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([status, requested_at])
}

// ---------------------------------------------------------------------------
// Agent decision layer (Phase 1)
//
// The human-control layer over Demand Discovery and Buyer Discovery. Its entire reason for
// existing is that an agent's judgement must be recorded WITHOUT touching what the model
// computed: MarketAssessment.overall_score, BuyerFitAssessment.score, their component
// breakdowns, confidence, provenance and policy hashes are never written by this path.
// "The model said 71 and the agent ranked it first anyway" has to remain answerable years
// later, which is impossible if either half overwrites the other.
// ---------------------------------------------------------------------------

/// Which kind of model output a decision is about. Redundant with which foreign key is
/// populated, and deliberately so: it makes the common "all market decisions for this org"
/// query indexable without a join, and a DB constraint keeps the two in agreement.
enum AgentDecisionTarget {
  market
  buyer
}

/// What the agent decided. Not every action is meaningful for every target — a market is
/// never `shortlisted` and a buyer is never `mark_selected` — so the target/action pairing
/// is constrained in the database rather than left to callers to get right.
enum AgentDecisionAction {
  /// Both targets.
  promote
  demote
  restore
  pause_automation
  resume_automation
  request_review
  /// Markets only.
  reject
  mark_selected
  mark_not_selected
  /// Buyers only.
  shortlist
  disqualify
  qualify
  unqualify
}

/// A single agent judgement. Append-only: rows are inserted, never updated.
///
/// Supersession points BACKWARD (`supersedes_id` on the newer row) rather than forward.
/// A forward `superseded_by_id` would require an UPDATE of the historical row every time a
/// newer decision arrived, which is precisely the mutation this table exists to prevent; a
/// backward pointer records the same chain while leaving every earlier row byte-identical
/// to when it was written. The consequence is that "is this decision still in force?" is
/// derived (see `currentDecisions` in src/lib/agent-decisions.ts), not stored — which is
/// correct anyway, because expiry makes it a function of time rather than a stored fact.
model AgentDecision {
  id              String @id @default(cuid())
  /// Tenant key. Also the authorization boundary: an agent may only write here for an org
  /// they hold an active AgentAssignment for.
  exporter_org_id String
  actor_user_id   String

  /// EXACTLY ONE of these is non-null, enforced by the `AgentDecision_target_shape`
  /// constraint. Explicit nullable foreign keys rather than a loose (type, id) pair, so a
  /// decision cannot outlive or misname its subject: the database itself refuses a row
  /// pointing at an assessment that does not exist.
  market_assessment_id    String?
  buyer_fit_assessment_id String?

  target AgentDecisionTarget
  action AgentDecisionAction

  /// The agent's operational ordering, entirely separate from the model's rank. Null for
  /// actions where ordering is meaningless (a rejection has no priority).
  agent_priority Int?

  /// Mandatory. An override without a stated reason is unreviewable, so the column is
  /// non-null and the service rejects blank/whitespace input.
  reason String

  /// Immutable copies of what the model said AT DECISION TIME.
  ///
  /// Not derivable from a join later: assessments are recomputed as evidence and policy
  /// change, so reading the score through `market_assessment_id` tomorrow answers a
  /// different question than "what did the agent actually overrule?". Without these
  /// columns the AI-vs-human comparison in docs/30 §3c silently comers to compare an
  /// override against a score that did not exist when the override was made.
  original_score            Int?
  original_rank             Int?
  original_confidence_score Int?
  original_model_version    String?
  original_policy_hash      String?
  original_policy_version   Int?

  /// Explainable decision-time state, needed because some subjects are updated IN PLACE.
  ///
  /// A MarketAssessment is per-run, so an old one survives a recompute and the FK alone can
  /// reconstruct what was overruled. A BuyerFitAssessment is unique on
  /// (buyer, product, org) and upserted, so a recompute DESTROYS the state the agent saw —
  /// the FK then points at numbers that did not exist at decision time. These columns are the
  /// only surviving record for that case, so they are copied, never referenced.
  ///
  /// `BuyerFeatureSnapshot` is not usable as a stable reference here: it is also unique per
  /// buyer and updated in place, so it offers no immutable per-computation row to point at.
  original_components          Json?
  /// The assessment's own `input_snapshot` — small and bounded (product, hs_code, source
  /// record ids), so it is copied whole rather than hashed into something unreadable.
  original_input_snapshot      Json?
  /// SHA-256 of the copied input snapshot, for integrity and cheap equality checks.
  original_input_snapshot_hash String?
  /// When the overruled assessment was computed — distinct from when the decision was made.
  original_computed_at         DateTime?
  original_evidence_origins    EvidenceOrigin[]

  /// Optional review metadata. `expires_at` makes a decision self-limiting ("prioritise
  /// this market for one quarter"); effective state is derived from it plus supersession.
  expires_at DateTime?

  /// Backward pointer to the decision this one replaces, for the same subject. Unique:
  /// a given decision may be superseded by at most one successor, so the chain stays linear
  /// and cannot fork into two competing "current" decisions.
  supersedes_id String? @unique

  created_at DateTime @default(now())

  exporter_org         ExporterOrg         @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  actor                User                @relation("AgentDecisionActor", fields: [actor_user_id], references: [id])
  market_assessment    MarketAssessment?   @relation(fields: [market_assessment_id], references: [id], onDelete: Cascade)
  buyer_fit_assessment BuyerFitAssessment? @relation(fields: [buyer_fit_assessment_id], references: [id], onDelete: Cascade)
  supersedes           AgentDecision?      @relation("AgentDecisionSupersession", fields: [supersedes_id], references: [id])
  superseded_by        AgentDecision?      @relation("AgentDecisionSupersession")

  @@index([exporter_org_id, target, created_at])
  @@index([market_assessment_id, created_at])
  @@index([buyer_fit_assessment_id, created_at])
  @@index([actor_user_id, created_at])
}
