  created_at            DateTime           @default(now())
  import_records        ImportRecord[]

  @@unique([provider, delivery_batch_id, evidence_checksum])
  @@index([expires_at])
}

/// AES-GCM encrypted raw source identity. It is never selected by routine buyer queries.
model RawImportIdentity {
  id               String       @id @default(cuid())
  import_record_id String       @unique
  ciphertext       Bytes
  iv               Bytes
  auth_tag         Bytes
  key_version      String
  created_at       DateTime     @default(now())
  import_record    ImportRecord @relation(fields: [import_record_id], references: [id], onDelete: Cascade)
}

model RawDataAccessEvent {
  id               String   @id @default(cuid())
  import_record_id String
  actor_user_id    String?
  action           String
  reason           String
  accessed_at      DateTime @default(now())
  actor            User?    @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([import_record_id, accessed_at])
  @@index([actor_user_id, accessed_at])
}

model ImportRetentionEvent {
  id                   String   @id @default(cuid())
  import_record_id     String
  action               String
  dry_run              Boolean
  raw_identity_deleted Boolean  @default(false)
  record_deleted       Boolean  @default(false)
  derived_preserved    Boolean
  policy_snapshot      Json
  occurred_at          DateTime @default(now())
  source_record_id     String

  @@index([occurred_at])
}

model DataDeletionRequest {
  id                String                    @id @default(cuid())
  subject_reference String
  request_scope     Json
  status            DataDeletionRequestStatus @default(requested)
  requested_at      DateTime                  @default(now())
  reviewed_by_id    String?
  decision_reason   String?
  completed_at      DateTime?
  review_events     Json                      @default("[]")
  reviewer          User?                     @relation(fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  @@index([status, requested_at])
}

// ---------------------------------------------------------------------------
// Agent decision layer (Phase 1)
//
// The human-control layer over Demand Discovery and Buyer Discovery. Its entire reason for
// existing is that an agent's judgement must be recorded WITHOUT touching what the model
// computed: MarketAssessment.overall_score, BuyerFitAssessment.score, their component
// breakdowns, confidence, provenance and policy hashes are never written by this path.
// "The model said 71 and the agent ranked it first anyway" has to remain answerable years
// later, which is impossible if either half overwrites the other.
// ---------------------------------------------------------------------------

/// Which kind of model output a decision is about. Redundant with which foreign key is
/// populated, and deliberately so: it makes the common "all market decisions for this org"
/// query indexable without a join, and a DB constraint keeps the two in agreement.
enum AgentDecisionTarget {
  market
  buyer
}

/// What the agent decided. Not every action is meaningful for every target — a market is
/// never `shortlisted` and a buyer is never `mark_selected` — so the target/action pairing
/// is constrained in the database rather than left to callers to get right.
enum AgentDecisionAction {
  /// Both targets.
  promote
  demote
  restore
  pause_automation
  resume_automation
  request_review
  /// Markets only.
  reject
  mark_selected
  mark_not_selected
  /// Buyers only.
  shortlist
  disqualify
  qualify
  unqualify
}

/// A single agent judgement. Append-only: rows are inserted, never updated.
///
/// Supersession points BACKWARD (`supersedes_id` on the newer row) rather than forward.
/// A forward `superseded_by_id` would require an UPDATE of the historical row every time a
/// newer decision arrived, which is precisely the mutation this table exists to prevent; a
/// backward pointer records the same chain while leaving every earlier row byte-identical
/// to when it was written. The consequence is that "is this decision still in force?" is
/// derived (see `currentDecisions` in src/lib/agent-decisions.ts), not stored — which is
/// correct anyway, because expiry makes it a function of time rather than a stored fact.
model AgentDecision {
  id              String @id @default(cuid())
  /// Tenant key. Also the authorization boundary: an agent may only write here for an org
  /// they hold an active AgentAssignment for.
  exporter_org_id String
  actor_user_id   String

  /// EXACTLY ONE of these is non-null, enforced by the `AgentDecision_target_shape`
  /// constraint. Explicit nullable foreign keys rather than a loose (type, id) pair, so a
  /// decision cannot outlive or misname its subject: the database itself refuses a row
  /// pointing at an assessment that does not exist.
  market_assessment_id    String?
  buyer_fit_assessment_id String?

  target AgentDecisionTarget
  action AgentDecisionAction

  /// The agent's operational ordering, entirely separate from the model's rank. Null for
  /// actions where ordering is meaningless (a rejection has no priority).
  agent_priority Int?

  /// Mandatory. An override without a stated reason is unreviewable, so the column is
  /// non-null and the service rejects blank/whitespace input.
  reason String

  /// Immutable copies of what the model said AT DECISION TIME.
  ///
  /// Not derivable from a join later: assessments are recomputed as evidence and policy
  /// change, so reading the score through `market_assessment_id` tomorrow answers a
  /// different question than "what did the agent actually overrule?". Without these
  /// columns the AI-vs-human comparison in docs/30 §3c silently comers to compare an
  /// override against a score that did not exist when the override was made.
  original_score            Int?
  original_rank             Int?
  original_confidence_score Int?
  original_model_version    String?
  original_policy_hash      String?
  original_policy_version   Int?

  /// Explainable decision-time state, needed because some subjects are updated IN PLACE.
  ///
  /// A MarketAssessment is per-run, so an old one survives a recompute and the FK alone can
  /// reconstruct what was overruled. A BuyerFitAssessment is unique on
  /// (buyer, product, org) and upserted, so a recompute DESTROYS the state the agent saw —
  /// the FK then points at numbers that did not exist at decision time. These columns are the
  /// only surviving record for that case, so they are copied, never referenced.
  ///
  /// `BuyerFeatureSnapshot` is not usable as a stable reference here: it is also unique per
  /// buyer and updated in place, so it offers no immutable per-computation row to point at.
  original_components          Json?
  /// The assessment's own `input_snapshot` — small and bounded (product, hs_code, source
  /// record ids), so it is copied whole rather than hashed into something unreadable.
  original_input_snapshot      Json?
  /// SHA-256 of the copied input snapshot, for integrity and cheap equality checks.
  original_input_snapshot_hash String?
  /// When the overruled assessment was computed — distinct from when the decision was made.
  original_computed_at         DateTime?
  original_evidence_origins    EvidenceOrigin[]

  /// Optional review metadata. `expires_at` makes a decision self-limiting ("prioritise
  /// this market for one quarter"); effective state is derived from it plus supersession.
  expires_at DateTime?

  /// Backward pointer to the decision this one replaces, for the same subject. Unique:
  /// a given decision may be superseded by at most one successor, so the chain stays linear
  /// and cannot fork into two competing "current" decisions.
  supersedes_id String? @unique

  created_at DateTime @default(now())

  exporter_org         ExporterOrg         @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  actor                User                @relation("AgentDecisionActor", fields: [actor_user_id], references: [id])
  market_assessment    MarketAssessment?   @relation(fields: [market_assessment_id], references: [id], onDelete: Cascade)
  buyer_fit_assessment BuyerFitAssessment? @relation(fields: [buyer_fit_assessment_id], references: [id], onDelete: Cascade)
  supersedes           AgentDecision?      @relation("AgentDecisionSupersession", fields: [supersedes_id], references: [id])
  superseded_by        AgentDecision?      @relation("AgentDecisionSupersession")

  @@index([exporter_org_id, target, created_at])
  @@index([market_assessment_id, created_at])
  @@index([buyer_fit_assessment_id, created_at])
  @@index([actor_user_id, created_at])
}

// ---------------------------------------------------------------------------
// Staff provisioning (Phase 4)
// ---------------------------------------------------------------------------

enum StaffInvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// A bearer invitation for the Agent role.
///
/// Deliberately a separate model from `Invitation` rather than a `purpose` column on it.
/// `Invitation` is live and exporter-specific by construction: `exporter_org_id` is non-null,
/// it cascade-deletes with the org, both its indexes lead with the org, and a working member
/// invite route and UI depend on that shape. Making the column nullable would weaken a running
/// flow and create rows whose meaning depends on a NULL.
///
/// Here the ambiguity cannot arise: there is no organisation column to be wrong. A staff
/// invitation grants a staff role and never fabricates exporter membership; an exporter
/// invitation cannot be accepted as staff because it lives in a different table entirely.
///
/// UNBOUND BEARER SEMANTICS. `email` is nullable and, for every row this app creates going
/// forward, always null: possession of the raw token is the entire authorization, exactly like
/// a signed URL. There is no invited address to compare a claimant against — whoever holds the
/// link and confirms while authenticated is the accepted recipient. This is a deliberate
/// narrowing from the original design (which minted one invitation per email and matched the
/// claimant's address against it): Admin asked for a plain "generate a link" flow with no email
/// step, and a still-email-bound acceptance path alongside a now-email-less one would be two
/// different security models sharing one `accept` button, which is exactly the kind of blur
/// this change exists to remove. Legacy rows created under the old design keep a non-null
/// `email` for audit/history purposes only — that column is never read by any authorization
/// decision, on old rows or new ones (see `convertUserToAgent`).
model StaffInvitation {
  id     String                @id @default(cuid())
  /// Null on every row created after the bearer-invitation change (Admin no longer supplies
  /// one). Non-null only on legacy rows kept for audit history — never compared against a
  /// claimant's address; see the model doc above.
  email  String?
  /// Always `agent`, enforced by `StaffInvitation_role_is_agent`. Narrowed from the original
  /// broader staff-role CHECK because no code path has ever issued anything but an agent
  /// invitation — `generateAgentInvitation` cannot choose another role, and widening a bearer
  /// (no-email, no-confirmation-of-identity-in-advance) link to Ops/admin would be a materially
  /// more dangerous default than the token-and-email design it replaces.
  role   UserRole
  status StaffInvitationStatus @default(pending)
  /// Random, single-use. Never written to an audit payload.
  token  String                @unique

  invited_by_id    String
  expires_at       DateTime
  accepted_at      DateTime?
  accepted_user_id String?   @unique
  revoked_at       DateTime?
  revoked_by_id    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invited_by    User  @relation("StaffInvitationInviter", fields: [invited_by_id], references: [id])
  revoked_by    User? @relation("StaffInvitationRevoker", fields: [revoked_by_id], references: [id])
  accepted_user User? @relation("StaffInvitationAcceptor", fields: [accepted_user_id], references: [id])

  @@index([email, status])
  @@index([status, expires_at])
}

enum StaffAccessGrantStatus {
  pending
  claimed
  revoked
}

/// A pre-authorized email, entitled to become staff on first VERIFIED sign-in — with no token
/// and no link.
///
/// Deliberately a separate model from `StaffInvitation` rather than a tokenless row jammed into
/// it. `StaffInvitation`'s whole security model is "possession of the token authorizes the
/// act" — every read path matches on `hashToken(token)`, and the unique `token` column is load
/// bearing. A grant's security model is the opposite: "a verified email match at sign-in
/// authorizes the act," with no credential to possess at all. Forcing that through the same
/// table would mean a dummy token nobody is ever given, a NULLable exception carved into a
/// column everything else treats as required, and branching added to every function that walks
/// `StaffInvitation` to skip the tokenless rows. Two small, honest models are cheaper than one
/// model straddling two different security models.
///
/// Claimed automatically inside `resolveSocialIdentity()` — never by a route the browser can
/// call directly — the moment the provider confirms the signer owns this exact address.
model StaffAccessGrant {
  id     String                 @id @default(cuid())
  email  String
  /// Constrained to `agent` by a database CHECK — see `StaffAccessGrant_role_is_agent` below.
  /// Only agent provisioning is needed today; unlike StaffInvitation this is not widened to
  /// every staff role, because an unattended claim landing on ops/admin the moment somebody's
  /// Google account happens to match an email would be a far more dangerous default than
  /// requiring a human to accept a link for that.
  role   UserRole               @default(agent)
  status StaffAccessGrantStatus @default(pending)

  granted_by_id   String
  granted_at      DateTime  @default(now())
  claimed_at      DateTime?
  claimed_user_id String?   @unique
  revoked_at      DateTime?
  revoked_by_id   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  granted_by   User  @relation("StaffAccessGrantGrantor", fields: [granted_by_id], references: [id])
  revoked_by   User? @relation("StaffAccessGrantRevoker", fields: [revoked_by_id], references: [id])
  claimed_user User? @relation("StaffAccessGrantClaimant", fields: [claimed_user_id], references: [id])

  @@index([email, status])
}

// ---------------------------------------------------------------------------
// Canonical export-document data (Phase 5)
//
// One rule holds this section together: ClearTrade owns the business fact, and a
// document consumes it. Nothing below is a per-document copy of a mutable value — the
// only frozen copy in the whole design is DocumentInputSnapshot, and it exists precisely
// so that freezing happens ONCE, at issuance, instead of seven times across seven tables.
// ---------------------------------------------------------------------------

/// Which transport document a shipment's number refers to. Explicit rather than inferred
/// from which of two nullable columns is filled.
enum TransportDocumentType {
  bill_of_lading
  air_waybill
  courier_receipt
  road_consignment_note
}

/// Where an exchange rate actually came from. There is no `default` or `system` member on
/// purpose: a rate with no traceable origin must not be recordable at all, and `rbi_reference`
/// or `customs_notified` may only be claimed when the notification is cited (enforced by a
/// database CHECK on `source_reference`).
/// Immutable raw response from an authoritative public FX publisher (currently the ECB SDMX
/// data portal). Kept apart from `ExchangeRateQuote`, which is exporter-scoped and holds
/// tenant-recorded regulatory and bank rates: a published reference rate belongs to nobody, so
/// scoping it to one exporter would either duplicate it per tenant or leak it between them.
model AuthoritativeFxSnapshot {
  id                     String                       @id @default(cuid())
  provider               String
  source_authority       String
  source_dataset         String
  source_dataset_version String?
  /// The provider's own series identity, e.g. the SDMX key `EXR.D.INR.EUR.SP00.A`.
  series_key             String
  request_reference      String
  requested_at           DateTime
  retrieved_at           DateTime
  http_status            Int
  raw_response_checksum  String
  raw_response_text      String
  parser_version         String
  normalization_version  String
  environment            String
  evidence_origin        EvidenceOrigin               @default(unknown_legacy)
  completeness           EvidenceCompletenessStatus
  status                 String                       @default("accepted")
  observations           AuthoritativeFxObservation[]
  created_at             DateTime                     @default(now())

  @@index([provider, series_key, retrieved_at])
  @@index([environment, retrieved_at])
}

/// One published reference observation: a rate FOR a stated date, not for a retrieval time.
model AuthoritativeFxObservation {
  id                    String         @id @default(cuid())
  snapshot_id           String
  provider              String
  series_key            String
  /// Units of quote_currency per ONE unit of base_currency, in the publisher's own direction.
  /// ECB publishes foreign currency per euro, so base is EUR and quote is the foreign currency.
  base_currency         String         @db.VarChar(3)
  quote_currency        String         @db.VarChar(3)
  rate                  Decimal        @db.Decimal(24, 10)
  /// The date the observation IS FOR. Never the retrieval date.
  observation_date      DateTime       @db.Date
  observation_status    String
  normalization_version String
  parser_version        String
  environment           String
  evidence_origin       EvidenceOrigin @default(unknown_legacy)
  retrieved_at          DateTime
  created_at            DateTime       @default(now())

  snapshot AuthoritativeFxSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Restrict)

  /// One published value per series, date and normalization within an environment. A second
  /// retrieval of the same day reuses the row instead of creating a rival observation.
  @@unique([provider, series_key, observation_date, normalization_version, environment], map: "AuthoritativeFxObservation_identity_key")
  @@index([environment, base_currency, quote_currency, observation_date])
  @@index([snapshot_id])
}

enum ExchangeRateSource {
  rbi_reference
  customs_notified
  bank_quoted
  manual_entry
}

/// Buyer address and tax identity AS THIS EXPORTER TRANSACTS WITH THEM.
///
/// Deliberately not columns on `Buyer`: that model is global — one row is shared by every
/// exporter org that has ever discovered the same company — so an address written there
/// would hand one tenant's operationally-gathered buyer data to every other tenant. Scoping
/// it to (exporter_org, buyer) keeps it inside the tenant boundary while still letting one
/// exporter reuse the address across all their deals with that buyer.
///
/// Separate from the discovery-side identity architecture too: `RawImportIdentity` holds
/// AES-GCM encrypted names/addresses derived from licensed trade data under source-rights
/// rules. Nothing here is copied from there. These values are supplied by the exporter or
/// agent as part of the transaction, which is a different fact with a different provenance.
model BuyerCommercialProfile {
  id              String @id @default(cuid())
  exporter_org_id String
  buyer_id        String

  /// Name as it must appear on documents, when it differs from the buyer's discovered
  /// legal name (a trading division, a transliteration the buyer insists on). NULL means
  /// "use Buyer.legal_name" — never a silent copy that then drifts.
  document_name String?

  address_line1 String?
  address_line2 String?
  city          String?
  region        String?
  postal_code   String?
  /// NULL means "use Buyer.country_code". Present only when the ship-to country genuinely
  /// differs from the buyer's registered country.
  country_code  String? @db.VarChar(2)

  /// Importer tax identity. `type` is required whenever a value is present (database
  /// CHECK) — "VAT" and "EORI" are not interchangeable on a customs document.
  tax_identifier      String?
  tax_identifier_type String?

  contact_email String?
  contact_phone String?

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  updated_by_id String?

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer        Buyer       @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  updated_by   User?       @relation("BuyerProfileEditor", fields: [updated_by_id], references: [id])

  @@unique([exporter_org_id, buyer_id])
  @@index([buyer_id])
}

/// One package line on a shipment.
///
/// The canonical owner of package counts, weights and volume — there are no stored totals
/// anywhere, because a total that is stored beside its parts is a second answer to the same
/// question and the two disagree the first time one is edited alone. Totals are summed at
/// read time by `shipmentPackageTotals()`.
///
/// A line represents `package_count` IDENTICAL packages, which is what makes one model cover
/// both granularities the legacy system needed two for: "120 cartons, 1450 kg total" is one
/// row with count 120, and per-carton detail is 120 rows with count 1 each.
model ShipmentPackage {
  id          String @id @default(cuid())
  shipment_id String
  /// Stable display order. Unique per shipment so a packing list never renumbers itself.
  sequence    Int

  package_type  String
  package_count Int

  /// Per-package weights, not line totals: 12 cartons of 10 kg is count 12, net 10. The
  /// distinction is the whole reason line totals are derived rather than entered.
  net_weight_kg   Decimal? @db.Decimal(12, 3)
  gross_weight_kg Decimal? @db.Decimal(12, 3)

  length_cm  Decimal? @db.Decimal(10, 2)
  width_cm   Decimal? @db.Decimal(10, 2)
  height_cm  Decimal? @db.Decimal(10, 2)
  /// Volume per package. Nullable and never back-calculated from dimensions that are
  /// themselves missing — an unknown volume prints as unknown.
  volume_cbm Decimal? @db.Decimal(12, 4)

  contents_description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shipment Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([shipment_id, sequence])
  @@index([shipment_id])
}

/// A recorded exchange rate WITH its provenance.
///
/// Four facts travel together or the rate is meaningless: which currencies, what rate, for
/// what date, and from where. A CHECK refuses `rbi_reference` and `customs_notified` without
/// a `source_reference`, so the system cannot stamp a regulatory source onto a number that
/// somebody typed in — the failure mode the legacy service had, where hardcoded fallback
/// constants were stored under a column commented "RBI requirement".
///
/// Append-only: a wrong rate is superseded by recording a new one, never edited, because a
/// document already issued against the old rate must stay explainable.
model ExchangeRateQuote {
  id              String @id @default(cuid())
  exporter_org_id String

  base_currency  String  @db.VarChar(3)
  quote_currency String  @db.VarChar(3)
  /// Units of quote_currency per ONE unit of base_currency. 8dp because customs-notified
  /// rates for low-value currencies need more than 4.
  rate           Decimal @db.Decimal(18, 8)

  source           ExchangeRateSource
  /// The citation: an RBI notification number, a customs notification, a bank quote ref.
  /// Required for the two regulatory sources.
  source_reference String?
  /// The date the rate APPLIES to, which is what a document must state — not when it was
  /// entered, which is `created_at`.
  rate_date        DateTime

  recorded_by_id String?
  correlation_id String?
  created_at     DateTime @default(now())

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  recorded_by  User?       @relation("ExchangeRateRecorder", fields: [recorded_by_id], references: [id])

  @@index([exporter_org_id, base_currency, quote_currency, rate_date])
}

/// An exporter's invoice number series.
///
/// Holds the format and the counter only. It is not a log — every number ever handed out is
/// an `IssuedInvoiceNumber` row, so the counter can never be the sole record of what was
/// issued. `series_key` is normally the financial year ("2026-27"), which is how Indian
/// exporters actually restart numbering.
model InvoiceSeries {
  id              String @id @default(cuid())
  exporter_org_id String
  series_key      String

  prefix      String @default("")
  suffix      String @default("")
  pad_length  Int    @default(5)
  /// The next number to hand out. Advanced only by an atomic UPDATE ... RETURNING inside
  /// the issuing transaction, which is what makes concurrent issuance safe without an
  /// application-level lock.
  next_number Int    @default(1)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org ExporterOrg           @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  issued       IssuedInvoiceNumber[]

  @@unique([exporter_org_id, series_key])
}

/// One officially issued invoice number. Append-only.
///
/// Issuing is a deliberate act, never a side effect of previewing or rendering: nothing in
/// the readiness or context-building path can reach this table, so a failed render costs
/// nothing and leaves no gap. That is the one thing the legacy implementation could not
/// promise — it allocated on invoice creation, outside a transaction, with a read-then-write
/// race that two concurrent requests could both win.
///
/// A database trigger permits exactly one post-insert change: voiding. Everything else about
/// the row — the number, the sequence, who issued it, when — is frozen. A voided number is
/// never reused; the series simply moves on.
model IssuedInvoiceNumber {
  id              String @id @default(cuid())
  exporter_org_id String
  series_id       String
  deal_id         String

  sequence_number  Int
  /// The full rendered number (prefix + padded sequence + suffix). Stored rather than
  /// re-derived so that changing the series format later cannot retroactively alter what
  /// an already-issued document says.
  formatted_number String

  issued_at      DateTime @default(now())
  issued_by_id   String?
  correlation_id String?

  voided_at    DateTime?
  void_reason  String?
  voided_by_id String?

  exporter_org ExporterOrg   @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  series       InvoiceSeries @relation(fields: [series_id], references: [id], onDelete: Cascade)
  deal         Deal          @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  issued_by    User?         @relation("InvoiceNumberIssuer", fields: [issued_by_id], references: [id])
  voided_by    User?         @relation("InvoiceNumberVoider", fields: [voided_by_id], references: [id])

  @@unique([series_id, sequence_number])
  @@unique([exporter_org_id, formatted_number])
  @@index([deal_id])
}

/// The exact canonical input a document version was built from, frozen and hashed.
///
/// This is what makes an issued document reproducible while the business data underneath it
/// stays editable — the requirement that would otherwise force every document to keep its
/// own copy of every field. Correcting a buyer address after issuance changes the canonical
/// record and leaves this row untouched; the next version freezes a new one.
///
/// Append-only by trigger. `content_hash` is SHA-256 over the canonical JSON, so any
/// tampering is detectable and two identical inputs are recognisably identical.
model DocumentInputSnapshot {
  id              String  @id @default(cuid())
  exporter_org_id String
  deal_id         String
  doc_type        DocType

  /// Which builder produced `context`. A later builder that emits a different shape must
  /// bump this, so an old snapshot is never re-read under new assumptions.
  builder_version Int    @default(1)
  context         Json
  content_hash    String @db.VarChar(64)

  created_by_id  String?
  correlation_id String?
  created_at     DateTime @default(now())

  exporter_org ExporterOrg        @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  deal         Deal               @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  created_by   User?              @relation("DocumentSnapshotCreator", fields: [created_by_id], references: [id])
  document     Document?
  artifacts    DocumentArtifact[]

  @@index([deal_id, doc_type, created_at])
}

/// Output format of a rendered artifact. Not every document supports every format — see
/// `DOCUMENT_FORMAT_SUPPORT` in src/lib/document-generation/legacy/capabilities.ts.
enum DocumentFormat {
  pdf
  docx
  html
}

/// One rendered file for one document version.
///
/// A child of Document, not a parallel document system: Document still owns identity, version
/// and the four lifecycle dimensions. This row exists only because a single version can be
/// rendered to PDF and DOCX from the SAME frozen input, and `Document` has one `file_ref`.
/// Splitting them across two Document rows is impossible anyway — `@@unique([deal_id,
/// doc_type, version])` forbids it, and rightly: they are one document in two formats, not two
/// documents.
///
/// `input_snapshot_id` and `content_hash` are recorded per artifact so a stored file can be
/// traced to the exact frozen input it came from, and two artifacts of one version can be
/// shown to have been rendered from the same data rather than merely assumed to be.
model DocumentArtifact {
  id          String         @id @default(cuid())
  document_id String
  format      DocumentFormat

  /// Storage object key, resolved through `src/lib/document-storage.ts`. Never a public URL.
  file_ref        String
  file_name       String
  mime_type       String
  file_size_bytes Int
  /// SHA-256 of the rendered bytes.
  checksum        String @db.VarChar(64)

  /// Which engine produced this, and at what version. A renderer change that alters output
  /// must bump its version, so an artifact can never be silently attributed to a renderer
  /// that would produce something different today.
  engine_name    String
  engine_version String

  /// The frozen input this was rendered from, and its hash. Both denormalised from the
  /// snapshot deliberately: the artifact must remain traceable even if the Document row's
  /// pointer is later moved to a newer snapshot.
  input_snapshot_id String
  content_hash      String @db.VarChar(64)

  generated_at    DateTime @default(now())
  generated_by_id String?

  document       Document              @relation(fields: [document_id], references: [id], onDelete: Cascade)
  input_snapshot DocumentInputSnapshot @relation(fields: [input_snapshot_id], references: [id])
  generated_by   User?                 @relation("DocumentArtifactGenerator", fields: [generated_by_id], references: [id])

  @@unique([document_id, format])
  @@index([input_snapshot_id])
}

/// Lifecycle of an exporter's request for a global market scan.
///
/// A scan acquires one authoritative observation per reporting market — roughly 218 metered
/// provider calls against a platform-wide quota. Phase 1F made execution staff-initiated for
/// exactly that reason, so the exporter's action is a REQUEST and the metered work stays behind
/// a human approval. `queued` and `running` mirror the screening job rather than duplicating it.
enum MarketScanRequestStatus {
  pending
  approved
  queued
  running
  completed
  rejected
  failed
}

/// One exporter request for a global market scan, and its approval trail.
///
/// The request carries a product and a classification identity and NOTHING about which markets
/// to look at, which provider mode to use, or what policy to screen under: those are all derived
/// server-side at approval time from the canonical services. There is deliberately no column
/// here through which a client could influence the metered work.
model MarketScanRequest {
  id                        String                  @id @default(cuid())
  exporter_org_id           String
  product_id                String
  /// The classification the request was raised against. Approval re-reads the product's current
  /// confirmed classification and refuses if it has moved, so a stale identity is never screened.
  product_classification_id String
  /// Denormalised classification identity, frozen at request time, for the same staleness check.
  hs6_code                  String
  hs_revision               String

  status           MarketScanRequestStatus @default(pending)
  requested_by_id  String
  requested_at     DateTime                @default(now())
  decided_by_id    String?
  decided_at       DateTime?
  /// Required when `status` is `rejected`; the exporter is shown this verbatim.
  rejection_reason String?

  /// Set once approval hands off to the canonical screening service.
  screening_job_id String?
  screening_run_id String?
  /// Why the request reached a terminal state without spending provider budget — for example
  /// because a current completed screen already covered this exact classification and policy.
  resolution_note  String?

  correlation_id String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  exporter_org           ExporterOrg           @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  product                Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_classification ProductClassification @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  requested_by           User                  @relation("MarketScanRequester", fields: [requested_by_id], references: [id])
  decided_by             User?                 @relation("MarketScanDecider", fields: [decided_by_id], references: [id])

  @@index([exporter_org_id, status, requested_at])
  @@index([status, requested_at])
  @@index([product_classification_id, status])
}

/// Lifecycle shared by every retained official bulk/file authority release. The database enum
/// keeps its historical TARIC name through @map so applied migrations and old rows are untouched.
enum AuthorityReleaseStatus {
  /// Uploaded and validated, but not yet the release evidence is read from.
  imported
  /// The release new ingests resolve against.
  active
  /// Superseded by a newer release. Retained: assessments cite the release they used.
  superseded
  /// Validation failed; the artifact is kept so the failure is inspectable.
  rejected

  @@map("TaricReleaseStatus")
}

enum AuthorityReleaseChange {
  NEW_RELEASE
  CHANGED

  @@map("AuthorityReleaseChange")
}

/// One immutable raw release from a customs/tariff authority. This is the safely-generalised
/// former TaricRelease model: it remains mapped to the same physical table, preserving every
/// historical TARIC row while allowing Canada and future bulk packs to share one lifecycle.
model AuthorityRelease {
  id String @id @default(cuid())

  /// Operator-facing label, e.g. "TARIC 2026-09" or "CBSA T2026-2".
  label String
  source_family String
  authority String @map("source_authority")
  /// Exact destinations the release is authoritative for; never inferred from a customs union.
  destination_scope Json
  source_url String
  release_identifier String
  reference_date DateTime
  source_distribution String
  retrieved_at DateTime
  source_format String

  /// SHA-256 of the retained source bundle. It is deliberately not globally unique: identical
  /// bytes may be published under different release identities or source contexts.
  checksum String @map("bundle_sha256")
  size_bytes Int @map("bundle_size_bytes")
  /// Where the original artifact is retained, through the existing secure storage layer.
  artifact_object_key String
  /// Per-file name/sha256/size, so a single altered table is detectable after the fact.
  file_manifest    Json

  reader_version String
  parser_version String
  status         AuthorityReleaseStatus @default(imported)
  /// Validation detail, including the failure reason when `status` is `rejected`.
  validation     Json
  change_classification AuthorityReleaseChange
  change_basis Json
  previous_release_id String?

  imported_by_id String
  imported_at    DateTime @default(now())
  activated_at   DateTime?
  superseded_at  DateTime?
  correlation_id String?

  imported_by User @relation("AuthorityReleaseImporter", fields: [imported_by_id], references: [id])
  previous_release AuthorityRelease? @relation("AuthorityReleaseHistory", fields: [previous_release_id], references: [id], onDelete: Restrict)
  later_releases AuthorityRelease[] @relation("AuthorityReleaseHistory")
  evidence_snapshots MarketAccessEvidenceSnapshot[]

  @@unique([source_family, authority, release_identifier, checksum], map: "AuthorityRelease_logical_acquisition_key")
  @@index([source_family, authority, status, reference_date], map: "AuthorityRelease_source_status_reference_idx")
  @@index([previous_release_id], map: "AuthorityRelease_previous_release_id_idx")
  @@map("TaricRelease")
}
