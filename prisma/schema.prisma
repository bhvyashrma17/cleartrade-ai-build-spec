// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model ExporterOrg {
  id           String    @id @default(cuid())
  legal_name   String?
  display_name String
  gstin        String?
  /// Status-aware field, not a bare string (docs/02 + glossary).
  iec          IecStatus @default(unknown)
  iec_number   String?
  country      String    @default("IN")
  state        String?
  city         String?

  /// Structured postal address. Official documents print a block, not a paragraph, and
  /// a single free-text column cannot be validated, corrected field-by-field, or mapped
  /// onto a renderer's address lines. `city`/`state`/`country` above already existed and
  /// are NOT duplicated here.
  address_line1 String?
  address_line2 String?
  postal_code   String?

  /// Authorised Dealer code issued by the exporter's bank. Consumed by the commercial
  /// invoice, packing list and shipping bill renderers, and the single hardest blocker
  /// on a shipping bill. Free-text because the format is bank-assigned, not a checksum
  /// we can verify — it is recorded, never inferred.
  ad_code String?

  pickup_location_code     String?
  preferred_origin_gateway String?
  assigned_agent_id        String?
  readiness_status         ReadinessStatus @default(not_started)
  journey_stage            JourneyStage    @default(onboarding)

  /// Defaults to `guest` because the overwhelmingly common new row is a guest minted on
  /// first search. Pre-existing rows are backfilled to `paid` by the migration — they
  /// were created under the old all-access assumption.
  tier             OrgTier   @default(guest)
  /// Set when guest -> free (registration). Funnel analysis; null while still a guest.
  upgraded_at      DateTime?
  /// Only ever set while tier = guest. Drives the purge job for abandoned guest orgs;
  /// without it this table grows monotonically with anonymous traffic.
  guest_expires_at DateTime?

  /// The commitment fee (docs/01 §2) is what a free-tier org must pay to unlock `paid`
  /// tier — full Demand Discovery, buyer contacts' agent workflow, and everything else
  /// gated at `paid` in CAPABILITY_MIN_TIER. This is not a new membership concept: it is
  /// the SAME commitment fee docs/01 always specified, now doing double duty as the
  /// tier-3 gate rather than sitting unused. `not_due` while tier=guest; set to `due` the
  /// moment registration completes (tier flips to `free`) — never left implicit, since
  /// `due` vs `not_due` is what the billing CTA renders on.
  commitment_fee_status         CommitmentFeeStatus @default(not_due)
  /// Snapshot of the active FeePolicy's commitment fee amount/currency/version AT THE
  /// MOMENT it became due — never re-read live. Same "rule of record" docs/01 applies to
  /// deal-quoted terms: a later FeePolicy version must never retroactively change what an
  /// org already owes or already paid.
  commitment_fee_amount         Decimal?            @db.Decimal(18, 4)
  commitment_fee_currency       String?             @db.VarChar(3)
  commitment_fee_policy_version Int?
  /// Provenance of the "paid" transition — same PaymentSource vocabulary as Payment.source,
  /// since this is the identical kind of fact (self-reported vs bank-confirmed) applied to
  /// a different money event. Reusing the enum means one place ever defines what "source"
  /// can mean, rather than two enums drifting apart.
  commitment_fee_source         PaymentSource?
  commitment_fee_due_at         DateTime?
  commitment_fee_paid_at        DateTime?

  /// The entitlement clock for a RECURRING membership, denormalised onto the org.
  ///
  /// `tier` stays the single axis every permission check reads (docs/14 §2) — this column
  /// is what decides when `tier` should be moved back down. It is deliberately NOT derived
  /// live from `Subscription.status` at read time: a lapsed subscription must revoke access
  /// even if the provider never sends the webhook that would tell us, and a status read
  /// alone cannot express "active, but only until the 14th". `applyProviderState()` and
  /// `expireLapsedMemberships()` in `src/lib/billing/subscription-service.ts` are the only
  /// writers.
  ///
  /// Null means "no time-bounded membership": either never subscribed, or holding `paid`
  /// via the one-time commitment fee / an Ops waiver, both of which do not expire.
  paid_until    DateTime?
  /// Set when a paid tenant is dropped back to `free` because `paid_until` lapsed. Kept so
  /// a win-back surface can tell "never paid" from "lapsed", which the tier alone cannot.
  downgraded_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  assigned_agent               User?                             @relation("OrgAssignedAgent", fields: [assigned_agent_id], references: [id])
  users                        User[]                            @relation("OrgMembers")
  products                     Product[]
  readiness_assessments        ReadinessAssessment[]
  discovery_runs               DiscoveryRun[]
  buyer_leads                  BuyerLead[]
  buyer_fit_assessments        BuyerFitAssessment[]
  buyer_outcomes               BuyerOutcome[]
  buyer_shortlists             BuyerShortlist[]
  deals                        Deal[]
  tasks                        Task[]
  assignments                  AgentAssignment[]
  invitations                  Invitation[]
  agent_decisions              AgentDecision[]
  buyer_profiles               BuyerCommercialProfile[]
  invoice_series               InvoiceSeries[]
  issued_invoice_numbers       IssuedInvoiceNumber[]
  exchange_rate_quotes         ExchangeRateQuote[]
  country_truth_fact_snapshots CountryTruthFactSnapshot[]
  document_input_snapshots     DocumentInputSnapshot[]
  bank_accounts                ExporterBankAccount[]
  subscriptions                Subscription[]
  classification_refinements   ProductClassificationRefinement[]
  market_scan_requests         MarketScanRequest[]
  operational_cost_evidence    OperationalCostEvidence[]
  logistics_route_evidence     LogisticsRouteEvidence[]

  @@index([assigned_agent_id])
  @@index([readiness_status])
  @@index([tier])
  @@index([tier, guest_expires_at])
  /// Drives the lapse sweep: "paid orgs whose clock has run out", the only query
  /// `expireLapsedSubscriptions()` runs.
  @@index([tier, paid_until])
}

model User {
  id              String   @id @default(cuid())
  /// Guests get a synthetic address on the RFC 2606 reserved `.invalid` TLD, which can
  /// never resolve or collide with a real one. Keeps this column non-null and UNIQUE so
  /// nothing downstream has to handle a null identity.
  email           String   @unique
  phone           String?
  name            String
  /// Null means "this account cannot log in" — the state a guest is in until it upgrades.
  /// authorize() MUST reject a null hash before reaching bcrypt.compare, which throws on
  /// null rather than returning false.
  password_hash   String?
  role            UserRole
  /// Null for agent / ops / admin principals. Non-null pins an exporter to one tenant.
  exporter_org_id String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  exporter_org                       ExporterOrg?                      @relation("OrgMembers", fields: [exporter_org_id], references: [id])
  agent_for_orgs                     ExporterOrg[]                     @relation("OrgAssignedAgent")
  agent_assignments                  AgentAssignment[]                 @relation("AssignmentAgent")
  assignments_made                   AgentAssignment[]                 @relation("AssignmentActor")
  owned_leads                        BuyerLead[]                       @relation("LeadAgent")
  created_leads                      BuyerLead[]                       @relation("LeadCreatedBy")
  owned_deals                        Deal[]                            @relation("DealOwnerAgent")
  owned_tasks                        Task[]                            @relation("TaskOwner")
  proposals_made                     DealProposal[]                    @relation("ProposalProposedBy")
  proposals_approved                 DealProposal[]                    @relation("ProposalApprovedBy")
  proposals_changes_requested        DealProposal[]                    @relation("ProposalChangesRequestedBy")
  outreach_activities                OutreachActivity[]
  outreach_attempts                  OutreachAttempt[]
  buyer_lead_transitions             BuyerLeadTransition[]
  raw_data_access_events             RawDataAccessEvent[]
  data_deletion_reviews              DataDeletionRequest[]
  audit_events                       AuditEvent[]
  notifications                      Notification[]
  notification_preferences           NotificationPreference[]
  messages_sent                      Message[]
  internal_notes                     InternalNote[]
  documents_approved                 Document[]                        @relation("DocumentApprover")
  documents_reviewed                 Document[]                        @relation("DocumentReviewer")
  documents_filed                    Document[]                        @relation("DocumentFiler")
  partner_handoffs                   PartnerHandoff[]                  @relation("PartnerHandoffOwner")
  disputes_owned                     Dispute[]
  jobs_requested                     Job[]
  invitations_sent                   Invitation[]                      @relation("InvitationInviter")
  task_evidence_uploaded             TaskEvidence[]                    @relation("TaskEvidenceUploader")
  task_evidence_reviewed             TaskEvidence[]                    @relation("TaskEvidenceReviewer")
  payouts                            Payout[]                          @relation("PayoutAgent")
  payouts_approved                   Payout[]                          @relation("PayoutApprovedBy")
  payout_adjustments_made            PayoutAdjustment[]                @relation("PayoutAdjustmentAuthor")
  sanctions_review_decisions         SanctionsReviewDecision[]
  classifications_proposed           ProductClassification[]           @relation("ClassificationProposer")
  classifications_confirmed          ProductClassification[]           @relation("ClassificationConfirmer")
  products_hs_confirmed              Product[]
  auth_provider_accounts             AuthProviderAccount[]
  agent_decisions                    AgentDecision[]                   @relation("AgentDecisionActor")
  staff_invitations_sent             StaffInvitation[]                 @relation("StaffInvitationInviter")
  staff_invitations_revoked          StaffInvitation[]                 @relation("StaffInvitationRevoker")
  staff_invitation_accepted          StaffInvitation?                  @relation("StaffInvitationAcceptor")
  staff_access_grants_made           StaffAccessGrant[]                @relation("StaffAccessGrantGrantor")
  staff_access_grants_revoked        StaffAccessGrant[]                @relation("StaffAccessGrantRevoker")
  staff_access_grant_claimed         StaffAccessGrant?                 @relation("StaffAccessGrantClaimant")
  buyer_profiles_edited              BuyerCommercialProfile[]          @relation("BuyerProfileEditor")
  exchange_rates_recorded            ExchangeRateQuote[]               @relation("ExchangeRateRecorder")
  invoice_numbers_issued             IssuedInvoiceNumber[]             @relation("InvoiceNumberIssuer")
  invoice_numbers_voided             IssuedInvoiceNumber[]             @relation("InvoiceNumberVoider")
  document_snapshots_created         DocumentInputSnapshot[]           @relation("DocumentSnapshotCreator")
  document_artifacts_created         DocumentArtifact[]                @relation("DocumentArtifactGenerator")
  bug_reports                        BugReport[]
  verified_product_certifications    ProductCertification[]            @relation("ProductCertificationVerifier")
  decided_classification_refinements ProductClassificationRefinement[] @relation("ClassificationRefinementDecider")
  entered_operational_costs          OperationalCostEvidence[]         @relation("OperationalCostEnteredBy")
  verified_operational_costs         OperationalCostEvidence[]         @relation("OperationalCostVerifiedBy")
  recorded_customs_valuations        CustomsValuationBasisEvidence[]   @relation("CustomsValuationRecorder")

  market_scan_requests_made      MarketScanRequest[]               @relation("MarketScanRequester")
  market_scan_requests_decided   MarketScanRequest[]               @relation("MarketScanDecider")

  authority_releases_imported    AuthorityRelease[]                @relation("AuthorityReleaseImporter")

  @@index([exporter_org_id])
  @@index([role])
}

/// Authenticated product feedback. Contains only user-entered report text and a small,
/// server-generated diagnostic envelope; no cookies, tokens, browser storage or auth data.
model BugReport {
  id               String   @id @default(cuid())
  reporter_user_id String
  reporter_role    UserRole
  subject          String   @db.VarChar(160)
  what_happened    String   @db.Text
  expected         String   @db.Text
  page_url         String?  @db.VarChar(2048)
  app_environment  String   @db.VarChar(32)
  correlation_id   String   @unique
  created_at       DateTime @default(now())

  reporter User @relation(fields: [reporter_user_id], references: [id], onDelete: Restrict)

  @@index([reporter_user_id, created_at])
  @@index([created_at])
}

/// External identity linkage for social authentication.
///
/// ClearTrade never links by email alone. A social sign-in only maps to a local user through
/// this durable provider-account binding (`provider` + `provider_account_id`).
model AuthProviderAccount {
  id                  String   @id @default(cuid())
  user_id             String
  provider            String   @db.VarChar(40)
  provider_account_id String   @db.VarChar(191)
  provider_email      String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@unique([user_id, provider])
  @@index([user_id])
}

/// Assignment history is retained — reassignment ends the current row, never edits it.
model AgentAssignment {
  id              String           @id @default(cuid())
  exporter_org_id String
  agent_user_id   String
  assigned_by_id  String?
  status          AssignmentStatus @default(active)
  started_at      DateTime         @default(now())
  ended_at        DateTime?
  reason          String?

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  agent        User        @relation("AssignmentAgent", fields: [agent_user_id], references: [id])
  assigned_by  User?       @relation("AssignmentActor", fields: [assigned_by_id], references: [id])

  @@index([exporter_org_id, status])
  @@index([agent_user_id, status])
}

// ---------------------------------------------------------------------------
// Exporter master data
// ---------------------------------------------------------------------------

model Product {
  id                           String                       @id @default(cuid())
  exporter_org_id              String
  name                         String
  description                  String?
  hs_code                      String?
  /// Provenance of the HS code: ai_suggested | user_confirmed | unknown.
  hs_code_source               String                       @default("unknown")
  itc_hs_code                  String?
  hs_nomenclature              String?
  hs_nomenclature_version      String?
  hs_classification_method     ProductClassificationMethod?
  hs_classification_status     ProductClassificationStatus?
  hs_classification_confidence Decimal?                     @db.Decimal(5, 4)
  hs_classification_evidence   Json?
  hs_confirmed_by_id           String?
  hs_confirmed_at              DateTime?
  hs_classification_revision   Int                          @default(0)
  evidence_origin              EvidenceOrigin               @default(unknown_legacy)

  // capacity = number + unit; never a bare number
  capacity_value Decimal? @db.Decimal(18, 4)
  capacity_unit  String?

  // moq = number + unit
  moq_value Decimal? @db.Decimal(18, 4)
  moq_unit  String?

  // price_target is a per-quantity price. A currency without its quantity and
  // delivery basis is not comparable to customs unit values, so all four fields
  // are nullable but must be present before Export Economics can use the price.
  price_target_amount        Decimal? @db.Decimal(18, 4)
  price_target_currency      String?  @db.VarChar(3)
  price_target_quantity_unit String?
  price_target_incoterm      String?  @db.VarChar(3)

  /// The product's normal commercial quantity identity. This is a label, never permission to
  /// convert a mass into a count, area, volume, package or any other dimension.
  commercial_quantity_unit String?
  piece_unit_name          String?

  /// Exporter-market-fit inputs. All nullable: absence lowers score confidence; it is
  /// never replaced by a guessed/default commercial capability.
  lead_time_days                  Int?
  /// Exporter's end-to-end customer delivery commitment. Kept separate from
  /// production lead_time_days so the scorer can derive a transit allowance.
  delivery_commitment_days        Int?
  logistics_constraint_codes      String[] @default([])
  logistics_constraints_confirmed Boolean  @default(false)
  desired_order_size_amount       Decimal? @db.Decimal(18, 4)
  desired_order_size_currency     String?  @db.VarChar(3)
  desired_order_quantity_value    Decimal? @db.Decimal(18, 4)
  desired_order_quantity_unit     String?
  customization_capability        String?
  packaging_capability            String?
  customization_available         Boolean?
  private_label_available         Boolean?
  packaging_customization_available Boolean?

  packaging String?

  /// Structured packaging. `packaging`/`packaging_capability` above remain free prose for the
  /// exporter's own description; only these typed fields may be reasoned about, so a sentence
  /// can never be mistaken for a declared capability.
  packaging_format        String?
  pack_size_value         Decimal? @db.Decimal(18, 4)
  pack_size_unit          String?
  units_per_package       Int?
  package_weight_value    Decimal? @db.Decimal(18, 4)
  package_weight_unit     String?
  package_volume_value    Decimal? @db.Decimal(18, 4)
  package_volume_unit     String?
  /// Consumer packs inside one carton/master pack.
  units_per_carton        Int?
  cartons_per_pallet      Int?
  palletized              Boolean?
  carton_configuration    String?
  pallet_configuration    String?
  /// Container/load types this pack is compatible with, e.g. 20FT_DRY, 40FT_HC, REEFER_40FT.
  container_compatibility String[] @default([])
  /// Ocean is not the default. Air, road, rail, courier and multimodal compatibility can be
  /// declared independently and remain unknown when this list is empty.
  transport_mode_compatibility String[] @default([])
  special_handling_codes  String[] @default([])
  /// Required storage/transport temperature band, when the product needs one at all.
  temperature_min_celsius Decimal? @db.Decimal(6, 2)
  temperature_max_celsius Decimal? @db.Decimal(6, 2)
  /// Null = unknown. False = exporter explicitly declared no temperature control is required.
  temperature_controlled  Boolean?
  fragile                 Boolean?
  perishable              Boolean?
  hazardous               Boolean?
  dangerous_goods_un_number String?
  dangerous_goods_hazard_class String?

  /// Per commercial unit physical facts. Every number keeps its own dimension; no field here
  /// is derived from another and no cross-dimensional conversion is allowed.
  unit_net_weight_value   Decimal? @db.Decimal(18, 4)
  unit_net_weight_unit    String?
  unit_gross_weight_value Decimal? @db.Decimal(18, 4)
  unit_gross_weight_unit  String?
  unit_length_value       Decimal? @db.Decimal(18, 4)
  unit_width_value        Decimal? @db.Decimal(18, 4)
  unit_height_value       Decimal? @db.Decimal(18, 4)
  unit_dimension_unit     String?
  unit_volume_value       Decimal? @db.Decimal(18, 4)
  unit_volume_unit        String?

  /// Capacity actually free for new orders, as distinct from installed monthly capacity.
  available_capacity_value Decimal? @db.Decimal(18, 4)
  available_capacity_unit  String?
  capacity_period          String?

  /// The exporter's standard export shipment. Declared rather than inferred, because it is what
  /// converts a per-shipment or per-container quote into a per-unit cost: guessing it would put
  /// a plausible but wrong number into a landed cost. MOQ is a commercial minimum and is NOT a
  /// substitute for it.
  shipment_quantity_value  Decimal? @db.Decimal(18, 4)
  shipment_quantity_unit   String?
  shipment_container_count Int?
  shipment_container_type  String?

  /// Dispatch/manufacturing origin for this product. Falls back to the org address only when
  /// explicitly absent; it is never silently assumed to equal the registered office.
  origin_city          String?
  origin_state         String?
  origin_country       String? @db.VarChar(2)
  origin_postal_code   String?
  origin_location_code String?
  origin_gateway_code  String?
  /// exporter_declared | agent_verified | system_derived. A suggested gateway is not verified.
  origin_provenance    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org                 ExporterOrg                       @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  classification_refinements   ProductClassificationRefinement[]
  operational_cost_evidence    OperationalCostEvidence[]
  certifications               ProductCertification[]
  market_assessments           MarketAssessment[]
  buyer_leads                  BuyerLead[]
  buyer_fit_assessments        BuyerFitAssessment[]
  deals                        Deal[]
  classification_history       ProductClassification[]
  country_truth_fact_snapshots CountryTruthFactSnapshot[]
  hs_confirmed_by              User?                             @relation(fields: [hs_confirmed_by_id], references: [id], onDelete: SetNull)

  market_scan_requests         MarketScanRequest[]

  @@index([exporter_org_id])
  @@index([hs_code])
}

model ProductClassification {
  id                           String                            @id @default(cuid())
  product_id                   String
  revision                     Int
  itc_hs_code                  String?
  hs6_code                     String
  nomenclature                 String
  nomenclature_version         String
  method                       ProductClassificationMethod
  /// Canonical product facts frozen by the server when this classification is proposed.
  /// Later product edits must not rewrite the basis on which the code was reviewed.
  product_facts_snapshot       Json
  evidence                     Json
  rationale                    String
  /// Structured public/source references supporting the human classification decision.
  source_references            Json
  confidence                   Decimal                           @db.Decimal(5, 4)
  status                       ProductClassificationStatus
  proposed_by_id               String
  proposed_at                  DateTime                          @default(now())
  confirmed_by_id              String?
  confirmed_at                 DateTime?
  superseded_at                DateTime?
  product                      Product                           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  proposed_by                  User                              @relation("ClassificationProposer", fields: [proposed_by_id], references: [id], onDelete: Restrict)
  confirmed_by                 User?                             @relation("ClassificationConfirmer", fields: [confirmed_by_id], references: [id], onDelete: SetNull)
  country_evidence_plans       CountryEvidencePlan[]
  country_screening_runs       CountryScreeningRun[]
  country_trade_metrics        CountryTradeMetrics[]
  country_truth_fact_snapshots CountryTruthFactSnapshot[]
  classification_refinements   ProductClassificationRefinement[]

  market_scan_requests   MarketScanRequest[]

  @@unique([product_id, revision])
  @@index([product_id, status])
}

model ProductCertification {
  id           String              @id @default(cuid())
  product_id   String
  code         String
  name         String
  status       CertificationStatus @default(not_started)
  evidence_ref String?
  valid_until  DateTime?

  /// Who issued it, and the certificate's own reference. Both recorded, never inferred.
  issuer                String?
  certificate_reference String?
  issue_date            DateTime?
  valid_from            DateTime?
  /// unverified | agent_verified. An exporter can never move its own row to agent_verified;
  /// only an assigned agent's review does, and it records who and when.
  verification_state    String    @default("unverified")
  verified_by_id        String?
  verified_at           DateTime?
  /// Null = unknown (the default and the safe reading). True = the exporter has explicitly
  /// declared it does NOT hold this certification, which is a fact and not the same as silence.
  declared_absent       Boolean?
  /// unknown | declared_held | declared_absent. Separate from lifecycle and verification.
  declaration_state     String    @default("unknown")
  /// Supporting document, when one has been uploaded.
  document_id           String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product     Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  verified_by User?   @relation("ProductCertificationVerifier", fields: [verified_by_id], references: [id], onDelete: SetNull)

  @@unique([product_id, code])
  @@index([product_id, verification_state])
}

/// Fields derived from EXP-02/EXP-03 (the PRD gives no field dictionary — see docs/02 note).
model ReadinessAssessment {
  id              String          @id @default(cuid())
  exporter_org_id String
  score           Int?
  status          ReadinessStatus @default(in_progress)
  /// Section-keyed questionnaire answers.
  answers         Json            @default("{}")
  /// [{ code, severity, summary, remediation_task_id }]
  blockers        Json            @default("[]")
  /// [{ code, title, rationale }]
  recommendations Json            @default("[]")
  is_current      Boolean         @default(true)
  submitted_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)

  @@index([exporter_org_id, is_current])
}

// ---------------------------------------------------------------------------
// Demand discovery
// ---------------------------------------------------------------------------

/// The UI contract is a DiscoveryRun resource plus ranked MarketAssessment records —
/// no AI provider or algorithm is bound into the schema (docs/02 implementation note).
model DiscoveryRun {
  id              String    @id @default(cuid())
  exporter_org_id String
  /// Null for a guest run: guests supply product context ad hoc and no Product row is
  /// created for them (that only happens if they choose to save it at registration).
  product_id      String?
  job_id          String?
  requested_by_id String?
  status          JobStatus @default(queued)
  filters         Json      @default("{}")

  /// Immutable snapshot of the inputs this run was executed with (docs/04 EXP-04-AC01).
  /// For a guest this is the whole product context — description + HS code — and is the
  /// only record of what was searched, since there is no Product to point at. It is also
  /// what the registration flow offers to turn into a real Product.
  input_snapshot Json?

  /// Frozen scoring clock and policy. Rows predating this repair remain explicitly
  /// legacy/non-recomputable rather than being assigned today's policy retroactively.
  as_of_date              DateTime?
  scoring_policy_version  Int?
  scoring_policy_hash     String?
  scoring_policy_snapshot Json?
  reproducibility_status  String    @default("legacy_non_recomputable")

  started_at   DateTime?
  completed_at DateTime?
  created_at   DateTime  @default(now())

  exporter_org       ExporterOrg        @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  market_assessments MarketAssessment[]

  @@index([exporter_org_id, created_at])
}

model MarketAssessment {
  id           String  @id @default(cuid())
  run_id       String
  /// Null when the parent run was ad hoc (guest tier). The product context for those
  /// lives in DiscoveryRun.input_snapshot instead of in a Product row.
  product_id   String?
  country_code String  @db.VarChar(2)

  overall_score                      Int?
  demand_score                       Int?
  growth_score                       Int?
  competition_score                  Int?
  market_access_score                Int?
  export_economics_score             Int?
  exporter_market_fit_score          Int?
  logistics_feasibility_score        Int?
  risk_resilience_score              Int?
  confidence_score                   Int
  eligibility_status                 MarketEligibilityStatus @default(eligible)
  eligibility_reasons                Json                    @default("[]")
  model_version                      String
  weight_profile_key                 String
  weight_profile_version             Int
  as_of_date                         DateTime?
  scoring_policy_version             Int?
  scoring_policy_hash                String?
  scoring_policy_snapshot            Json?
  reproducibility_status             String                  @default("legacy_non_recomputable")
  evidence_origins                   EvidenceOrigin[]        @default([unknown_legacy])
  india_share                        Decimal?                @db.Decimal(6, 3)
  classification_id                  String?
  classification_hs6_code            String?
  classification_itc_hs_code         String?
  classification_nomenclature        String?
  classification_version             String?
  classification_current             Boolean                 @default(true)
  classification_invalidated_at      DateTime?
  classification_invalidation_reason String?

  tariff_summary             Json?
  certification_requirements Json  @default("[]")
  logistics_summary          Json?

  // price_band = money range; currency explicit
  price_band_min      Decimal? @db.Decimal(18, 4)
  price_band_max      Decimal? @db.Decimal(18, 4)
  price_band_currency String?  @db.VarChar(3)

  rationale        String?
  /// docs/13 B2: exporter-visible agent annotation on AI output.
  agent_note       String?
  /// Per-field source and retrieval date, keyed by field name (docs/04 EXP-04-AC03:
  /// "Scores include clear labels and freshness/source metadata where available").
  ///
  /// Two shapes per entry: `{source, retrieved_at, basis, row_count}` for a field computed
  /// from warehouse rows, or `{status: 'unavailable', reason}` for one we hold no data for.
  /// The second shape is the load-bearing one — EXP-04-AC02 forbids fabricating a missing
  /// value, so a gap has to be representable as a gap rather than collapsing to null and
  /// being indistinguishable from a genuine zero.
  ///
  /// Nullable because assessments written by the placeholder engine predate it; a null here
  /// means "this row carries no provenance", not "this row has no sources".
  field_provenance Json?
  generated_at     DateTime @default(now())

  /// "Selected as active target" (docs/04 EXP-04) — the ORG's current focus market.
  /// Exclusive across the whole org, not just this run: selecting a new one clears any
  /// previously selected assessment, even from a different run. Enforced in the select
  /// route's transaction, not by a DB constraint, because "at most one selected per org"
  /// spans rows this table alone can't express a uniqueness constraint over.
  is_selected Boolean   @default(false)
  /// "Saved for later" (docs/04 EXP-04) — a lightweight bookmark, independent of
  /// selection. Non-exclusive: any number of assessments may be saved at once.
  saved_at    DateTime?

  run                         DiscoveryRun              @relation(fields: [run_id], references: [id], onDelete: Cascade)
  product                     Product?                  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  agent_decisions             AgentDecision[]
  country_trade_metrics       CountryTradeMetrics?      @relation(fields: [country_trade_metrics_id], references: [id], onDelete: Restrict)
  country_truth_fact_snapshot CountryTruthFactSnapshot? @relation(fields: [country_truth_fact_snapshot_id], references: [id], onDelete: Restrict)

  country_trade_metrics_id             String?
  country_trade_metrics_checksum       String?
  country_evidence_manifest_id         String?
  country_evidence_manifest_checksum   String?
  country_metric_policy_version        String?
  country_metric_policy_hash           String?
  country_truth_period_set             Int[]
  country_truth_as_of_date             DateTime?
  country_truth_assessment_state       String?
  assessment_checksum                  String?
  /// Stable record identity (run + country + every frozen-input identity). The content
  /// checksum may legitimately repeat across two runs; this record identity may not.
  assessment_identity                  String?   @unique(map: "MarketAssessment_assessment_identity_key")
  /// Phase 1H facts are immutable records separate from the scores derived from them.
  country_truth_fact_snapshot_id       String?
  country_truth_fact_snapshot_checksum String?

  @@index([run_id, overall_score])
  @@index([product_id, country_code])
  @@index([country_trade_metrics_id])
  @@index([country_truth_fact_snapshot_id])
}

/// Explicit destination/HS hard gates. Sanctions entity-list rows never become a country
/// restriction unless the source explicitly states destination-wide scope.
model MarketEligibilityRule {
  id                       String                    @id @default(cuid())
  country_code             String                    @db.VarChar(2)
  hs_code_prefix           String?
  rule_type                MarketEligibilityRuleType
  required_certification   String?
  certification_obtainable Boolean?
  source                   String
  source_ref               String?
  effective_from           DateTime?
  effective_to             DateTime?
  is_active                Boolean                   @default(true)
  raw_snapshot             Json?
  created_at               DateTime                  @default(now())
  updated_at               DateTime                  @updatedAt

  @@index([country_code, is_active])
  @@index([hs_code_prefix])
}

/// One authoritative retrieval for a jurisdiction + HS scope. A COMPLETE snapshot is
/// required before absence of a restriction can be interpreted as evidence.
model MarketAccessEvidenceSnapshot {
  id                        String                     @id @default(cuid())
  jurisdiction              String
  country_code              String                     @db.VarChar(2)
  hs_code_scope             String
  source_authority          String
  source_reference          String
  source_version            String?
  retrieved_at              DateTime
  effective_at              DateTime?
  expires_at                DateTime?
  completeness_status       EvidenceCompletenessStatus
  tariff_coverage           Boolean                    @default(false)
  regulatory_coverage       Boolean                    @default(false)
  parser_version            String
  evidence_origin           EvidenceOrigin             @default(unknown_legacy)
  provider                  String                     @default("unknown_legacy")
  source_dataset            String?
  source_run_id             String?
  /// Stable identity of one logical authority/release/request/parser result. Null on historical
  /// rows. A repeat acquisition reuses the existing immutable snapshot; a changed release or a
  /// newer parser version produces a distinct identity and therefore a new snapshot.
  ingest_identity           String?                    @unique
  /// Generic retained authority release that supplied the raw bytes, when this was a bulk/file
  /// source. Lookup/API providers legitimately leave this null.
  authority_release_id      String?
  raw_response_checksum     String?
  raw_evidence              Json
  /// The HS6 the snapshot was requested FOR, kept apart from `hs_code_scope`, which may be a
  /// national line. Null on rows written before national-code refinement existed.
  hs6_code                  String?
  /// Which national nomenclature the child lines belong to: UK_COMMODITY, EU_TARIC, US_HTS, GCC.
  national_code_system      String?
  /// exact | all_children_equivalent | classification_refinement_required | unavailable.
  /// An HS6 that fans out into materially different national lines resolves to refinement
  /// required; it is never collapsed by picking a rate.
  classification_resolution String?
  candidate_line_count      Int?
  /// Every candidate line considered, why they were or were not equivalent, and what differed.
  resolution_detail         Json?
  evidence                  MarketAccessEvidence[]
  tariff_lines              MarketAccessTariffLine[]
  authority_release         AuthorityRelease?          @relation(fields: [authority_release_id], references: [id], onDelete: Restrict)

  @@index([country_code, hs_code_scope, retrieved_at])
  @@index([country_code, hs6_code, retrieved_at])
  @@index([authority_release_id])
}

/// One national tariff line beneath a requested HS6, exactly as the authority publishes it.
///
/// Separate from `MarketAccessEvidence` because that model answers "what applies to this
/// product" while this one preserves the full candidate set the answer was derived from —
/// including the lines that were rejected. Duty expressions are retained verbatim: a specific
/// duty such as `121.00 GBP / 1000 kg` has no honest percentage, so `ad_valorem_rate_percent`
/// stays null rather than carrying an invented number.
model MarketAccessTariffLine {
  id                        String    @id @default(cuid())
  snapshot_id               String
  jurisdiction              String
  country_code              String    @db.VarChar(2)
  hs6_code                  String
  hs_revision               String
  national_tariff_code      String
  national_code_system      String
  description               String
  declarable                Boolean   @default(true)
  /// third_country_duty | tariff_preference | tariff_quota | additional_duty | vat | other.
  measure_kind              String
  /// The authority's own geographic-area identifier for the measure (ERGA OMNES, a group, or a
  /// country). Retained unmapped so a group can never be silently read as a country.
  origin_geographic_area_id String?
  origin_scope              String
  applies_to_origin_country String?   @db.VarChar(2)
  /// Verbatim duty text from the source. Never normalised away.
  duty_expression           String
  /// ad_valorem | specific | compound | mixed | none | unparsed.
  duty_kind                 String
  /// Populated ONLY when the expression is purely ad valorem.
  ad_valorem_rate_percent   Decimal?  @db.Decimal(9, 4)
  specific_amount           Decimal?  @db.Decimal(18, 6)
  specific_currency         String?   @db.VarChar(3)
  specific_unit             String?
  specific_unit_quantity    Decimal?  @db.Decimal(18, 6)
  /// Conditions that gate the measure — quota membership, document requirements, footnotes.
  conditions                Json
  effective_from            DateTime?
  effective_to              DateTime?
  source_reference          String
  raw_measure               Json
  created_at                DateTime  @default(now())

  snapshot MarketAccessEvidenceSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)

  @@index([snapshot_id])
  @@index([country_code, hs6_code, national_tariff_code])
}

model MarketAccessEvidence {
  id                       String                       @id @default(cuid())
  snapshot_id              String
  jurisdiction             String
  country_code             String                       @db.VarChar(2)
  hs_code_scope            String
  rule_type                MarketAccessRuleType
  source_authority         String
  source_reference         String
  retrieved_at             DateTime
  effective_at             DateTime?
  expires_at               DateTime?
  superseded_at            DateTime?
  status                   MarketAccessEvidenceStatus
  confidence               Decimal                      @db.Decimal(5, 4)
  evidence_origin          EvidenceOrigin               @default(unknown_legacy)
  tariff_rate_percent      Decimal?                     @db.Decimal(9, 4)
  /// The national line this determination was made on, when one was resolved.
  national_tariff_code     String?
  national_code_system     String?
  /// Verbatim duty text. Present whenever the row carries a duty, including specific and
  /// compound duties that have no ad-valorem equivalent.
  duty_expression          String?
  duty_kind                String?
  /// India-origin applicability, recorded explicitly rather than inferred from evidence status.
  /// confirmed_applicable | potentially_applicable_requires_origin_proof | not_applicable |
  /// unknown. The mere existence of a preferential line is never applicability.
  preference_applicability String?
  /// What the applicability determination rests on, or what is missing for it.
  preference_basis         String?
  /// discovery_grade | execution_grade. Discovery-grade evidence compares markets; it is never
  /// presented as sufficient for customs execution.
  verification_grade       String?
  requirement_code         String?
  requirement_description  String?
  requirement_obtainable   Boolean?
  raw_evidence             Json
  snapshot                 MarketAccessEvidenceSnapshot @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)

  @@index([country_code, hs_code_scope, rule_type, status])
  @@index([snapshot_id])
}

/// Immutable proof of whether partner rows are sufficient to calculate supplier HHI.
/// Request success alone is never completeness evidence.
model SupplierCoverageAssertion {
  id                  String                     @id @default(cuid())
  country_code        String                     @db.VarChar(2)
  reporter            String
  hs_code             String
  year                Int
  world_total_value   Decimal                    @db.Decimal(20, 3)
  supplier_value_sum  Decimal                    @db.Decimal(20, 3)
  partner_count       Int
  coverage_ratio      Decimal?                   @db.Decimal(12, 8)
  query_scope         Json
  acquisition_ids     String[]
  completeness_status EvidenceCompletenessStatus
  threshold_version   String
  created_at          DateTime                   @default(now())

  @@index([country_code, hs_code, year, created_at])
}

/// Provider-backed route observation used by Demand Discovery. This is evidence,
/// not a generated recommendation: unknown rates/times remain null and validity is explicit.
model LogisticsRouteEvidence {
  id                                 String                  @id @default(cuid())
  /// Null only for genuinely reusable public-authority/provider evidence. A partner/manual lane
  /// captured for one exporter is tenant-scoped and must never be selected for another tenant.
  exporter_org_id                    String?
  origin_country                     String                  @db.VarChar(2)
  origin_state                       String?
  origin_city                        String?
  origin_location_code               String?
  origin_gateway                     String?
  destination_country                String                  @db.VarChar(2)
  destination_port                   String?
  transport_mode                     LogisticsTransportMode
  route_available                    Boolean
  transit_time_min_days              Int?
  transit_time_max_days              Int?
  freight_amount                     Decimal?                @db.Decimal(18, 4)
  freight_currency                   String?                 @db.VarChar(3)
  freight_rate_basis                 String?
  freight_retrieved_at               DateTime?
  freight_valid_until                DateTime?
  assumed_shipment_value_amount      Decimal?                @db.Decimal(18, 4)
  assumed_shipment_value_currency    String?                 @db.VarChar(3)
  provider                           String
  source_reference                   String
  source_dataset_version             String?
  retrieved_at                       DateTime
  valid_until                        DateTime?
  equipment_assumption               String?
  supported_product_constraint_codes String[]                @default([])
  hs_code_scope                      String?
  confidence                         Decimal                 @db.Decimal(5, 4)
  status                             LogisticsEvidenceStatus @default(verified)
  assertion_class                    EvidenceAssertionClass  @default(authoritative_public)
  evidence_origin                    EvidenceOrigin
  raw_evidence                       Json?
  created_at                         DateTime                @default(now())

  exporter_org ExporterOrg? @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)

  @@unique([exporter_org_id, provider, source_reference])
  @@index([exporter_org_id, destination_country, status])
  @@index([provider, source_reference])
  @@index([origin_country, destination_country, transport_mode, valid_until])
  @@index([destination_country, hs_code_scope, status])
}

/// Auditable soft-commercial risk observation. Legal restrictions never belong here;
/// they remain MarketEligibilityRule / sanctions evidence and are evaluated before scoring.
model MarketRiskSignal {
  id                   String              @id @default(cuid())
  jurisdiction         String
  country_code         String              @db.VarChar(2)
  hs_code_scope        String?
  dimension            RiskSignalDimension
  metric               String
  value                Decimal             @db.Decimal(20, 8)
  unit                 String
  observation_date     DateTime
  period_start         DateTime?
  period_end           DateTime?
  retrieved_at         DateTime
  valid_until          DateTime?
  provider             String
  source_reference     String
  source_version       String
  normalization_method String
  confidence           Decimal             @db.Decimal(5, 4)
  status               RiskSignalStatus    @default(verified)
  evidence_origin      EvidenceOrigin
  raw_evidence         Json?
  created_at           DateTime            @default(now())

  @@unique([provider, source_reference, metric, observation_date])
  @@index([country_code, dimension, observation_date, status])
  @@index([country_code, hs_code_scope, valid_until])
}

/// Destination/HS-scoped customer or market benchmark. Product fields have no fit
/// meaning until paired with one of these current, sourced observations.
model ExporterMarketFitBenchmark {
  id               String                     @id @default(cuid())
  jurisdiction     String
  country_code     String                     @db.VarChar(2)
  hs_code_scope    String
  benchmark_type   ExporterFitBenchmarkType
  minimum_value    Decimal?                   @db.Decimal(20, 8)
  maximum_value    Decimal?                   @db.Decimal(20, 8)
  unit             String?
  currency         String?                    @db.VarChar(3)
  required         Boolean?
  requirement_code String?
  provider         String
  source_reference String
  source_version   String
  observed_at      DateTime
  retrieved_at     DateTime
  valid_until      DateTime?
  confidence       Decimal                    @db.Decimal(5, 4)
  status           ExporterFitBenchmarkStatus @default(verified)
  evidence_origin  EvidenceOrigin
  raw_evidence     Json?
  created_at       DateTime                   @default(now())

  @@unique([provider, source_reference, benchmark_type, hs_code_scope])
  @@index([country_code, hs_code_scope, benchmark_type, status])
  @@index([country_code, valid_until])
}

model SanctionsIngestRun {
  id                   String         @id @default(cuid())
  status               IngestStatus   @default(running)
  source_results       Json           @default("[]")
  records_observed     Int            @default(0)
  restrictions_written Int            @default(0)
  started_at           DateTime       @default(now())
  completed_at         DateTime?
  error                String?
  evidence_origin      EvidenceOrigin @default(unknown_legacy)

  snapshots SanctionsSourceSnapshot[]
}

/// Lifecycle of one retrieval+parse attempt. Atomic activation (Phase 7) requires that a
/// snapshot exist in a non-serving state while it is being populated, so screening can
/// never read a half-written dataset.
enum SanctionsSnapshotState {
  /// Being retrieved/parsed/validated. NEVER read by screening.
  candidate
  /// The one snapshot per source that screening reads.
  active
  /// Previously active, replaced by a newer activation. Retained as history.
  superseded
  /// Terminal failure. Retained so the failure is auditable; never served.
  rejected
}

/// Where a refresh attempt stopped. Retrieval failure and parse failure are deliberately
/// distinct (Phase 3): "we could not obtain the artifact" and "we obtained it and could
/// not understand it" demand different operational responses.
enum SanctionsFailureStage {
  none
  retrieval
  artifact_validation
  parsing
  completeness
  activation
}

/// Immutable evidence of the exact official artifact that produced a snapshot (Part D).
///
/// A checksum alone proves two bodies are identical; it does NOT retain the body. If the
/// provider republishes the file later, a checksum-only record cannot demonstrate what we
/// actually screened against. This model references the retained object in private storage.
///
/// The raw XML is NEVER stored in a relational column — artifacts are 1–28 MB.
model SanctionsArtifact {
  id                      String         @id @default(cuid())
  dataset                 String
  source_contract_version String
  evidence_origin         EvidenceOrigin @default(public_real)

  /// Retrieval URL with credential-shaped params redacted before persistence.
  source_reference      String
  retrieved_at          DateTime
  provider_published_at DateTime?
  provider_version      String?
  http_status           Int?
  media_type            String?
  byte_length           Int
  sha256                String

  etag          String?
  last_modified String?

  /// --- Private object storage ---
  storage_provider  String
  object_key        String
  object_version_id String?
  persisted_at      DateTime @default(now())

  /// Explicit, never assumed. `verified` only after a real post-write integrity check.
  verification_status SanctionsArtifactVerification @default(unverified)
  verification_detail String?
  verified_at         DateTime?

  snapshot_id   String?                  @unique
  snapshot      SanctionsSourceSnapshot? @relation(fields: [snapshot_id], references: [id], onDelete: SetNull)
  ingest_run_id String?

  @@index([dataset, retrieved_at])
  @@index([sha256])
}

enum SanctionsArtifactVerification {
  /// Persisted but integrity not re-checked.
  unverified
  /// Re-read from storage; byte length and SHA-256 both matched.
  verified
  /// Re-read and MISMATCHED — the snapshot must not activate.
  mismatch
  /// Adapter cannot support post-write verification; documented, not claimed as verified.
  unsupported
}

/// A database-backed refresh lease (Part F4). In-memory mutexes cannot coordinate across
/// worker processes; this row is the cross-process lock. `expires_at` guarantees a crashed
/// worker cannot hold a dataset locked forever.
model SanctionsRefreshLease {
  dataset     String   @id
  owner       String
  acquired_at DateTime @default(now())
  expires_at  DateTime
  job_id      String?

  @@index([expires_at])
}

/// One retrieval+parse attempt against one source. NOT unique per source — history is
/// preserved (Phase 17), and exactly one row per source carries state=active.
model SanctionsSourceSnapshot {
  id                           String                      @id @default(cuid())
  source                       String
  source_url                   String
  checksum                     String
  record_count                 Int
  fetched_at                   DateTime                    @default(now())
  metadata                     Json?
  evidence_origin              EvidenceOrigin              @default(unknown_legacy)
  coverage_complete            Boolean                     @default(false)
  retrieved_count              Int                         @default(0)
  parsed_entity_count          Int                         @default(0)
  rejected_records             Int                         @default(0)
  parse_errors                 Json                        @default("[]")
  last_successful_full_refresh DateTime?
  source_update_date           DateTime?
  source_version               String?
  completeness_status          SanctionsCompletenessStatus @default(FAILED)

  /// --- Atomic activation (Phase 7) ---
  state         SanctionsSnapshotState @default(candidate)
  activated_at  DateTime?
  superseded_at DateTime?

  /// --- Source contract identity (Phase 2) ---
  /// Which versioned contract produced this snapshot. A contract change is visible as a
  /// different version rather than an unexplained shape change.
  source_contract_version String?
  authority               String?
  dataset_name            String?
  adapter_version         String?

  /// --- Raw artifact integrity (Phase 4) ---
  media_type    String?
  byte_length   Int?
  http_status   Int?
  etag          String?
  last_modified String?
  /// Where the immutable raw artifact was retained, if retention is enabled.
  artifact_ref  String?

  /// --- Failure separation + anomaly detection (Phase 3/6) ---
  failure_stage  SanctionsFailureStage @default(none)
  failure_reason String?
  /// Structured anomaly findings (count collapse, alias/identifier coverage collapse).
  anomalies      Json                  @default("[]")

  ingest_run_id String?
  ingest_run    SanctionsIngestRun? @relation(fields: [ingest_run_id], references: [id], onDelete: SetNull)
  entities      SanctionsEntity[]
  artifact      SanctionsArtifact?

  @@index([source, state])
  @@index([source, fetched_at])
}

// ---------------------------------------------------------------------------
// Buyers & pipeline
// ---------------------------------------------------------------------------

/// Global, normalized buyer identity. Deliberately has NO fit score: fit is a function
/// of buyer x product x market, so it lives on the search projection and on BuyerLead
/// (docs/13 B5 / R6).
model Buyer {
  id                       String             @id @default(cuid())
  legal_name               String
  display_name             String
  country_code             String             @db.VarChar(2)
  website                  String?
  buyer_type               String
  import_activity_summary  Json?
  verification_status      VerificationStatus @default(unverified)
  /// [{ code, severity, summary }] — never hidden on the detail view.
  risk_flags               Json               @default("[]")
  last_activity_at         DateTime?
  deprioritized            Boolean            @default(false)
  deprioritization_reasons Json               @default("[]")
  sanctions_blocked        Boolean            @default(false)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  contacts             BuyerContact[]
  source_evidence      BuyerSourceEvidence[]
  buyer_leads          BuyerLead[]
  shortlists           BuyerShortlist[]
  deals                Deal[]
  import_records       ImportRecord[]
  attribute_claims     BuyerAttributeClaim[]
  feature_snapshot     BuyerFeatureSnapshot?
  fit_assessments      BuyerFitAssessment[]
  outcomes             BuyerOutcome[]
  sanctions_screenings SanctionsScreeningCase[]
  commercial_profiles  BuyerCommercialProfile[]

  @@index([country_code])
  @@index([buyer_type])
  @@index([verification_status])
}

model BuyerContact {
  id                  String             @id @default(cuid())
  buyer_id            String
  name                String
  role_title          String?
  email               String?
  phone               String?
  verification_status VerificationStatus @default(unverified)
  /// Where this contact came from and when — provenance is required before outreach.
  provenance          String?
  verified_at         DateTime?
  created_at          DateTime           @default(now())

  buyer Buyer @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@index([buyer_id])
}

model BuyerSourceEvidence {
  id          String   @id @default(cuid())
  buyer_id    String
  source_type String
  source_ref  String?
  summary     String?
  observed_at DateTime
  created_at  DateTime @default(now())

  buyer Buyer @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@index([buyer_id, observed_at])
}

/// Shortlisting is a bookmark. It must never silently create a Deal (EXP-06-AC01).
model BuyerShortlist {
  id              String   @id @default(cuid())
  exporter_org_id String
  buyer_id        String
  product_id      String?
  created_by_id   String?
  created_at      DateTime @default(now())

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer        Buyer       @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@unique([exporter_org_id, buyer_id, product_id])
  @@index([exporter_org_id])
}

model BuyerLead {
  id              String         @id @default(cuid())
  exporter_org_id String
  product_id      String
  buyer_id        String
  stage           BuyerLeadStage @default(new)

  assigned_agent_id String?
  created_by_id     String?

  next_action     String?
  next_action_at  DateTime?
  last_contact_at DateTime?
  interest_level  InterestLevel @default(unknown)

  disqualification_reason      DisqualificationReason?
  disqualification_reason_text String?

  /// Fit is scored per buyer x product x market at lead creation and snapshotted here
  /// so later engine changes never rewrite the number the exporter acted on.
  fit_score       Int?
  fit_score_basis Json?

  /// Set on conversion. Exactly one Deal per lead (AGT-03-AC04).
  deal_id String? @unique

  source     String   @default("buyer_discovery")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org      ExporterOrg           @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [product_id], references: [id])
  buyer             Buyer                 @relation(fields: [buyer_id], references: [id])
  assigned_agent    User?                 @relation("LeadAgent", fields: [assigned_agent_id], references: [id])
  created_by        User?                 @relation("LeadCreatedBy", fields: [created_by_id], references: [id])
  deal              Deal?                 @relation("LeadDeal", fields: [deal_id], references: [id])
  activities        OutreachActivity[]
  outreach_attempts OutreachAttempt[]
  transitions       BuyerLeadTransition[]
  snapshot          BuyerLeadSnapshot?
  internal_notes    InternalNote[]
  messages          Message[]
  outcome           BuyerOutcome?

  /// Server-side duplicate prevention (EXP-07-AC02): one lead per org x product x buyer.
  @@unique([exporter_org_id, product_id, buyer_id])
  @@index([exporter_org_id, stage])
  @@index([assigned_agent_id, stage])
  @@index([next_action_at])
}

model OutreachActivity {
  id            String               @id @default(cuid())
  buyer_lead_id String
  actor_user_id String
  type          OutreachActivityType
  /// Internal by default — outreach logs are not exporter-visible unless marked.
  visibility    Visibility           @default(internal)
  outcome       String?
  summary       String
  occurred_at   DateTime             @default(now())
  created_at    DateTime             @default(now())

  buyer_lead BuyerLead @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
  actor      User      @relation(fields: [actor_user_id], references: [id])

  @@index([buyer_lead_id, occurred_at])
}

/// One immutable contact attempt. This is deliberately separate from the free-form
/// activity timeline so attempts and response rates remain analytically meaningful.
model OutreachAttempt {
  id                   String                    @id @default(cuid())
  buyer_lead_id        String
  actor_user_id        String
  channel              OutreachChannel
  attempted_at         DateTime                  @default(now())
  template_id          String?
  template_version     String?
  automation           OutreachAutomation        @default(manual)
  sequence_number      Int
  delivery_status      OutreachDeliveryStatus    @default(unknown)
  reply_classification BuyerReplyClassification?
  reply_notes          String?
  replied_at           DateTime?
  evidence_origin      EvidenceOrigin            @default(unknown_legacy)
  created_at           DateTime                  @default(now())
  buyer_lead           BuyerLead                 @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
  actor                User                      @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@unique([buyer_lead_id, sequence_number])
  @@index([buyer_lead_id, attempted_at])
}

/// Append-only stage history; BuyerLead.stage remains the current projection.
model BuyerLeadTransition {
  id            String          @id @default(cuid())
  buyer_lead_id String
  from_stage    BuyerLeadStage?
  to_stage      BuyerLeadStage
  actor_user_id String?
  reason        String?
  occurred_at   DateTime        @default(now())
  buyer_lead    BuyerLead       @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
  actor         User?           @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@index([buyer_lead_id, occurred_at])
}

/// Immutable context frozen when a lead is surfaced/created. No updated_at by design.
model BuyerLeadSnapshot {
  id                          String    @id @default(cuid())
  buyer_lead_id               String    @unique
  exporter_org_id             String
  product_id                  String
  buyer_id                    String
  destination_country         String
  buyer_fit_assessment_id     String?
  fit_model_version           String?
  fit_score                   Int?
  fit_confidence              Int?
  fit_components              Json?
  fit_input_snapshot          Json?
  buyer_rank                  Int?
  market_assessment_id        String?
  market_context              Json?
  sanctions_screening_case_id String?
  sanctions_result            String?
  sanctions_algorithm_version String?
  buyer_evidence_coverage     Json
  offered_price_amount        Decimal?  @db.Decimal(18, 4)
  offered_price_currency      String?   @db.VarChar(3)
  incoterm                    String?
  commercial_basis            String?
  moq_value                   Decimal?  @db.Decimal(18, 4)
  moq_unit                    String?
  offered_order_size          Decimal?  @db.Decimal(18, 4)
  offered_order_size_unit     String?
  production_lead_time_days   Int?
  customization_claim         String?
  certification_claims        Json?
  created_at                  DateTime  @default(now())
  buyer_lead                  BuyerLead @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
}

model BuyerAttributeClaim {
  id               String   @id @default(cuid())
  buyer_id         String
  attribute        String
  value            Json
  source           String
  source_record_id String?
  observed_at      DateTime
  created_at       DateTime @default(now())
  buyer            Buyer    @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@unique([buyer_id, attribute, source, source_record_id])
  @@index([buyer_id, attribute, observed_at])
}

model BuyerFeatureSnapshot {
  id                        String    @id @default(cuid())
  buyer_id                  String    @unique
  import_frequency_per_year Decimal?  @db.Decimal(12, 4)
  last_shipment_date        DateTime?
  shipment_count_12m        Int
  typical_shipment_size     Decimal?  @db.Decimal(20, 3)
  quantity_unit             String?
  origin_mix                Json
  india_sourcing_history    Boolean?
  supplier_concentration    Decimal?  @db.Decimal(8, 6)
  purchasing_trend          Decimal?  @db.Decimal(12, 6)
  provenance                Json
  computed_at               DateTime  @default(now())
  buyer                     Buyer     @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
}

/// Search-result materialization. Fit deliberately does not live on Buyer.
model BuyerFitAssessment {
  id               String           @id @default(cuid())
  buyer_id         String
  product_id       String
  exporter_org_id  String
  score            Int?
  confidence_score Int
  components       Json
  input_snapshot   Json
  model_version    String
  evidence_origins EvidenceOrigin[] @default([unknown_legacy])
  computed_at      DateTime         @default(now())

  /// Immutable scoring-policy provenance, analogous in intent to MarketAssessment's.
  ///
  /// Null on rows written before this existed: those assessments cannot be attributed to a
  /// policy after the fact, and guessing would be worse than admitting the gap — hence the
  /// `legacy_non_recomputable` default rather than a back-fill.
  ///
  /// Deliberately NOT sourced from the `buyers.fit_score_weights` config key: that key
  /// describes a different, unused model (country/category/verification/recency) while this
  /// scorer combines volume/price/certification/outcome. The persisted policy is the one the
  /// code actually applies — see BUYER_FIT_POLICY in src/lib/buyer-intelligence.ts.
  scoring_policy_version  Int?
  scoring_policy_hash     String?
  scoring_policy_snapshot Json?
  reproducibility_status  String          @default("legacy_non_recomputable")
  buyer                   Buyer           @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  product                 Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  exporter_org            ExporterOrg     @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  agent_decisions         AgentDecision[]

  @@unique([buyer_id, product_id, exporter_org_id])
  @@index([exporter_org_id, product_id, score])
}

model BuyerOutcome {
  id               String         @id @default(cuid())
  buyer_id         String
  exporter_org_id  String
  buyer_lead_id    String         @unique
  contacted_at     DateTime?
  replied_at       DateTime?
  converted        Boolean?
  rejection_reason String?
  payment_behavior String?
  deal_id          String?
  payment_evidence Json?
  evidence_origin  EvidenceOrigin @default(unknown_legacy)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  buyer            Buyer          @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  exporter_org     ExporterOrg    @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer_lead       BuyerLead      @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)

  @@index([buyer_id, exporter_org_id])
}

model SanctionsEntity {
  id                  String                   @id @default(cuid())
  source              String
  source_record_id    String
  name                String
  normalized_name     String
  entity_type         String?
  aliases             Json                     @default("[]")
  countries           Json                     @default("[]")
  addresses           Json                     @default("[]")
  dates               Json                     @default("[]")
  identifiers         Json                     @default("[]")
  programs            Json                     @default("[]")
  remarks             String?
  source_published_at DateTime?
  source_version      String?
  observed_at         DateTime
  is_active           Boolean                  @default(true)
  raw_snapshot        Json?
  evidence_origin     EvidenceOrigin           @default(unknown_legacy)
  screening_cases     SanctionsScreeningCase[]

  /// Entities belong to the snapshot that produced them (Phase 7). Screening joins through
  /// `snapshot.state = active`, which is what makes activation atomic: rows for a candidate
  /// snapshot can be written incrementally without ever being visible to screening, and a
  /// failed refresh leaves the previous snapshot's rows serving untouched.
  ///
  /// Nullable because legacy rows predate snapshot binding. A null snapshot is NOT served
  /// in a real workflow environment — see `activeSanctionsEntityWhere()`. Legacy rows stay
  /// exactly as they are (Phase 17: historical data is not retroactively relabelled).
  snapshot_id String?
  snapshot    SanctionsSourceSnapshot? @relation(fields: [snapshot_id], references: [id], onDelete: Cascade)

  /// Normalized aliases, precomputed so alias matching does not renormalize on every
  /// screening call. Source truth stays in `aliases` (Phase 5).
  normalized_aliases Json @default("[]")

  @@unique([snapshot_id, source, source_record_id])
  @@index([normalized_name, is_active])
  @@index([snapshot_id])
}

model SanctionsScreeningCase {
  id                   String                        @id @default(cuid())
  buyer_id             String?
  searched_name        String
  normalized_name      String
  searched_country     String?
  searched_address     String?
  searched_entity_type String?
  searched_identifiers Json                          @default("[]")
  result_state         SanctionsScreeningResultState
  source_entity_id     String?
  evidence             Json
  algorithm_version    String
  created_at           DateTime                      @default(now())
  resolved_at          DateTime?
  buyer                Buyer?                        @relation(fields: [buyer_id], references: [id], onDelete: SetNull)
  source_entity        SanctionsEntity?              @relation(fields: [source_entity_id], references: [id], onDelete: SetNull)
  decisions            SanctionsReviewDecision[]

  @@index([result_state, created_at])
  @@index([buyer_id, created_at])
}

model SanctionsReviewDecision {
  id                String                       @id @default(cuid())
  screening_case_id String
  reviewer_user_id  String
  decision          SanctionsReviewDecisionValue
  reason            String
  evidence          Json?
  created_at        DateTime                     @default(now())
  screening_case    SanctionsScreeningCase       @relation(fields: [screening_case_id], references: [id], onDelete: Cascade)
  reviewer          User                         @relation(fields: [reviewer_user_id], references: [id], onDelete: Restrict)

  @@index([screening_case_id, created_at])
  @@index([reviewer_user_id, created_at])
}

// ---------------------------------------------------------------------------
// Deal
// ---------------------------------------------------------------------------

model Deal {
  id              String  @id @default(cuid())
  exporter_org_id String
  buyer_id        String
  buyer_lead_id   String?
  product_id      String?

  stage DealStage @default(qualifying)

  // value = money
  value_amount   Decimal? @db.Decimal(18, 4)
  value_currency String?  @db.VarChar(3)

  incoterm       String?
  incoterm_place String?

  // quantity = number + unit
  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  // unit_price / total = money, stored not inferred by the UI
  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  payment_terms  Json?
  delivery_terms Json?

  /// The buyer's own purchase-order / contract reference. Printed on the invoice and
  /// packing list so the buyer can match the shipment to their order. Ours is `id`;
  /// this is theirs, and the two must never be conflated.
  buyer_reference String?

  risk_state     RiskState @default(normal)
  risk_reason    String?
  owner_agent_id String?

  /// Snapshot of the fee policy in force at lock time — later config changes never
  /// rewrite it (docs/01 rule of record).
  quoted_fee_policy Json?
  locked_at         DateTime?

  closed_reason String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  /// Optimistic concurrency — a stale write returns 409 VERSION_CONFLICT.
  version       Int      @default(1)

  exporter_org              ExporterOrg              @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  buyer                     Buyer                    @relation(fields: [buyer_id], references: [id])
  product                   Product?                 @relation(fields: [product_id], references: [id])
  buyer_lead                BuyerLead?               @relation("LeadDeal")
  owner_agent               User?                    @relation("DealOwnerAgent", fields: [owner_agent_id], references: [id])
  proposals                 DealProposal[]
  snapshots                 DealSnapshot[]
  documents                 Document[]
  shipments                 Shipment[]
  payments                  Payment[]
  tasks                     Task[]
  messages                  Message[]
  internal_notes            InternalNote[]
  disputes                  Dispute[]
  partner_handoffs          PartnerHandoff[]
  insurance_cases           InsuranceCase[]
  payouts                   Payout[]
  issued_invoice_numbers    IssuedInvoiceNumber[]
  document_input_snapshots  DocumentInputSnapshot[]
  trade_finance_instruction TradeFinanceInstruction?

  @@index([exporter_org_id, stage])
  @@index([owner_agent_id, stage])
  @@index([risk_state])
}

/// Status of one commercial proposal version (AGT-05 "Required UI states").
enum ProposalStatus {
  draft
  awaiting_exporter
  approved
  changes_requested
  superseded
  withdrawn
}

/// One version of the commercial terms under negotiation (AGT-05-AC01: "Commercial
/// proposals are versioned"; EXP-10-AC01: "Approval references an immutable proposal
/// version ID").
///
/// A `draft` is the only mutable state. Once it leaves draft the row is frozen and a
/// revision writes a NEW version instead of editing this one — that is what makes
/// AGT-05-AC04 ("every revision preserves previous acceptance/change history") and
/// EXP-10-AC01 structurally true rather than a convention the route has to remember.
///
/// `approved_by_id` is deliberately separate from `proposed_by_id`: AGT-05-AC02 requires
/// the exporter to approve their own terms, and an agent must never be able to record an
/// approval on their behalf. The route re-checks `canApproveCommercialTerms()` on the
/// approving principal; this column is the persisted evidence of who actually did it.
model DealProposal {
  id      String @id @default(cuid())
  deal_id String
  version Int

  status ProposalStatus @default(draft)

  // The terms this version proposes — the same set DealSnapshot freezes at lock, so a
  // lock can be built from an approved proposal without re-deriving anything.
  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  incoterm       String?
  incoterm_place String?

  payment_terms Json?

  ship_window_start DateTime?
  ship_window_end   DateTime?

  special_conditions String?
  /// Exporter-visible rationale from the agent. Internal reasoning lives in InternalNote.
  agent_note         String?

  /// Structured buyer-side state the agent records (AGT-05 "Buyer status"). Never
  /// presented as legal acceptance — see the screen copy.
  buyer_status      String?
  buyer_status_note String?

  proposed_by_id String?
  proposed_at    DateTime?

  approved_by_id String?
  approved_at    DateTime?

  /// Structured change request from the exporter (EXP-10 "Request changes").
  changes_requested_by_id String?
  changes_requested_at    DateTime?
  changes_requested_note  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal                 Deal  @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  proposed_by          User? @relation("ProposalProposedBy", fields: [proposed_by_id], references: [id])
  approved_by          User? @relation("ProposalApprovedBy", fields: [approved_by_id], references: [id])
  changes_requested_by User? @relation("ProposalChangesRequestedBy", fields: [changes_requested_by_id], references: [id])

  @@unique([deal_id, version])
  @@index([deal_id, status])
}

/// Frozen at deal_locked. All documents generate from this, never from live deal fields
/// (docs/13 E1). Immutable once written — amendments create a new version.
model DealSnapshot {
  id      String @id @default(cuid())
  deal_id String
  version Int    @default(1)

  buyer_id         String
  buyer_legal_name String
  product_id       String?
  product_name     String?
  sku              String?

  quantity Decimal? @db.Decimal(18, 4)
  unit     String?

  unit_price_amount   Decimal? @db.Decimal(18, 4)
  unit_price_currency String?  @db.VarChar(3)
  total_amount        Decimal? @db.Decimal(18, 4)
  total_currency      String?  @db.VarChar(3)

  incoterm           String?
  incoterm_place     String?
  payment_terms      Json?
  ship_window_start  DateTime?
  ship_window_end    DateTime?
  special_conditions String?

  /// Fee policy in force at the moment of lock.
  fee_policy Json

  created_by_id String?
  created_at    DateTime @default(now())

  deal      Deal       @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([deal_id, version])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  scope_type ScopeType
  scope_id   String

  /// Denormalized tenant key so cross-deal task indexes stay one org-scoped query
  /// rather than a fan-out over N deals (docs/13 A1 backend impact).
  exporter_org_id String?
  deal_id         String?

  title         String
  description   String?
  owner_user_id String?
  owner_role    UserRole

  state    TaskState    @default(not_started)
  priority TaskPriority @default(normal)

  due_at       DateTime?
  warning_at   DateTime?
  /// Derived from due_at/warning_at + SLA config. Never user-editable (AGT-07-AC03).
  sla_state    SlaState  @default(on_time)
  escalated_at DateTime?

  blocked_reason String?
  waiting_on     String?
  cancel_reason  String?
  completed_at   DateTime?

  visibility Visibility @default(exporter_visible)
  task_type  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org ExporterOrg?   @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  deal         Deal?          @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  owner        User?          @relation("TaskOwner", fields: [owner_user_id], references: [id])
  evidence     TaskEvidence[]

  @@index([exporter_org_id, state, due_at])
  @@index([owner_user_id, state, due_at])
  @@index([deal_id, state])
  @@index([sla_state])
}

/// EXP-03-AC03: evidence upload with an auditable review outcome, linked to the task it
/// was uploaded for. A separate table rather than fields on Task — a task can accumulate
/// several upload attempts (reject, re-upload), and each one's own reviewer/outcome/note
/// must stay attributable, not overwritten by the next attempt.
model TaskEvidence {
  id        String @id @default(cuid())
  task_id   String
  file_ref  String
  file_name String

  uploaded_by_id String
  uploaded_at    DateTime @default(now())

  review_status  EvidenceReviewStatus @default(pending)
  review_note    String?
  reviewed_by_id String?
  reviewed_at    DateTime?

  created_at DateTime @default(now())

  task        Task  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploaded_by User  @relation("TaskEvidenceUploader", fields: [uploaded_by_id], references: [id])
  reviewed_by User? @relation("TaskEvidenceReviewer", fields: [reviewed_by_id], references: [id])

  @@index([task_id, created_at])
  @@index([review_status])
}

enum EvidenceReviewStatus {
  pending
  approved
  rejected
}

enum FileScanStatus {
  pending
  clean
  infected
  failed
  unknown_legacy
}

// ---------------------------------------------------------------------------
// Documents — four independent status dimensions
// ---------------------------------------------------------------------------

model Document {
  id          String  @id @default(cuid())
  deal_id     String?
  shipment_id String?

  doc_type           DocType
  version            Int            @default(1)
  is_current_version Boolean        @default(true)
  source             DocumentSource

  /// Four independent dimensions. Collapsing any two of these is a spec violation
  /// (docs/07 §7.3, docs/13 A5).
  generation_status GenerationStatus @default(queued)
  review_status     ReviewStatus     @default(not_reviewed)
  approval_status   ApprovalStatus   @default(not_required)
  filing_status     FilingStatus     @default(not_applicable)

  generation_error         String?
  changes_requested_reason String?
  rejection_reason         String?
  filing_reference         String?
  filed_at                 DateTime?
  /// AGT-06-AC02: a filing is an external handoff, so it records WHO filed it alongside
  /// the status, timestamp and reference. Without this the audit trail can say a document
  /// was filed but not by whom, which is exactly the gap AC02 closes.
  filed_by_id              String?

  /// Secure object ref — resolved to a short-lived signed URL, never a public bucket URL.
  file_ref           String?
  file_name          String?
  file_size_bytes    Int?
  mime_type          String?
  checksum           String?
  storage_provider   String?
  storage_version_id String?
  scan_status        FileScanStatus @default(unknown_legacy)
  scan_engine        String?
  scanned_at         DateTime?
  uploaded_by_id     String?

  /// The DealSnapshot the document generated from — enables reproducible regeneration.
  generated_from_snapshot_id String?
  generation_inputs          Json?

  /// The frozen, hashed canonical input this version was built from. DealSnapshot above
  /// covers the commercial terms agreed at deal lock; this covers everything else a
  /// document consumes — exporter master data, buyer address, ports, packages, FX — which
  /// keeps changing after the lock. Set when the input is frozen, never rewritten.
  input_snapshot_id String? @unique

  /// Why this version exists, when it supersedes an earlier one. Required by the amendment
  /// service once a prior version has been generated — a correction with no stated reason is
  /// a change nobody can audit later. Never auto-filled with field values: the reason is a
  /// human sentence, and copying canonical data into it would leak buyer details into a
  /// column that surfaces in lists.
  amendment_reason     String?
  /// The version this one supersedes. Cheaper and less ambiguous than re-deriving
  /// "version - 1", which is wrong the moment a version is ever skipped.
  amended_from_version Int?

  reviewed_by_id    String?
  reviewed_at       DateTime?
  approved_by_id    String?
  /// Approval is bound to this version + checksum, not to the document identity.
  approved_version  Int?
  approved_checksum String?
  approved_at       DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  artifacts               DocumentArtifact[]
  bank_presentation_items BankPresentationItem[]

  deal           Deal?                  @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment       Shipment?              @relation(fields: [shipment_id], references: [id])
  snapshot       DealSnapshot?          @relation(fields: [generated_from_snapshot_id], references: [id])
  input_snapshot DocumentInputSnapshot? @relation(fields: [input_snapshot_id], references: [id])
  reviewer       User?                  @relation("DocumentReviewer", fields: [reviewed_by_id], references: [id])
  approver       User?                  @relation("DocumentApprover", fields: [approved_by_id], references: [id])
  filed_by       User?                  @relation("DocumentFiler", fields: [filed_by_id], references: [id])
  disputes       Dispute[]

  // A deal must never have two rows claiming the same (doc_type, version) — the
  // generate/upload routes rely on this to be the single source of truth for "which row
  // is THE v2 of the CI", not just a convention they happen to follow.
  @@unique([deal_id, doc_type, version])
  @@index([approval_status])
  @@index([filing_status])
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------

model Shipment {
  id      String @id @default(cuid())
  deal_id String

  status ShipmentStatus @default(planning)
  mode   ShipmentMode?

  origin      Json?
  destination Json?

  /// Snapshot from the deal at creation, not a live read.
  incoterm String?

  cha_partner_id     String?
  freight_partner_id String?
  booking_ref        String?
  customs_ref        String?
  shipping_bill_no   String?
  shipping_bill_date DateTime?

  /// Ports as identity, not as a label. `_name` is what a human reads, `_unlocode` is
  /// the durable identifier customs and carriers actually key on, `_country` is where it
  /// is. A NULL code means "not known" and stays NULL — a code is never derived from a
  /// name, because a wrong UN/LOCODE on a shipping bill is worse than an absent one.
  /// Format is enforced by a database CHECK (2 letters + 3 alphanumerics) when present.
  port_of_loading_name       String?
  port_of_loading_unlocode   String? @db.VarChar(5)
  port_of_loading_country    String? @db.VarChar(2)
  port_of_discharge_name     String?
  port_of_discharge_unlocode String? @db.VarChar(5)
  port_of_discharge_country  String? @db.VarChar(2)
  /// Where the goods finally end up, which is not always the discharge port's country.
  final_destination_country  String? @db.VarChar(2)
  final_destination_name     String?

  /// Explicit instruction facts. Freight payment cannot be inferred safely from Incoterm,
  /// and a missing notify party must not be silently treated as "same as consignee".
  notify_party_mode          NotifyPartyMode?
  notify_party_name          String?
  notify_party_address_line1 String?
  notify_party_address_line2 String?
  notify_party_city          String?
  notify_party_region        String?
  notify_party_postal_code   String?
  notify_party_country_code  String?             @db.VarChar(2)
  notify_party_email         String?
  notify_party_phone         String?
  freight_payment_term       FreightPaymentTerm?
  handling_instructions      String?

  /// NULL means the containerisation decision has not been recorded. False is a deliberate
  /// non-containerised shipment; true requires one or more ShipmentContainer rows.
  containerized Boolean?

  /// Carrier and conveyance. One field for vessel-or-flight because the renderers print
  /// one line and the mode already says which it is; a voyage number is separate because
  /// sea shipments carry both.
  vessel_or_flight_no String?
  voyage_no           String?
  container_no        String?
  container_type      String?
  seal_no             String?

  /// The transport document. `type` is explicit rather than inferred from two nullable
  /// number columns, so "which document is this number?" is answered by data, not by
  /// which column happened to be filled. A CHECK requires the type whenever a number is
  /// present, and forbids an air waybill on a sea shipment (and vice versa).
  transport_document_type TransportDocumentType?
  transport_document_no   String?
  transport_document_date DateTime?

  /// Shipping marks for the consignment as a whole — what is stencilled on the packages.
  marks_and_numbers String?
  /// The date the goods actually shipped, distinct from any milestone ETA.
  shipped_on_date   DateTime?

  /// Actual booked freight for THIS shipment. Deliberately not read from
  /// LogisticsRouteEvidence.freight_amount, which is market evidence used for estimates —
  /// printing an estimate as the freight charged on a customs document would be a
  /// misdeclaration. Insurance is NOT duplicated here: InsuranceCase already owns it.
  freight_amount         Decimal? @db.Decimal(18, 4)
  freight_currency       String?  @db.VarChar(3)
  other_charges_amount   Decimal? @db.Decimal(18, 4)
  other_charges_currency String?  @db.VarChar(3)

  exception_state    ExceptionState @default(none)
  exception_reason   String?
  exception_owner_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal             Deal                @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  cha_partner      Partner?            @relation("ChaPartner", fields: [cha_partner_id], references: [id])
  freight_partner  Partner?            @relation("FreightPartner", fields: [freight_partner_id], references: [id])
  milestones       ShipmentMilestone[]
  packages         ShipmentPackage[]
  containers       ShipmentContainer[]
  documents        Document[]
  disputes         Dispute[]
  partner_handoffs PartnerHandoff[]

  @@index([deal_id])
  @@index([status])
  @@index([exception_state])
}

/// One physical container on a shipment. VGM is an explicitly verified fact per container;
/// it is never derived from ShipmentPackage totals. Multiple rows prevent the old
/// Shipment.container_no shortcut from becoming a hidden one-container assumption.
model ShipmentContainer {
  id               String  @id @default(cuid())
  shipment_id      String
  sequence         Int
  container_number String
  container_type   String?
  seal_number      String?

  tare_weight_kg                 Decimal?   @db.Decimal(12, 3)
  vgm_verified_gross_mass_kg     Decimal?   @db.Decimal(12, 3)
  vgm_method                     VgmMethod?
  vgm_method_2_component_mass_kg Decimal?   @db.Decimal(12, 3)
  vgm_verified_at                DateTime?
  vgm_verifier_name              String?
  vgm_verifier_capacity          String?
  vgm_evidence_ref               String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shipment Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([shipment_id, sequence])
  @@unique([shipment_id, container_number])
  @@index([shipment_id])
}

/// ETA and actual are distinct columns — EXP-14-AC02 requires both to be visible.
model ShipmentMilestone {
  id           String         @id @default(cuid())
  shipment_id  String
  code         String
  label        String
  state        MilestoneState @default(pending)
  eta_at       DateTime?
  actual_at    DateTime?
  evidence_ref String?
  sequence     Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  shipment Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)

  @@unique([shipment_id, code])
  @@index([shipment_id, sequence])
}

model Partner {
  id             String        @id @default(cuid())
  type           PartnerType
  legal_name     String
  display_name   String
  country_code   String        @db.VarChar(2)
  contact_email  String?
  contact_phone  String?
  partner_status PartnerStatus @default(active)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  cha_shipments     Shipment[]       @relation("ChaPartner")
  freight_shipments Shipment[]       @relation("FreightPartner")
  handoffs          PartnerHandoff[]

  @@index([type, partner_status])
}

/// AGT-06-AC02: "every external filing/partner handoff has owner, status, timestamp and
/// reference/evidence where available."
///
/// `Shipment.cha_partner_id` records WHICH partner is assigned; it cannot record that the
/// packet was sent on a date by a named agent under a reference the partner quoted back.
/// This is that record — one row per handoff event, never overwritten, so a re-assignment
/// leaves the original handoff visible rather than silently replacing it.
///
/// The partner is a foreign key into the approved directory, not a string. AGT-06 says
/// "no free-text phantom partner in structured assignment" — that is enforced here by the
/// column type, so it cannot be violated by a route that forgets to validate.
model PartnerHandoff {
  id          String  @id @default(cuid())
  deal_id     String
  shipment_id String?
  partner_id  String

  /// Which lane this handoff belongs to (docs/05 AGT-06 execution lanes).
  lane   PartnerType
  status HandoffStatus @default(pending)

  /// The accountable ClearTrade-side owner. Not nullable in practice — a handoff nobody
  /// owns is the failure mode AC02 exists to prevent.
  owner_user_id String

  /// Reference the partner issued back (job number, filing ref, booking ref). Null until
  /// they respond — "where available" in AC02.
  reference String?
  notes     String?

  sent_at         DateTime  @default(now())
  acknowledged_at DateTime?
  completed_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal     Deal      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [partner_id], references: [id])
  owner    User      @relation("PartnerHandoffOwner", fields: [owner_user_id], references: [id])

  @@index([deal_id, lane])
  @@index([partner_id, status])
}

enum HandoffStatus {
  pending
  sent
  acknowledged
  completed
  rejected
}

// ---------------------------------------------------------------------------
// Money in / risk
// ---------------------------------------------------------------------------

model Payment {
  id      String @id @default(cuid())
  deal_id String

  // money
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  amount_received Decimal? @db.Decimal(18, 4)

  payment_method String?
  status         PaymentStatus @default(not_due)

  due_at      DateTime?
  received_at DateTime?
  realized_at DateTime?

  evidence_refs Json @default("[]")

  /// Independent of status — never inferred from received/realized.
  brc_status BrcStatus @default(not_applicable)

  /// Provenance is mandatory and rendered on every milestone (docs/13 E3).
  source PaymentSource @default(exporter_update)

  label      String?
  sequence   Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal                       Deal                      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  disputes                   Dispute[]
  trade_finance_instructions TradeFinanceInstruction[]

  @@index([deal_id, sequence])
  @@index([status, due_at])
}

/// Tenant-owned bank identity used for export document presentation. `account_reference` is
/// intentionally not named account_number: callers may store the bank-approved masked or
/// documentary reference without forcing a raw account number into snapshots and audit logs.
model ExporterBankAccount {
  id                String   @id @default(cuid())
  exporter_org_id   String
  bank_name         String
  branch_name       String?
  branch_address    String?
  ifsc              String?
  swift_bic         String?
  ad_code           String?
  account_reference String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  exporter_org               ExporterOrg               @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  trade_finance_instructions TradeFinanceInstruction[]

  @@index([exporter_org_id, is_active])
}

/// Deal-scoped instructions for negotiable instruments and bank presentation. These are
/// operational trade-finance facts, not renderer payload fields.
model TradeFinanceInstruction {
  id                       String  @id @default(cuid())
  deal_id                  String  @unique
  payment_id               String?
  exporter_bank_account_id String?

  bill_type        BillOfExchangeType?
  tenor_days       Int?
  place_of_drawing String?
  drawn_on_date    DateTime?

  bank_presentation_type  BankPresentationType?
  collection_instructions String?
  charges_instruction     String?
  payment_reference       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal                  Deal                   @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  payment               Payment?               @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  exporter_bank_account ExporterBankAccount?   @relation(fields: [exporter_bank_account_id], references: [id], onDelete: SetNull)
  presentation_items    BankPresentationItem[]

  @@index([payment_id])
  @@index([exporter_bank_account_id])
}

/// Documents deliberately enclosed in a bank presentation, bound to immutable Document
/// versions rather than free-typed names.
model BankPresentationItem {
  id                           String   @id @default(cuid())
  trade_finance_instruction_id String
  document_id                  String
  original_count               Int      @default(0)
  copy_count                   Int      @default(0)
  created_at                   DateTime @default(now())

  trade_finance_instruction TradeFinanceInstruction @relation(fields: [trade_finance_instruction_id], references: [id], onDelete: Cascade)
  document                  Document                @relation(fields: [document_id], references: [id], onDelete: Restrict)

  @@unique([trade_finance_instruction_id, document_id])
  @@index([document_id])
}

model InsuranceCase {
  id          String  @id @default(cuid())
  deal_id     String
  shipment_id String?

  status InsuranceCaseStatus @default(not_started)

  provider_name String?
  policy_ref    String?

  // money
  premium_amount   Decimal? @db.Decimal(18, 4)
  premium_currency String?  @db.VarChar(3)
  covered_amount   Decimal? @db.Decimal(18, 4)
  covered_currency String?  @db.VarChar(3)

  quote_requested_at DateTime?
  bound_at           DateTime?
  claim_opened_at    DateTime?
  claim_settled_at   DateTime?
  notes              String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal Deal @relation(fields: [deal_id], references: [id], onDelete: Cascade)

  @@index([deal_id])
}

model Dispute {
  id         String    @id @default(cuid())
  scope_type ScopeType
  scope_id   String

  deal_id     String?
  shipment_id String?
  payment_id  String?
  document_id String?

  type     DisputeType
  severity DisputeSeverity @default(medium)
  status   DisputeStatus   @default(open)

  owner_user_id String?
  /// User-safe summary. Internal notes live in InternalNote, never here.
  summary       String
  resolution    String?
  accepted_at   DateTime?
  /// docs/07 §7.7 `investigating -> waiting_external` requires "waiting party + follow-up
  /// date". `waiting_on` is the party/reason (mirrors Task.waiting_on); `sla_due_at`
  /// doubles as the follow-up date while waiting_external.
  waiting_on    String?
  sla_due_at    DateTime?
  closed_at     DateTime?
  /// AC03 (OPS-06): closure records its outcome basis distinctly from the resolution
  /// text itself — "accepted by the exporter" vs "closed on another authorized basis"
  /// are different facts, and collapsing them into `resolution` would lose which one
  /// actually happened.
  closure_basis String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner          User?          @relation(fields: [owner_user_id], references: [id])
  deal           Deal?          @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  shipment       Shipment?      @relation(fields: [shipment_id], references: [id])
  payment        Payment?       @relation(fields: [payment_id], references: [id])
  document       Document?      @relation(fields: [document_id], references: [id])
  internal_notes InternalNote[]
  payouts        Payout[]

  @@index([status, severity])
  @@index([deal_id])
  @@index([owner_user_id, status])
}

// ---------------------------------------------------------------------------
// Agent payout — AGT-08 / OPS-05
// ---------------------------------------------------------------------------

/// docs/06 OPS-05: "Not eligible | Explain dependency". `not_eligible` is a real
/// persisted state, not the absence of a row: a deal that has an agent and a locked
/// snapshot but whose payment has not realized needs somewhere to record WHY it is not
/// yet payable, which "no row at all" cannot express.
enum PayoutState {
  not_eligible
  eligible
  approved
  paid
  disputed
}

/// Agent commission record — AGT-08-AC02 / OPS-05-AC02.
///
/// Same immutability discipline as DealSnapshot: the money columns below are a SNAPSHOT
/// taken at the moment the payout became eligible, never a live join back to FeePolicy.
/// A later fee-policy version (OPS-07 can create one at any time) must never silently
/// restate what an agent was already told they had earned — which is exactly what a
/// recalculate-on-read design would do.
///
/// Note the deliberate redundancy with `Deal.quoted_fee_policy`: that snapshot is frozen
/// at deal LOCK, this one at payout ELIGIBILITY, and the two are different moments. The
/// agent share rate is copied here rather than read through the deal because an agent
/// can be reassigned between those moments, and the payout must record the rate that
/// applied to the agent who actually earned it.
///
/// Immutable in practice, not just by convention: no route exposes a PATCH of the
/// snapshot columns, and corrections are additive `PayoutAdjustment` rows (OPS-05-AC03).
model Payout {
  id            String @id @default(cuid())
  deal_id       String
  agent_user_id String

  state PayoutState @default(not_eligible)

  // --- Immutable snapshot, written once at eligibility ---------------------
  /// The realized shipment/deal value the fee was computed from.
  basis_amount         Decimal @db.Decimal(18, 4)
  basis_currency       String  @db.VarChar(3)
  /// ClearTrade's own success fee on that basis — the pool the agent share comes out of.
  fee_amount           Decimal @db.Decimal(18, 4)
  fee_currency         String  @db.VarChar(3)
  /// Which fee rule produced `fee_amount` (success_fee | small_shipment_rate | small_shipment_flat).
  fee_rule             String?
  /// Stored as a string, not a float: this is a rate of record, and re-parsing a
  /// serialized float is how a 0.4 becomes a 0.39999999999999997 in a payout dispute.
  agent_share_rate     String
  /// agent_share_rate x fee_amount, computed once and stored — never re-derived on read.
  amount               Decimal @db.Decimal(18, 4)
  currency             String  @db.VarChar(3)
  /// FeePolicy.version the snapshot came from — the audit trail back to the source rates.
  fee_policy_version   Int
  /// Full calculation breakdown, so the math is auditable without re-running it
  /// ("make the math auditable so compensation disputes don't become an ops burden").
  calculation_snapshot Json

  // --- Lifecycle -----------------------------------------------------------
  /// Why this payout is not yet eligible, in plain language (OPS-05 "explain dependency").
  ineligible_reason String?
  /// Which configured eligibility rule was satisfied, recorded at the moment it was.
  eligibility_rule  String?
  eligible_at       DateTime?
  approved_at       DateTime?
  approved_by_id    String?
  paid_at           DateTime?
  /// Bank/transfer reference recorded when finance marks it paid.
  payment_reference String?
  /// Set when the agent (or finance) raises a payout query — links to the Dispute case.
  dispute_id        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  deal        Deal               @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  agent       User               @relation("PayoutAgent", fields: [agent_user_id], references: [id])
  approved_by User?              @relation("PayoutApprovedBy", fields: [approved_by_id], references: [id])
  dispute     Dispute?           @relation(fields: [dispute_id], references: [id])
  adjustments PayoutAdjustment[]

  /// One payout per (deal, agent). A deal reassigned to a second agent gets a second
  /// row rather than overwriting the first — the original agent's record survives.
  @@unique([deal_id, agent_user_id])
  @@index([agent_user_id, state])
  @@index([state])
}

/// OPS-05-AC03: "Adjustments are additive/audited, not destructive rewrites."
///
/// A correction NEVER updates `Payout.amount`. It appends a signed delta here, and the
/// net payable is `Payout.amount + sum(adjustments.amount)` — computed at render time
/// from rows that each carry their own reason and author. That makes the original quote
/// permanently readable next to what changed it, which is the whole point of the rule.
model PayoutAdjustment {
  id        String @id @default(cuid())
  payout_id String

  /// Signed: negative for a clawback/waiver, positive for a bonus/correction.
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  reason        String
  created_by_id String
  created_at    DateTime @default(now())

  payout     Payout @relation(fields: [payout_id], references: [id], onDelete: Cascade)
  created_by User   @relation("PayoutAdjustmentAuthor", fields: [created_by_id], references: [id])

  @@index([payout_id])
}

// ---------------------------------------------------------------------------
// Communication — exporter-visible vs internal are separate tables, not a flag
// ---------------------------------------------------------------------------

model Message {
  id              String  @id @default(cuid())
  thread_key      String
  deal_id         String?
  buyer_lead_id   String?
  exporter_org_id String

  author_user_id String
  body           String
  /// Structurally exporter-visible. Internal content cannot be stored here.
  created_at     DateTime  @default(now())
  read_at        DateTime?

  author     User       @relation(fields: [author_user_id], references: [id])
  deal       Deal?      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  buyer_lead BuyerLead? @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)

  @@index([thread_key, created_at])
  @@index([exporter_org_id])
}

/// Never exporter-visible. A separate table so there is no toggle that can default open
/// (AGENTS.md: leakage of internal negotiation notes is a top trust risk).
model InternalNote {
  id            String    @id @default(cuid())
  scope_type    ScopeType
  scope_id      String
  deal_id       String?
  buyer_lead_id String?
  dispute_id    String?

  author_user_id String
  body           String
  created_at     DateTime @default(now())

  author     User       @relation(fields: [author_user_id], references: [id])
  deal       Deal?      @relation(fields: [deal_id], references: [id], onDelete: Cascade)
  buyer_lead BuyerLead? @relation(fields: [buyer_lead_id], references: [id], onDelete: Cascade)
  dispute    Dispute?   @relation(fields: [dispute_id], references: [id], onDelete: Cascade)

  @@index([scope_type, scope_id])
}

// ---------------------------------------------------------------------------
// Governance & platform
// ---------------------------------------------------------------------------

model Notification {
  id          String               @id @default(cuid())
  user_id     String
  type        String
  title       String
  body        String
  severity    NotificationSeverity @default(info)
  object_type String?
  object_id   String?
  /// A deep link is a convenience, not an authorization grant — the target still authorizes.
  deep_link   String?
  read_at     DateTime?
  dedupe_key  String?
  created_at  DateTime             @default(now())

  user       User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([user_id, dedupe_key])
  @@index([user_id, read_at, created_at])
}

model NotificationDelivery {
  id                    String                     @id @default(cuid())
  notification_id       String
  channel               NotificationChannel
  destination_reference String
  template_key          String
  template_version      String
  status                NotificationDeliveryStatus @default(queued)
  attempt_count         Int                        @default(0)
  provider              String?
  provider_message_id   String?
  queued_at             DateTime                   @default(now())
  sent_at               DateTime?
  delivered_at          DateTime?
  failed_at             DateTime?
  next_retry_at         DateTime?
  last_error_code       String?
  last_error_message    String?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  notification Notification                  @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  attempts     NotificationDeliveryAttempt[]

  @@unique([notification_id, channel])
  @@index([status, next_retry_at])
}

model NotificationDeliveryAttempt {
  id                  String                     @id @default(cuid())
  delivery_id         String
  attempt_no          Int
  provider            String
  status              NotificationDeliveryStatus
  provider_message_id String?
  error_code          String?
  error_message       String?
  started_at          DateTime                   @default(now())
  finished_at         DateTime?

  delivery NotificationDelivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade)

  @@unique([delivery_id, attempt_no])
}

/// EXP-17: per-user, per-category channel toggle. Only categories that
/// `NOTIFICATION_CATEGORIES[key].disableable` allows get a row here — the "critical
/// legal/security notifications may be non-disableable" rule (docs/04) is enforced by
/// `src/lib/notifications.ts` refusing to write a preference row for a non-disableable
/// category at all, rather than writing one and hoping every read site remembers to
/// ignore it.
model NotificationPreference {
  id             String   @id @default(cuid())
  user_id        String
  category       String
  email_enabled  Boolean  @default(true)
  in_app_enabled Boolean  @default(true)
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category])
}

/// EXP-17 Team: an invitation is a distinct object from a User row on purpose — "Invite
/// pending" is a required UI state (docs/04) with its own visible status and
/// resend/revoke actions, which a directly-created inactive User could not represent
/// cleanly (a User has no "pending" concept, and password_hash-null already means
/// something else — a guest).
model Invitation {
  id              String           @id @default(cuid())
  exporter_org_id String
  email           String
  role            UserRole
  status          InvitationStatus @default(pending)
  token           String           @unique

  invited_by_id String
  expires_at    DateTime
  accepted_at   DateTime?
  revoked_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exporter_org ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  invited_by   User        @relation("InvitationInviter", fields: [invited_by_id], references: [id])

  @@index([exporter_org_id, status])
  @@index([email, status])
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// Append-only. The application layer exposes no update or delete path; corrections
/// are new events (docs/08 §2).
model AuditEvent {
  id              String      @id @default(cuid())
  actor_user_id   String?
  role            UserRole?
  action          String
  object_type     String
  object_id       String
  /// Denormalized for tenant-scoped audit reads without joining through the object graph.
  exporter_org_id String?
  timestamp       DateTime    @default(now())
  before_summary  Json?
  after_summary   Json?
  correlation_id  String
  source          AuditSource @default(web)

  actor User? @relation(fields: [actor_user_id], references: [id])

  @@index([object_type, object_id, timestamp])
  @@index([actor_user_id, timestamp])
  @@index([exporter_org_id, timestamp])
  @@index([correlation_id])
}

/// DB-backed job queue — no external broker. State survives refresh and device change
/// because it lives here, not in browser memory (docs/09 §3).
model Job {
  id              String    @id @default(cuid())
  type            JobType
  status          JobStatus @default(queued)
  exporter_org_id String?
  requested_by_id String?
  /// Dedupe key for "an equivalent job is already running" (JOB_ALREADY_RUNNING).
  dedupe_key      String?
  idempotency_key String?
  payload         Json      @default("{}")
  result          Json?
  error_code      String?
  error_message   String?
  progress        Int       @default(0)
  /// Durable orchestration stage for multi-step jobs. Numeric progress remains for generic UI.
  progress_stage  String?
  /// Internal resumability checkpoint. Never exposed as a result while work is in flight.
  checkpoint      Json?
  target_type     String?
  target_id       String?
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  run_after       DateTime  @default(now())
  started_at      DateTime?
  completed_at    DateTime?
  correlation_id  String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  requested_by User?        @relation(fields: [requested_by_id], references: [id])
  job_attempts JobAttempt[]

  @@unique([dedupe_key])
  @@unique([idempotency_key])
  @@index([status, run_after])
  @@index([exporter_org_id, type, status])
}

/// Retry creates a new attempt row; a historical successful result is never overwritten.
model JobAttempt {
  id            String    @id @default(cuid())
  job_id        String
  attempt_no    Int
  status        JobStatus @default(processing)
  started_at    DateTime  @default(now())
  finished_at   DateTime?
  error_code    String?
  error_message String?
  result        Json?

  job Job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, attempt_no])
}

model WorkerHeartbeat {
  id                   String    @id
  instance_id          String
  status               String
  active_job_id        String?
  last_seen_at         DateTime
  last_error_at        DateTime?
  last_error           String?
  consecutive_failures Int       @default(0)
  started_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  @@index([last_seen_at])
}

/// Per-IP quota for guest-tier AI runs. Guests can spend real money on AI jobs before
/// they have any account, so the counter is keyed on the caller's network identity, not
/// on the guest row — a cleared cookie mints a new org, but the IP is unchanged.
///
/// `ip_hash` is HMAC-SHA256(ip, GUEST_IP_HASH_SECRET), never the raw address: an IP is
/// personal data, and an unkeyed hash of a 32-bit space is trivially reversible.
///
/// The window is rolling-daily rather than lifetime on purpose. Indian mobile carriers
/// use CGNAT, so one address fronts very large numbers of real users — a lifetime cap
/// would permanently lock out legitimate prospects in the primary market.
model GuestRunQuota {
  id           String   @id @default(cuid())
  ip_hash      String
  window_start DateTime
  runs_used    Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([ip_hash, window_start])
  @@index([window_start])
}

/// Business constants live here, versioned — never hardcoded in application code
/// (docs/01 §2). Reads go through src/lib/config.ts.
model ConfigSetting {
  id             String   @id @default(cuid())
  key            String
  version        Int      @default(1)
  value          Json
  description    String?
  is_active      Boolean  @default(true)
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([key, version])
  @@index([key, is_active])
}

/// Versioned fee policy. A deal snapshots the version in force at lock time; later
/// versions never rewrite historical deals.
/// A recurring membership between one exporter tenant and the payment gateway.
///
/// WHY THIS IS A TABLE AND NOT THREE COLUMNS ON ExporterOrg: a membership has history.
/// A tenant subscribes, lapses, and resubscribes on a different plan; ops needs to see
/// that sequence, and a webhook that arrives late must be applied to the subscription it
/// names rather than to "whatever the org is on now". Collapsing it onto the org would
/// make a late `subscription.halted` for a CANCELLED subscription silently revoke a NEW,
/// healthy one.
///
/// Money is amount + currency, like every other money value in this schema. There is no
/// bare numeric column here and there must never be one.
///
/// This does NOT replace `ExporterOrg.commitment_fee_*` (docs/01 §2). Both can grant
/// `paid`: the fee is a one-time, non-expiring grant (and the Ops waiver path), this is a
/// time-bounded recurring one. `resolveTier()` is the single place that resolves the two
/// into one tier.
model Subscription {
  id              String      @id @default(cuid())
  exporter_org_id String
  exporter_org    ExporterOrg @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)

  plan_code SubscriptionPlanCode
  provider  SubscriptionProvider @default(razorpay)
  status    SubscriptionStatus   @default(created)

  /// Razorpay's `sub_...` id. Unique because a webhook is dispatched by this id and must
  /// resolve to exactly one row — two rows sharing it would make delivery ambiguous.
  /// Null only for `provider = manual`, which has no gateway object behind it.
  provider_subscription_id String? @unique
  provider_customer_id     String?
  /// Razorpay's `plan_...` id, snapshotted so we can tell which provider-side plan this
  /// subscription was actually created against even after the env var is repointed.
  provider_plan_id         String?

  /// Price AT THE MOMENT OF SUBSCRIBING — never re-read from the live catalogue. Same
  /// "rule of record" the commitment fee and deal-quoted terms follow: repricing the
  /// catalogue must never retroactively change what an existing member agreed to pay.
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(3)

  current_period_start DateTime?
  /// Paid-through date. Copied onto `ExporterOrg.paid_until` — see the note there for why
  /// entitlement is stored rather than derived from `status` at read time.
  current_period_end   DateTime?

  /// The member asked to stop but has already paid through `current_period_end`. Access
  /// continues until then; this is why cancellation is not the same fact as expiry.
  cancel_at_period_end Boolean   @default(false)
  cancelled_at         DateTime?
  ended_at             DateTime?

  /// Razorpay's hosted authorization page. This is the URL the Upgrade button redirects
  /// to; retained so an abandoned checkout can be resumed rather than restarted.
  short_url String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  events SubscriptionEvent[]

  @@index([exporter_org_id, created_at])
  @@index([status])
}

/// Append-only log of every provider webhook applied to a subscription.
///
/// Two jobs, both load-bearing:
///   - IDEMPOTENCY. Razorpay retries webhooks and does not guarantee once-only delivery.
///     `provider_event_id` is unique, so a replayed event is rejected by the database
///     rather than by application logic that could race with itself.
///   - RECONSTRUCTION. When a member disputes what they were charged, the ordered event
///     log is the record — the mutable `Subscription` row only shows the end state.
model SubscriptionEvent {
  id              String       @id @default(cuid())
  subscription_id String
  subscription    Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  /// Razorpay's `x-razorpay-event-id` header. Unique — this IS the idempotency key.
  provider_event_id String             @unique
  event_type        String
  /// Status the subscription moved to as a result, so the log is readable without
  /// re-parsing the raw payload.
  resulting_status  SubscriptionStatus
  payload           Json

  received_at DateTime @default(now())

  @@index([subscription_id, received_at])
}

model FeePolicy {
  id      String @id @default(cuid())
  version Int    @unique

  commitment_fee_amount   Decimal             @db.Decimal(18, 4)
  commitment_fee_currency String              @db.VarChar(3)
  commitment_fee_status   CommitmentFeeStatus @default(not_due)

  success_fee_rate Decimal @db.Decimal(6, 4)

  small_shipment_threshold_amount   Decimal @db.Decimal(18, 4)
  small_shipment_threshold_currency String  @db.VarChar(3)
  small_shipment_rate               Decimal @db.Decimal(6, 4)
  small_shipment_flat_amount        Decimal @db.Decimal(18, 4)

  agent_share_rate Decimal @db.Decimal(6, 4)

  minimum_shipment_amount   Decimal @db.Decimal(18, 4)
  minimum_shipment_currency String  @db.VarChar(3)

  is_active      Boolean  @default(true)
  effective_from DateTime @default(now())
  created_at     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trade data warehouse — deliberately separate from the canonical domain above.
//
// Precedent: GuestRunQuota / ConfigSetting / FeePolicy already live in their own section
// at the end of this file rather than beside Deal/Task/Document — infrastructural and
// bulk-external data does not belong in the same section as the objects a user's request
// directly reads and writes. TradeFlow follows that precedent: it is warehouse input for
// future scoring, not a domain object anyone transacts against.
// ---------------------------------------------------------------------------

enum TradeFlowDirection {
  import
  export
}

enum TradeDataSource {
  comtrade
  cbp_vessel_manifest
}

/// How a warehouse row was obtained. `legacy_unknown` is intentionally distinct from every
/// usable client mode: pre-provenance development rows cannot be promoted to authenticated data.
enum TradeSourceMode {
  legacy_unknown
  fixture
  mock
  preview
  authenticated
  public_real
  imported_real
  manually_entered_real
}

/// Cross-domain evidence origin. Provider-specific transport details remain on the
/// source record; this enum answers the enforcement question: may this evidence enter a
/// real customer workflow in the current deployment environment?
enum EvidenceOrigin {
  unknown_legacy
  fixture
  mock
  preview
  authenticated_real
  public_real
  imported_real
  manually_entered_real
}

/// Epistemic ownership of a fact. This is deliberately orthogonal to EvidenceOrigin:
/// `public_real` says a row may serve in production, while `authoritative_public` says who
/// actually stands behind the assertion. A partner quote and an exporter declaration can both
/// be real production evidence without becoming public-authority facts.
/// A destination's national tariff line for one product, and how it was arrived at.
///
/// HS6 is a classification of goods; a national tariff line is a DECLARABLE code, and the step
/// between them is a judgement about the actual product. This record exists so that judgement is
/// never implicit: it keeps the full candidate set the authority returned, which line was
/// selected, on what basis, by whom, and how strongly that is verified.
///
/// Nothing here selects a line automatically. `refinement_required` is a legitimate terminal
/// state and is what HS 100630 currently resolves to in the UK and US.
model ProductClassificationRefinement {
  id                        String  @id @default(cuid())
  exporter_org_id           String
  product_id                String
  product_classification_id String
  /// The frozen HS6 every candidate must sit beneath.
  hs6_code                  String
  hs_revision               String
  destination_country       String  @db.VarChar(2)
  national_code_system      String
  /// The snapshot whose candidate set this refinement is answering.
  source_snapshot_id        String?

  /// unresolved | refinement_required | exporter_declared_selection | agent_verified_selection |
  /// authoritative_verified | superseded.
  state                  String  @default("unresolved")
  /// Every candidate the authority returned, with the description and duty that distinguishes it.
  candidate_lines        Json
  candidate_count        Int
  /// Null in every state except a selection. Always one of `candidate_lines`.
  selected_national_code String?
  /// Why this line and not its siblings, in product terms.
  selection_rationale    String?
  /// The product attributes that determined it, so the decision can be re-derived.
  deciding_attributes    Json?
  /// Distinguishing questions still outstanding before a line can be chosen.
  outstanding_questions  Json?

  source_authority String
  source_reference String
  effective_from   DateTime?
  effective_to     DateTime?

  decided_by_id    String?
  decided_at       DateTime?
  evidence_origin  EvidenceOrigin         @default(unknown_legacy)
  assertion_class  EvidenceAssertionClass @default(unknown_legacy)
  /// Refinements are append-only: a revision supersedes rather than rewrites, so an assessment
  /// that cited the previous state stays readable.
  superseded_at    DateTime?
  superseded_by_id String?
  created_at       DateTime               @default(now())

  exporter_org           ExporterOrg                       @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  product                Product                           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_classification ProductClassification             @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  decided_by             User?                             @relation("ClassificationRefinementDecider", fields: [decided_by_id], references: [id], onDelete: SetNull)
  superseded_by          ProductClassificationRefinement?  @relation("ClassificationRefinementSupersession", fields: [superseded_by_id], references: [id], onDelete: SetNull)
  supersedes             ProductClassificationRefinement[] @relation("ClassificationRefinementSupersession")

  @@index([exporter_org_id, product_id, destination_country, created_at])
  @@index([product_classification_id, destination_country, state])
}

/// One operational cost input to Export Economics, as somebody actually stated it.
///
/// Deliberately ONE model rather than five near-identical ones: a CHA quote, an inland haulage
/// quote, a cargo insurance quote, a financing estimate and a destination handling quote differ
/// in which fields are populated, not in what they are — a priced, dated, attributable
/// assertion about one cost component. Fields that genuinely belong to one kind of quote
/// (carrier, equipment, coverage) are explicit columns rather than being flattened into JSON.
///
/// Immutable. A revised quote is a new row that supersedes its predecessor, so an assessment
/// that used the old figure keeps meaning what it meant.
model OperationalCostEvidence {
  id                        String  @id @default(cuid())
  exporter_org_id           String
  product_id                String?
  product_classification_id String?
  /// Destination this cost was quoted for. Null only for origin-side costs that do not vary by
  /// destination; selection still requires an explicit match or an explicit null.
  destination_country       String? @db.VarChar(2)
  hs6_code                  String?
  hs_revision               String?

  /// One of the eight Export Economics cost components.
  component  String
  /// cha | inland_transport | cargo_insurance | financing | destination_handling | packaging |
  /// international_freight | cleartrade_fee. Narrows `component` to the kind of quote it is.
  quote_type String

  amount           Decimal  @db.Decimal(18, 4)
  currency         String   @db.VarChar(3)
  /// The quantity this amount is FOR: per_unit | per_kg | per_shipment | per_container |
  /// percent_of_value. Never assumed.
  rate_basis       String
  /// The unit `rate_basis` counts in, when it counts something (kg, MT, CTN, 20FT_DRY).
  quantity_unit    String?
  /// Populated only for percent_of_value bases.
  percent_of_value Decimal? @db.Decimal(9, 4)
  /// The basis a percentage applies to, e.g. cif_value or invoice_value.
  percent_basis    String?

  /// Which Incoterm party owns this cost. Recorded so a buyer-paid cost cannot silently enter
  /// exporter economics.
  cost_owner String @default("exporter")

  /// Route/partner context, populated for the quote kinds that have it.
  route_evidence_id String?
  transport_mode    String?
  equipment_code    String?
  carrier_name      String?
  partner_name      String?
  quote_reference   String?
  /// Insurance-specific: what the cover actually is.
  coverage_terms    String?
  coverage_percent  Decimal? @db.Decimal(6, 2)

  observed_at    DateTime
  effective_from DateTime
  /// An operational quote without an expiry is not open-ended: selection requires validity.
  valid_until    DateTime?

  assertion_class  EvidenceAssertionClass
  evidence_origin  EvidenceOrigin
  source           String
  source_reference String
  document_id      String?
  entered_by_id    String?
  verified_by_id   String?
  verified_at      DateTime?
  /// Frozen identity of the policy a system-derived amount came from (currently FeePolicy).
  derivation       Json?
  confidence       Decimal                @db.Decimal(5, 4)
  status           String                 @default("verified")
  superseded_at    DateTime?
  superseded_by_id String?
  raw_evidence     Json?
  created_at       DateTime               @default(now())

  exporter_org  ExporterOrg               @relation(fields: [exporter_org_id], references: [id], onDelete: Cascade)
  product       Product?                  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  entered_by    User?                     @relation("OperationalCostEnteredBy", fields: [entered_by_id], references: [id], onDelete: SetNull)
  verified_by   User?                     @relation("OperationalCostVerifiedBy", fields: [verified_by_id], references: [id], onDelete: SetNull)
  superseded_by OperationalCostEvidence?  @relation("OperationalCostSupersession", fields: [superseded_by_id], references: [id], onDelete: SetNull)
  supersedes    OperationalCostEvidence[] @relation("OperationalCostSupersession")

  @@index([exporter_org_id, destination_country, component, valid_until])
  @@index([exporter_org_id, product_id, component, status])
  @@index([route_evidence_id])
}

/// How a destination values goods for customs, and on what authority.
///
/// Deliberately separate from the trade-statistical import valuation basis: a country may
/// report import statistics on one basis and assess duty on another, and conflating them puts a
/// duty on the wrong base. Only an authoritative citation may establish either.
model CustomsValuationBasisEvidence {
  id                  String                 @id @default(cuid())
  jurisdiction        String
  country_code        String                 @db.VarChar(2)
  /// legal_customs_valuation | trade_statistical_import_valuation. The two are recorded
  /// separately and are never substituted for one another.
  valuation_type      String
  /// CIF | FOB | CIP | other, as the source states it.
  basis               String
  included_components String[]               @default([])
  excluded_components String[]               @default([])
  source_authority    String
  source_reference    String
  source_version      String?
  effective_from      DateTime
  effective_to        DateTime?
  observed_at         DateTime
  retrieved_at        DateTime
  /// discovery_grade | execution_grade.
  verification_grade  String                 @default("discovery_grade")
  assertion_class     EvidenceAssertionClass
  evidence_origin     EvidenceOrigin
  recorded_by_id      String?
  confidence          Decimal                @db.Decimal(5, 4)
  status              String                 @default("verified")
  superseded_at       DateTime?
  notes               String?
  raw_evidence        Json?
  created_at          DateTime               @default(now())

  recorded_by User? @relation("CustomsValuationRecorder", fields: [recorded_by_id], references: [id], onDelete: SetNull)

  @@unique([country_code, valuation_type, basis, effective_from, source_reference], map: "CustomsValuationBasisEvidence_identity_key")
  @@index([country_code, valuation_type, effective_from])
}

enum EvidenceAssertionClass {
  authoritative_public
  exporter_declared
  agent_verified
  partner_quote
  /// Computed by ClearTrade from its own versioned policy (currently the ClearTrade fee from
  /// FeePolicy). Not an observation of the world, so it is not authoritative_public; not a
  /// claim by a party, so it is not a declaration or a quote.
  system_derived
  /// Supplied under commercial licence by a specialist trade-content provider that attributes the
  /// fact to a customs authority or treaty, but which ClearTrade did not obtain from that
  /// authority directly. The vendor is a secondary distributor, so this is never
  /// authoritative_public no matter how faithful the reproduction or how much it cost. Usable
  /// only where `licensed-providers.ts` records an approval covering the provider, dataset,
  /// destination and assertion type.
  licensed_authoritative_content
  unknown_legacy
}

enum IngestStatus {
  running
  throttled
  completed
  failed
  partial
}

/// Raw UN Comtrade trade flow rows — the warehouse layer, not the product domain.
///
/// SERVER-SIDE ONLY, NON-NEGOTIABLE: no API route may ever return rows of this model to a
/// client, in whole or in projection. Comtrade's subscription terms license this data for
/// Internal Use only — it may not be redistributed or re-served. Only computed scores and
/// derived aggregates built ON TOP of this table (e.g. a future market-scoring job's
/// output) are allowed to cross the API boundary. Enforced by omission: there is no
/// `/api/v1/trade-flows` route, and there must never be one. `scripts/verify-comtrade-
/// ingest.ts` greps the route tree for references to this model to keep that true.
///
/// `reporter`/`partner` are stored as Comtrade's own numeric reporter/partner codes
/// (e.g. "699" for India, "0" for World), not ISO country codes — Comtrade's API takes
/// and returns these codes directly, and re-mapping them to ISO here would be an
/// unverified translation this warehouse layer has no business doing.
///
/// Idempotency key is `(reporter, partner, hs_code, year, source)` per spec — it does not
/// include `period` (sub-year periods are a later concern; the free tier ingested here is
/// annual) or `flow_direction` (a single ingest run is scoped to one flow direction; an
/// import and an export series for the same reporter/partner/code/year are two different
/// questions, but only one may be stored per key today — extend the key before ever
/// ingesting both directions for the same series).
model TradeFlow {
  id                     String             @id @default(cuid())
  reporter               String
  partner                String
  hs_code                String
  year                   Int
  period                 String
  value                  Decimal            @db.Decimal(20, 3)
  quantity               Decimal?           @db.Decimal(18, 3)
  unit                   String?
  /// value / quantity, computed once at ingest time. Null when quantity is null or zero.
  unit_value             Decimal?           @db.Decimal(18, 6)
  flow_direction         TradeFlowDirection
  source                 TradeDataSource
  /// Queryable, immutable acquisition provenance. Legacy rows are deliberately unknown.
  provider               String             @default("unverified_legacy")
  source_mode            TradeSourceMode    @default(legacy_unknown)
  ingest_run_id          String?
  retrieved_at           DateTime
  request_batch_id       String?
  source_dataset         String?
  source_dataset_version String?
  ingested_at            DateTime           @default(now())

  ingest_run   IngestRun?             @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  acquisitions TradeFlowAcquisition[]

  @@unique([reporter, partner, hs_code, year, flow_direction, source])
  @@index([hs_code, year])
  @@index([ingest_run_id])
  @@index([provider, source_mode, retrieved_at])
}

/// Immutable observation ledger. TradeFlow is the current warehouse projection; this record
/// preserves every exact run/batch/value observation when the projection is refreshed.
model TradeFlowAcquisition {
  id                     String             @id @default(cuid())
  trade_flow_id          String
  ingest_run_id          String
  reporter               String
  partner                String
  hs_code                String
  year                   Int
  period                 String
  flow_direction         TradeFlowDirection
  source                 TradeDataSource
  value                  Decimal            @db.Decimal(20, 3)
  quantity               Decimal?           @db.Decimal(18, 3)
  unit                   String?
  unit_value             Decimal?           @db.Decimal(18, 6)
  provider               String
  source_mode            TradeSourceMode
  retrieved_at           DateTime
  request_batch_id       String
  source_dataset         String?
  source_dataset_version String?
  created_at             DateTime           @default(now())

  trade_flow             TradeFlow                   @relation(fields: [trade_flow_id], references: [id], onDelete: Restrict)
  ingest_run             IngestRun                   @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  normalized_observation NormalizedTradeObservation?

  @@unique([ingest_run_id, reporter, partner, hs_code, year, flow_direction, source])
  @@index([trade_flow_id, retrieved_at])
  @@index([provider, source_mode, retrieved_at])
}

/// One execution of a warehouse ingest job. Deliberately a separate status axis from
/// `Job.status`: a caught, recorded ingest failure (rate limit exhausted, malformed
/// response) still lets the JOB report `completed` — the job system did its job by
/// running the handler to completion — while THIS row is the true record of whether the
/// domain-level ingest actually produced data. Never collapse the two, same reasoning as
/// Job state vs. Task/SLA state elsewhere in this schema.
model IngestRun {
  id                         String          @id @default(cuid())
  source                     TradeDataSource
  provider                   String          @default("unverified_legacy")
  client_mode                TradeSourceMode @default(legacy_unknown)
  authenticated              Boolean         @default(false)
  /// SHA-256 identity for a high-entropy provider credential; never the credential itself.
  credential_fingerprint     String?
  source_dataset             String?
  source_dataset_version     String?
  code_range                 String?
  batch_size                 Int?
  status                     IngestStatus    @default(running)
  /// What was actually requested (hs_chapter, reporter, partner(s), year, flow_direction)
  /// — kept so a failed or partial run is legible without cross-referencing the Job row.
  params                     Json?
  records_written            Int             @default(0)
  records_total              Int?
  records_processed          Int             @default(0)
  total_codes                Int             @default(0)
  completed_codes            Int             @default(0)
  request_count              Int             @default(0)
  throttle_count             Int             @default(0)
  provider_throttle_count    Int             @default(0)
  local_quota_throttle_count Int             @default(0)
  /// Durable ordered HS6 list and next offset. A retry resumes this run in place.
  progress                   Json?
  last_throttled_at          DateTime?
  retry_after                DateTime?
  started_at                 DateTime        @default(now())
  completed_at               DateTime?
  error                      String?

  trade_flows             TradeFlow[]
  trade_flow_acquisitions TradeFlowAcquisition[]
  source_evidence         SourceEvidence[]
  import_records          ImportRecord[]

  @@index([source, started_at])
  @@index([provider, client_mode, started_at])
}

/// Immutable provider response. Exact response text is retained in PostgreSQL because Country
/// Truth requests are deliberately bounded HS6 batches; the checksum makes later object-storage
/// migration content-addressable without changing evidence identity.
model SourceEvidence {
  id                    String                     @id @default(cuid())
  ingest_run_id         String?
  provider              String
  dataset               String
  dataset_version       String?
  source_origin         EvidenceOrigin
  environment           String
  request_fingerprint   String
  request_parameters    Json
  redacted_request      String
  http_status           Int
  response_checksum     String
  raw_response_text     String
  retrieved_at          DateTime
  provider_row_count    Int?
  returned_row_count    Int
  completeness          EvidenceCompletenessStatus
  completeness_metadata Json?
  quota_metadata        Json?
  parser_version        String
  status                String
  error_metadata        Json?
  created_at            DateTime                   @default(now())

  ingest_run                  IngestRun?                         @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  observations                NormalizedTradeObservation[]
  country_evidence_items      CountryEvidencePlanItem[]
  country_evidence_references CountryEvidenceManifestReference[]
  country_screening_results   CountryScreeningResult[]

  @@index([request_fingerprint, source_origin, retrieved_at])
  @@index([response_checksum])
}

/// Frozen acquisition intent for one confirmed HS classification. Each candidate reporter may be
/// analysed across its own consecutive window, ending at the latest year it actually reported.
/// Execution state lives on child items; the definition and policy snapshot are never recalculated.
model CountryEvidencePlan {
  id                        String          @id @default(cuid())
  plan_key                  String          @unique
  product_classification_id String
  hs_code                   String
  hs_revision               String
  as_of_date                DateTime
  candidate_reporters       String[]
  source_mode               TradeSourceMode
  policy_version            String
  policy_hash               String
  policy_snapshot           Json
  /// Union of every reporter's window. Individual reporters may cover different years.
  period_set                Int[]
  /// The newest year any reporter in this plan is analysed through.
  latest_common_year        Int
  requested_history_years   Int
  actual_history_years      Int
  /// Phase 1G: each reporter's own consecutive analysis window, ending at the latest year that
  /// reporter actually has usable evidence for. Null on plans built before per-reporter windows.
  reporter_period_windows   Json?
  /// The period the screen preferred. Per-reporter lag is measured against this.
  preferred_period          Int?
  candidate_strategy        String
  status                    String          @default("planned")
  estimated_call_cost       Int
  allow_partial_execution   Boolean         @default(false)
  /// The frozen Stage-A screening run whose shortlist produced this plan's candidate reporters.
  /// Nullable because the pilot request path names countries directly and has no screening run;
  /// when set it is the answer to "which global screen produced this Deep Country Truth?".
  screening_run_id          String?
  created_at                DateTime        @default(now())
  updated_at                DateTime        @updatedAt

  product_classification ProductClassification     @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  screening_run          CountryScreeningRun?      @relation(fields: [screening_run_id], references: [id], onDelete: SetNull)
  items                  CountryEvidencePlanItem[]
  manifests              CountryEvidenceManifest[]

  @@index([product_classification_id, created_at])
  @@index([status, created_at])
  @@index([screening_run_id])
}

/// One independently resolvable provider request in a Country Evidence Plan.
model CountryEvidencePlanItem {
  id                  String    @id @default(cuid())
  plan_id             String
  item_key            String    @unique
  purpose             String
  reporter_code       String
  partner_scope       String
  partner_code        String
  flow_direction      String
  frequency           String
  period              Int
  hs_code             String
  hs_revision         String
  customs_code        String
  mode_of_supply      String
  priority            Int
  freshness_days      Int
  estimated_call_cost Int       @default(1)
  resolution_state    String    @default("fetch_required")
  source_evidence_id  String?
  resolution_metadata Json?
  attempts            Int       @default(0)
  last_attempted_at   DateTime?
  error               String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  plan            CountryEvidencePlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  source_evidence SourceEvidence?     @relation(fields: [source_evidence_id], references: [id], onDelete: Restrict)

  @@index([plan_id, priority, reporter_code, period])
  @@index([resolution_state, updated_at])
}

/// Immutable evidence-set snapshot consumed by the later deterministic metric phase.
model CountryEvidenceManifest {
  id               String   @id @default(cuid())
  plan_id          String
  checksum         String   @unique
  evaluation_state String
  policy_version   String
  policy_hash      String
  policy_snapshot  Json
  manifest_payload Json
  created_at       DateTime @default(now())

  plan       CountryEvidencePlan                @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  references CountryEvidenceManifestReference[]
  metrics    CountryTradeMetrics[]

  @@index([plan_id, created_at])
}

/// Immutable factual calculations derived only from one frozen CountryEvidenceManifest.
model CountryTradeMetrics {
  id                        String   @id @default(cuid())
  manifest_id               String
  product_classification_id String
  reporter_code             String
  country_code              String?  @db.VarChar(2)
  hs_code                   String
  hs_revision               String
  as_of_date                DateTime
  period_set                Int[]
  latest_common_year        Int
  metric_policy_version     String
  metric_policy_hash        String
  metric_policy_snapshot    Json
  calculation_version       String
  metrics_payload           Json
  checksum                  String   @unique
  created_at                DateTime @default(now())

  manifest               CountryEvidenceManifest    @relation(fields: [manifest_id], references: [id], onDelete: Restrict)
  product_classification ProductClassification      @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  market_assessments     MarketAssessment[]
  fact_snapshots         CountryTruthFactSnapshot[]

  @@unique([manifest_id, reporter_code, metric_policy_hash, calculation_version])
  @@index([product_classification_id, reporter_code, created_at])
}

/// Immutable Phase 1H fact manifest for one exporter × product classification × country.
///
/// The payload contains typed first-party facts and selected external facts, never component or
/// overall scores. `snapshot_key` identifies the frozen question and selected evidence;
/// `facts_checksum` protects the canonical payload. A semantic change must use a new calculation
/// version or policy hash and therefore creates a new row instead of reinterpreting history.
model CountryTruthFactSnapshot {
  id                         String                   @id @default(cuid())
  snapshot_key               String                   @unique(map: "CountryTruthFactSnapshot_snapshot_key_key")
  schema_version             String
  calculation_version        String
  exporter_org_id            String
  product_id                 String
  product_classification_id  String
  country_trade_metrics_id   String
  reporter_code              String
  country_code               String                   @db.VarChar(2)
  hs_code                    String
  hs_revision                String
  as_of_date                 DateTime
  exporter_snapshot_checksum String
  selection_policy_version   Int
  selection_policy_hash      String
  selection_policy_snapshot  Json
  facts_payload              Json
  facts_checksum             String
  evidence_origins           EvidenceOrigin[]         @default([unknown_legacy])
  assertion_classes          EvidenceAssertionClass[] @default([unknown_legacy])
  created_at                 DateTime                 @default(now())

  exporter_org           ExporterOrg           @relation(fields: [exporter_org_id], references: [id], onDelete: Restrict)
  product                Product               @relation(fields: [product_id], references: [id], onDelete: Restrict)
  product_classification ProductClassification @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  country_trade_metrics  CountryTradeMetrics   @relation(fields: [country_trade_metrics_id], references: [id], onDelete: Restrict)
  market_assessments     MarketAssessment[]

  @@unique([country_trade_metrics_id, exporter_snapshot_checksum, selection_policy_hash, calculation_version], map: "CountryTruthFactSnapshot_input_identity_key")
  @@index([exporter_org_id, product_id, country_code, created_at], map: "CountryTruthFactSnapshot_org_product_country_created_idx")
  @@index([product_classification_id, reporter_code, as_of_date], map: "CountryTruthFactSnapshot_classification_reporter_as_of_idx")
  @@index([facts_checksum], map: "CountryTruthFactSnapshot_facts_checksum_idx")
}

model CountryEvidenceManifestReference {
  id                    String   @id @default(cuid())
  manifest_id           String
  plan_item_key         String
  purpose               String
  reporter_code         String
  period                Int
  source_evidence_id    String
  observation_ids       String[]
  cell_state            String
  freshness_state       String
  evidence_completeness String
  evidence_retrieved_at DateTime
  created_at            DateTime @default(now())

  manifest        CountryEvidenceManifest @relation(fields: [manifest_id], references: [id], onDelete: Restrict)
  source_evidence SourceEvidence          @relation(fields: [source_evidence_id], references: [id], onDelete: Restrict)

  @@unique([manifest_id, plan_item_key])
  @@index([source_evidence_id])
}

/// Frozen Stage A global screening intent for one confirmed classification and one annual period.
///
/// The definition, the country universe it evaluated and the policy that chose it are frozen at
/// creation; only execution state advances. A completed run and its results are immutable, so a
/// historical shortlist can always prove which countries were considered and on what evidence.
model CountryScreeningRun {
  id                               String          @id @default(cuid())
  run_key                          String          @unique
  product_classification_id        String
  hs_code                          String
  hs_revision                      String
  as_of_date                       DateTime
  /// The period this run PREFERS. Phase 1G lets each market resolve to an older usable year;
  /// the year actually used is `CountryScreeningResult.observation_period`.
  screening_period                 Int
  /// Frozen latest-usable-period policy. Execution reads this snapshot, never live config.
  period_selection_policy_version  String
  period_selection_policy_hash     String
  period_selection_policy_snapshot Json
  max_fallback_lookback_years      Int
  source_mode                      TradeSourceMode
  policy_version                   String
  policy_hash                      String
  policy_snapshot                  Json
  universe_version                 String
  universe_checksum                String
  universe_size                    Int
  /// Provider reporting identity frozen into the run. A reporter-reference refresh that moves
  /// any reporter code changes this, the universe checksum, the run key and every request
  /// fingerprint beneath it — so a completed run can never be reinterpreted under new codes.
  reporter_registry_version        String
  reporter_registry_checksum       String
  /// Full resolved universe and its exclusions, so the evaluated set is provable after the fact.
  universe_snapshot                Json
  screening_algorithm_version      String
  parser_version                   String
  normalization_version            String
  shortlist_target_size            Int
  max_shortlist_size               Int
  estimated_call_cost              Int
  allow_partial_execution          Boolean         @default(false)
  status                           String          @default("planned")
  resolved_count                   Int             @default(0)
  eligible_count                   Int             @default(0)
  shortlist_size                   Int             @default(0)
  physical_call_count              Int             @default(0)
  /// Last quota accounting for this run: considered, reusable, required, estimated, available.
  quota_snapshot                   Json?
  completed_at                     DateTime?
  created_at                       DateTime        @default(now())
  updated_at                       DateTime        @updatedAt

  evidence_plans CountryEvidencePlan[]

  product_classification ProductClassification    @relation(fields: [product_classification_id], references: [id], onDelete: Restrict)
  results                CountryScreeningResult[]

  @@index([product_classification_id, created_at])
  @@index([status, created_at])
}

/// One screened country. Missing, suppressed, unavailable and incompatible are distinct states
/// and are never rewritten as an observed zero; `import_value` is only ever a real observation.
model CountryScreeningResult {
  id                    String    @id @default(cuid())
  run_id                String
  result_key            String    @unique
  reporter_code         String
  country_code          String    @db.VarChar(2)
  iso_numeric           String
  country_name          String
  /// Canonical Comtrade request identity. Shared with the deep plan's latest World import item.
  request_fingerprint   String
  screening_status      String    @default("pending_acquisition")
  screening_score       Decimal?  @db.Decimal(9, 6)
  screening_rank        Int?
  import_value          Decimal?  @db.Decimal(20, 3)
  /// The observation's own status: observed, observed_zero, suppressed, missing, invalid.
  import_value_status   String?
  /// The year the usable observation actually came from. Differs per market under Phase 1G.
  observation_period    Int?
  /// The year this run preferred, so lag is readable without joining the run.
  preferred_period      Int?
  /// Years between the preferred and selected period. 0 = current.
  period_lag            Int?
  /// Evidence weight for that lag. Never applied to `import_value`.
  evidence_confidence   Decimal?  @db.Decimal(6, 4)
  /// Raw demand score discounted by evidence confidence. What ranking and shortlist use.
  selection_score       Decimal?  @db.Decimal(9, 6)
  /// The year acquisition must ask about next, when the period walk is waiting on evidence.
  next_probe_period     Int?
  freshness_state       String    @default("unknown")
  source_evidence_id    String?
  observation_id        String?
  evidence_retrieved_at DateTime?
  shortlisted           Boolean   @default(false)
  decision_reason       String    @default("pending_acquisition")
  provenance            Json?
  attempts              Int       @default(0)
  last_attempted_at     DateTime?
  error                 String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  run             CountryScreeningRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  source_evidence SourceEvidence?     @relation(fields: [source_evidence_id], references: [id], onDelete: Restrict)

  @@unique([run_id, reporter_code])
  @@index([run_id, screening_rank])
  @@index([run_id, screening_status])
  @@index([source_evidence_id])
}

/// Provider facts normalized without collapsing missing, suppressed, invalid, and observed-zero.
model NormalizedTradeObservation {
  id                        String             @id @default(cuid())
  source_evidence_id        String
  trade_flow_acquisition_id String?            @unique
  observation_key           String             @unique
  reporter_code             String
  reporter_iso2             String?            @db.VarChar(2)
  partner_code              String
  partner_iso2              String?            @db.VarChar(2)
  partner_is_world          Boolean            @default(false)
  partner2_code             String?
  flow_direction            TradeFlowDirection
  frequency                 String
  period                    String
  ref_year                  Int
  hs_code                   String
  hs_level                  Int
  hs_revision               String
  customs_code              String?
  mode_of_supply            String?
  trade_value               Decimal?           @db.Decimal(20, 3)
  trade_value_status        String
  quantity                  Decimal?           @db.Decimal(18, 3)
  quantity_status           String
  quantity_unit             String?
  alternate_quantity        Decimal?           @db.Decimal(18, 3)
  alternate_quantity_unit   String?
  net_weight                Decimal?           @db.Decimal(18, 3)
  gross_weight              Decimal?           @db.Decimal(18, 3)
  estimate_flag             Boolean?
  suppression_flag          Boolean?
  confidentiality_flag      Boolean?
  normalization_version     String
  retrieved_at              DateTime
  source_origin             EvidenceOrigin
  incompatibility_reason    String?
  created_at                DateTime           @default(now())

  source_evidence        SourceEvidence        @relation(fields: [source_evidence_id], references: [id], onDelete: Restrict)
  trade_flow_acquisition TradeFlowAcquisition? @relation(fields: [trade_flow_acquisition_id], references: [id], onDelete: Restrict)

  @@index([reporter_code, partner_code, hs_code, ref_year, flow_direction])
  @@index([source_evidence_id])
}

/// Immutable cached classification reference used to prove the HS edition behind a request.
model HsReferenceSnapshot {
  id                String   @id @default(cuid())
  provider          String
  nomenclature      String
  revision          String
  source_url        String
  response_checksum String
  raw_response_text String
  retrieved_at      DateTime
  dataset_version   String?
  parser_version    String
  created_at        DateTime @default(now())

  @@unique([provider, revision, response_checksum])
  @@index([provider, revision, retrieved_at])
}

/// Shared provider quota ledger. A conditional database update reserves each request, so the
/// limit remains coherent across jobs, workers, and process restarts.
model ProviderQuotaWindow {
  id                          String    @id @default(cuid())
  provider                    String
  credential_fingerprint      String
  window_start                DateTime
  window_end                  DateTime
  configured_limit            Int
  requests_reserved           Int       @default(0)
  provider_reported_limit     Int?
  provider_reported_remaining Int?
  provider_reported_reset_at  DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  @@unique([provider, credential_fingerprint, window_start])
  @@index([window_end])
}

/// Server-side-only US inward vessel manifest row. This is a partial observation of ocean
/// cargo, not a complete buyer directory; confidential parties are absent at source.
model ImportRecord {
  id                    String          @id @default(cuid())
  buyer_ref             String?
  buyer_ref_key_version String?
  /// Legacy-only compatibility column. New ingest writes restricted identity to
  /// RawImportIdentity and leaves this null.
  raw_consignee_string  String?
  hs_code               String?
  country               String          @db.VarChar(2)
  shipment_date         DateTime
  value                 Decimal?        @db.Decimal(20, 3)
  value_currency        String?         @db.VarChar(3)
  quantity              Decimal?        @db.Decimal(20, 3)
  /// Manifest package count is meaningful only with CBP's accompanying unit code.
  quantity_unit         String?
  origin_country        String?         @db.VarChar(2)
  port                  String?
  shipper_name          String?
  source                TradeDataSource
  source_record_id      String          @unique
  retrieved_at          DateTime
  evidence_origin       EvidenceOrigin  @default(unknown_legacy)
  ingest_run_id         String?

  source_provider    String
  license_type       String
  allowed_to_display Boolean
  allowed_to_export  Boolean
  allowed_to_cache   Boolean
  retention_limit    DateTime?
  personal_data_flag Boolean
  rights_grant_id    String?

  buyer_id              String?
  resolution_confidence Decimal?  @db.Decimal(6, 5)
  resolution_method     String?
  resolved_at           DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  buyer        Buyer?             @relation(fields: [buyer_id], references: [id], onDelete: SetNull)
  ingest_run   IngestRun?         @relation(fields: [ingest_run_id], references: [id], onDelete: Restrict)
  rights_grant SourceRightsGrant? @relation(fields: [rights_grant_id], references: [id], onDelete: Restrict)
  raw_identity RawImportIdentity?

  @@index([hs_code, country, shipment_date])
  @@index([buyer_ref, shipment_date])
  @@index([buyer_id, shipment_date])
  @@index([retention_limit])
  @@index([evidence_origin, shipment_date])
  @@index([ingest_run_id])
  @@index([rights_grant_id])
}

/// Normalized evidence for the operator-supplied rights assertion. `verification_method`
/// is honest about whether this is merely asserted or linked to reviewed evidence.
model SourceRightsGrant {
  id                    String             @id @default(cuid())
  provider              String
  delivery_batch_id     String
  license_type          String
  contract_license_ref  String?
  effective_at          DateTime?
  expires_at            DateTime?
  allowed_to_display    Boolean
  allowed_to_export     Boolean
  allowed_to_cache      Boolean
  raw_retention_policy  RawRetentionPolicy
  derived_data_policy   DerivedDataPolicy  @default(unspecified)
  evidence_document_ref String?
  evidence_checksum     String
