APP_ENV=staging
DATABASE_ENVIRONMENT=staging
DATABASE_URL=postgresql://cleartrade:REPLACE@postgres:5432/cleartrade_staging?connection_limit=10&pool_timeout=10&sslmode=require
DIRECT_DATABASE_URL=postgresql://cleartrade:REPLACE@postgres:5432/cleartrade_staging?sslmode=require
# SHA-256 of the exact resolved DATABASE_URL. Recompute deliberately after credential rotation.
DATABASE_IDENTITY_SHA256=REPLACE
AUTH_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
NEXT_PUBLIC_APP_URL=https://staging.example.invalid
GUEST_IP_HASH_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
GUEST_TRUST_XFF=false
COMTRADE_CLIENT=real
COMTRADE_API_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
IMPORT_BUYER_REF_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
DISCOVERY_ENGINE=warehouse
RATIONALE_WRITER=template
STORAGE_BACKEND=s3
STORAGE_BUCKET=REPLACE
STORAGE_REGION=REPLACE
# SHA-256 of JSON.stringify([STORAGE_ENDPOINT, STORAGE_BUCKET, AWS_ACCESS_KEY_ID]).
STORAGE_IDENTITY_SHA256=REPLACE
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
DOCUMENT_MALWARE_SCANNER=http
DOCUMENT_MALWARE_SCANNER_URL=REPLACE
OPERATIONS_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
REQUIRE_WORKER_READY=true
NOTIFICATION_PROVIDER=http
NOTIFICATION_PROVIDER_API_KEY=REPLACE
NOTIFICATION_PROVIDER_URL=REPLACE
ERROR_REPORTING_PROVIDER=log
