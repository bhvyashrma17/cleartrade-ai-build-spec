# Copy to .env.local and adjust for your machine:  cp .env.example .env.local
#
# .env.local is gitignored and is the ONLY file that should hold real local values. Railway
# Variables — not this file — are authoritative for staging. Never paste a staging database
# URL, bucket or provider key in here; see docs/28-environment-configuration.md for what
# belongs where and how to add a new provider.
#
# Values below are placeholders and safe defaults only. Verify with: npm run env:check

# Evidence isolation. Use development locally, test in CI, demo only for an explicitly
# labelled fixture environment, and staging/production for real workflows.
APP_ENV="development"
# EVIDENCE_DEMO_MODE="true"
# Never set this persistently. It exists only for an explicitly approved emergency seed:
# DANGEROUS_ALLOW_PRODUCTION_FIXTURES="I_UNDERSTAND_THIS_MUTATES_PRODUCTION"

# PostgreSQL 16+
DATABASE_URL="postgresql://localhost:5432/cleartrade_dev"
# Must exactly match APP_ENV in staging/production. This prevents accidental cross-environment wiring.
DATABASE_ENVIRONMENT="development"
# Use the provider's pooled application URL above; migrations should use a direct connection.
DIRECT_DATABASE_URL="postgresql://localhost:5432/cleartrade_dev"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=on
# Optional social providers (docs/29-social-authentication.md). A provider appears on the
# login page only when BOTH its ID and SECRET are set; half-configured is a startup error in
# staging/production. Leaving these empty is the normal local default — the buttons render in
# a disabled state rather than redirecting into a guaranteed OAuth failure.
# Google: create one OAuth client per environment. Local redirect URI must be exactly
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Apple: AUTH_APPLE_ID is the Services ID. AUTH_APPLE_SECRET is an ES256 JWT that YOU sign and
# that Apple expires within ~6 months — generate with `npm run secrets:apple` and diarise the
# rotation. Apple rejects http/localhost return URLs, so this normally stays unset locally.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
# Generation-time only — read by `npm run secrets:apple`, never at runtime. The .p8 signing key
# must live outside the repo (.gitignore excludes *.p8); it can mint credentials until revoked.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_AUTH_KEY_FILE=""

# Base URL used for deep links in notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Keyed HMAC for guest IP hashing. Generate with: openssl rand -hex 32
GUEST_IP_HASH_SECRET=""

# Only enable behind a proxy that OVERWRITES X-Forwarded-For.
GUEST_TRUST_XFF="false"

# Required explicitly in staging/production; those environments reject mock and preview.
# Keep this `mock` locally: `real` spends the shared UN Comtrade quota from your machine and
# needs COMTRADE_API_KEY. Switch deliberately, per-command, when testing the live client.
COMTRADE_CLIENT="mock"
COMTRADE_API_KEY=""
# Override the provider base URL. Leave unset to use the authenticated production endpoint.
COMTRADE_BASE_URL=""

# Required when ingesting consignee strings from CBP manifests.
IMPORT_BUYER_REF_SECRET=""
# Version travels with pseudonyms; keep old versions during rotation so existing refs remain matchable.
IMPORT_BUYER_REF_KEY_VERSION="v1"
IMPORT_BUYER_REF_PREVIOUS_SECRETS="{}"
# 32 random bytes, base64 encoded. Old keys remain decrypt-only during a controlled re-key.
IMPORT_RAW_IDENTITY_ENCRYPTION_KEY=""
IMPORT_RAW_IDENTITY_KEY_VERSION="v1"
IMPORT_RAW_IDENTITY_PREVIOUS_KEYS="{}"

# Upload storage. Local is development-only. Staging/production must use an S3-compatible
# object service; credentials should normally arrive through workload identity.
STORAGE_BACKEND="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_SERVER_SIDE_ENCRYPTION="AES256"
# Optional; used only to probe that the bucket is not publicly readable.
STORAGE_PUBLIC_BASE_URL=""
# Bucket credentials are read by the AWS SDK's own credential chain, not by app code, so
# they never appear in a process.env lookup. Leave unset locally (STORAGE_BACKEND=local needs
# no credentials); in staging/production prefer workload identity over static keys.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# Upload ceiling enforced before the file is buffered. Defaults to 25 MiB.
UPLOAD_MAX_BYTES=""

# Development uses a deterministic test scanner — no ClamAV needed locally.
# Staging/production require `http` plus an https URL.
DOCUMENT_MALWARE_SCANNER="development"
DOCUMENT_MALWARE_SCANNER_URL=""
# Bearer credential for the scanner. Must equal SCANNER_AUTH_TOKEN on the scanner service.
DOCUMENT_MALWARE_SCANNER_TOKEN=""
DOCUMENT_MALWARE_SCANNER_TIMEOUT_MS="30000"
DOCUMENT_MALWARE_SCANNER_MAX_BYTES=""

# Health, worker supervision and protected operational metrics.
# Bearer token for /api/metrics. Leaving it empty locally is fine: with APP_ENV=development
# the operational endpoints open without a token. Required in staging/production.
OPERATIONS_TOKEN=""
REQUIRE_WORKER_READY="false"
WORKER_HEARTBEAT_INTERVAL_MS="15000"
WORKER_READY_MAX_AGE_MS="60000"
WORKER_MAX_CONSECUTIVE_FAILURES="5"
# Set by the platform per instance; leave unset locally.
WORKER_INSTANCE_ID=""
# pg_dump target directory for npm run db:backup.
BACKUP_DIRECTORY=""
# Restore-drill target. The URL must contain `restore_drill` or the script refuses to run.
RESTORE_DRILL_DATABASE_URL=""

# Optional integrations are fail-closed when explicitly enabled.
DISCOVERY_ENGINE="warehouse"
# Simulated latency for DISCOVERY_ENGINE=mock only.
DISCOVERY_MOCK_LATENCY_MS="2400"
RATIONALE_WRITER="template"
ANTHROPIC_API_KEY=""
# Document renderer. "mock" (default) produces plain text and is the safe local/CI setting.
# "legacy" is the real pdf-lib/docx renderer adapted from the Export project — PDF, DOCX and
# HTML. Selection is explicit: an unrecognised value fails at startup rather than silently
# falling back, so a typo cannot leave an environment producing .txt "documents".
# Not enabled on any deployed environment as of Phase 6.
DOCUMENT_ENGINE="mock"

# Email. `sandbox` is in-process and sends nothing — the right local default.
# Staging/production must be `http` or `resend`.
NOTIFICATION_PROVIDER="sandbox"
NOTIFICATION_PROVIDER_API_KEY=""
NOTIFICATION_PROVIDER_URL=""
# Used when NOTIFICATION_PROVIDER=resend.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""
# Outside production one of these is REQUIRED, so a non-production environment can never
# email real users: restrict to an allowlist, or funnel everything to one inbox.
NOTIFICATION_ALLOWED_RECIPIENTS=""
NOTIFICATION_REDIRECT_TO=""

ERROR_REPORTING_PROVIDER="log"

# Sanctions source operations (docs/25-sanctions-source-operations.md).
# Cadence — how often we ASK the provider. Operational, per-dataset override supported
# (e.g. SANCTIONS_REFRESH_HOURS_OFAC_SDN). This is NOT the compliance freshness control.
SANCTIONS_REFRESH_HOURS="12"
# Lease TTL for cross-process refresh exclusion. Must outlive a slow refresh; a crashed
# worker's lease expires rather than locking the dataset forever.
SANCTIONS_LEASE_TTL_MINUTES="30"
# Durable raw artifact retention. Unset defaults to required in staging/production. When
# required, a failed persist or failed post-write verification REFUSES activation.
SANCTIONS_REQUIRE_ARTIFACT_RETENTION=""
# Freshness threshold — how stale screening data may be before failing closed. This is a
# POLICY control and remains pending compliance approval; it is not a refresh cadence.
SANCTIONS_MAX_AGE_DAYS="2"
