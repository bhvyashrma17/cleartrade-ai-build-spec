# Copy to .env and adjust for your machine.

# PostgreSQL 16+
DATABASE_URL="postgresql://USER@localhost:5432/cleartrade_ai?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
AUTH_TRUST_HOST=true

# Base URL used for deep links in notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
