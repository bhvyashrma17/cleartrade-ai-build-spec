# Copy to .env and adjust for your machine.

# Evidence isolation. Use development locally, test in CI, demo only for an explicitly
# labelled fixture environment, and staging/production for real workflows.
APP_ENV="development"
# EVIDENCE_DEMO_MODE="true"
# Never set this persistently. It exists only for an explicitly approved emergency seed:
# DANGEROUS_ALLOW_PRODUCTION_FIXTURES="I_UNDERSTAND_THIS_MUTATES_PRODUCTION"

# PostgreSQL 16+
DATABASE_URL="postgresql://localhost:5432/cleartrade_dev"
# Must exactly match APP_ENV in staging/production. This prevents accidental cross-environment wiring.
DATABASE_ENVIRONMENT="development"
# Use the provider's pooled application URL above; migrations should use a direct connection.
DIRECT_DATABASE_URL="postgresql://localhost:5432/cleartrade_dev"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=on

# Base URL used for deep links in notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Keyed HMAC for guest IP hashing. Generate with: openssl rand -hex 32
GUEST_IP_HASH_SECRET=""

# Only enable behind a proxy that OVERWRITES X-Forwarded-For.
GUEST_TRUST_XFF="false"

# Required explicitly in staging/production; those environments reject mock and preview.
COMTRADE_CLIENT="mock"
COMTRADE_API_KEY=""

# Required when ingesting consignee strings from CBP manifests.
IMPORT_BUYER_REF_SECRET=""
# Version travels with pseudonyms; keep old versions during rotation so existing refs remain matchable.
IMPORT_BUYER_REF_KEY_VERSION="v1"
IMPORT_BUYER_REF_PREVIOUS_SECRETS="{}"
# 32 random bytes, base64 encoded. Old keys remain decrypt-only during a controlled re-key.
IMPORT_RAW_IDENTITY_ENCRYPTION_KEY=""
IMPORT_RAW_IDENTITY_KEY_VERSION="v1"
IMPORT_RAW_IDENTITY_PREVIOUS_KEYS="{}"

# Upload storage. Local is development-only. Staging/production must use an S3-compatible
# object service; credentials should normally arrive through workload identity.
STORAGE_BACKEND="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_SERVER_SIDE_ENCRYPTION="AES256"
# Development uses a deterministic test scanner. Staging/production require `http`.
DOCUMENT_MALWARE_SCANNER="development"
DOCUMENT_MALWARE_SCANNER_URL=""

# Health, worker supervision and protected operational metrics.
OPERATIONS_TOKEN=""
REQUIRE_WORKER_READY="false"
WORKER_HEARTBEAT_INTERVAL_MS="15000"
WORKER_READY_MAX_AGE_MS="60000"
WORKER_MAX_CONSECUTIVE_FAILURES="5"

# Optional integrations are fail-closed when explicitly enabled.
DISCOVERY_ENGINE="warehouse"
RATIONALE_WRITER="template"
ANTHROPIC_API_KEY=""
NOTIFICATION_PROVIDER="sandbox"
NOTIFICATION_PROVIDER_API_KEY=""
NOTIFICATION_PROVIDER_URL=""
ERROR_REPORTING_PROVIDER="log"

# Sanctions source operations (docs/25-sanctions-source-operations.md).
# Cadence — how often we ASK the provider. Operational, per-dataset override supported
# (e.g. SANCTIONS_REFRESH_HOURS_OFAC_SDN). This is NOT the compliance freshness control.
SANCTIONS_REFRESH_HOURS="12"
# Lease TTL for cross-process refresh exclusion. Must outlive a slow refresh; a crashed
# worker's lease expires rather than locking the dataset forever.
SANCTIONS_LEASE_TTL_MINUTES="30"
# Durable raw artifact retention. Unset defaults to required in staging/production. When
# required, a failed persist or failed post-write verification REFUSES activation.
SANCTIONS_REQUIRE_ARTIFACT_RETENTION=""
# Freshness threshold — how stale screening data may be before failing closed. This is a
# POLICY control and remains pending compliance approval; it is not a refresh cadence.
SANCTIONS_MAX_AGE_DAYS="2"
