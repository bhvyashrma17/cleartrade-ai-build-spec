  "purpose": "Agreement factor for the labelled duty estimate in Demand Discovery v5 (docs/36 §4.7). One row per agreement and partner. A partner with several agreements takes the strongest in force on the run date.",
  "excluded": [
    {
      "agreement": "Global System of Trade Preferences (GSTP)",
      "reason": "Margins of preference are small and cover few lines; counting it as partial would overstate preference for about 40 markets."
    },
    {
      "agreement": "SAARC Preferential Trading Arrangement (SAPTA)",
      "reason": "Superseded by SAFTA."
    },
    {
      "agreement": "India–Thailand Early Harvest Scheme",
      "reason": "Its lines are covered by the ASEAN–India agreement, which is listed."
    },
    {
      "agreement": "India–Nepal Treaty of Trade",
      "reason": "Its reciprocal concessions are limited; Nepal is covered by SAFTA (partial)."
    },
    {
      "agreement": "India–EU FTA",
      "reason": "Concluded January 2026; not in force on the compilation date."
    },
    {
      "agreement": "Asia Pacific Trade Agreement (APTA), Mongolia",
      "reason": "Mongolia acceded after the agreement entered into force; the date its concessions took effect is not yet verified, so it is left out rather than guessed."
    }
  ],
